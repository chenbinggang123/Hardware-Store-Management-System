<view class="screen ledger-screen">
  <!-- 账本类型用下拉选择：买的 / 进货的 -->
  <view class="ledger-head"><view class="ledger-title">工厂账本</view><picker range="{{kindNames}}" value="{{kind === 'SUPPLIER' ? 1 : 0}}" bindchange="pickKind"><view class="pick kind-pick">{{kind === 'SUPPLIER' ? '进货的' : '买的'}}</view></picker><view class="btn btn-primary btn-sm head-new" role="button" bindtap="openCreate">＋ 新建</view></view>
  <!-- 合计一行说清：几家、总共多少；右边是这一类最常用的下一步 -->
  <view class="total-strip" aria-label="当前全部账本金额"><view class="total-copy"><text class="total-label">{{totals.factoryCount}} 家 · {{copy.totalLabel}}</text><text class="total-value">¥{{totals.totalDueAmount || '0.00'}}</text></view><view class="total-link" wx:if="{{kind === 'CUSTOMER'}}" role="button" bindtap="openMonthlySummary">月度汇总 ›</view><view class="total-link primary" wx:else role="button" bindtap="openProcurement">记进货 ›</view></view>
  <view class="search-box ledger-search"><text class="search-icon">查</text><input class="search-input" value="{{keyword}}" placeholder="{{copy.search}}" bindinput="onKeywordInput" bindconfirm="loadData" confirm-type="search" /><view class="search-go" role="button" bindtap="loadData">搜索</view></view>
  <view class="loading-state" wx:if="{{loading}}">正在读取账本…</view>
  <view class="error-state" wx:elif="{{error}}"><view>{{error}}</view><view class="state-action" role="button" bindtap="loadData">重新加载</view></view>
  <view class="book-list" wx:elif="{{ledgers.length}}"><view class="book-row" wx:for="{{ledgers}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail" role="button" aria-label="打开{{item.factoryName}}账本"><view class="book-spine {{item.totalDueCents > 0 ? 'owing' : ''}}">{{kind === 'SUPPLIER' ? '进' : '账'}}</view><view class="book-main"><view class="book-name">{{item.factoryName}}</view><view class="book-contact">{{item.contactPerson || item.phone ? (item.contactPerson || '') + ' ' + (item.phone || '') : '未填联系方式'}}</view></view><view class="book-money"><text>{{copy.dueLabel}}</text><text class="book-amount {{item.totalDueCents > 0 ? 'danger-text' : ''}}">¥{{item.totalDueAmount || '0.00'}}</text><text class="book-status" wx:if="{{item.creditCents > 0}}">{{copy.creditLabel}} ¥{{item.creditAmount}}</text></view></view></view>
  <view class="empty-state" wx:else><view class="empty-title">{{keyword ? '没有找到这家' : copy.empty}}</view><view class="state-action" role="button" bindtap="emptyAction">{{kind === 'SUPPLIER' ? '开一张采购单' : '新建账本'}}</view></view>
</view>
