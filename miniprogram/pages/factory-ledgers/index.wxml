<view class="screen ledger-screen">
  <view class="ledger-head"><view><view class="ledger-title">工厂账本</view><view class="ledger-subtitle">看每家工厂还需付多少，点开翻单据</view></view><view class="btn btn-primary btn-sm" role="button" bindtap="openCreate">＋ 新建</view></view>
  <view class="ledger-summary" aria-label="当前全部账本金额"><view class="summary-cell"><text>工厂</text><text class="summary-value">{{totals.factoryCount}}</text><text class="summary-unit">家</text></view><view class="summary-cell danger"><text>总共还需付</text><text class="summary-value">¥{{totals.totalDueAmount || '0.00'}}</text></view></view>
  <view class="ledger-monthly" role="button" aria-label="打开月度汇总" bindtap="openMonthlySummary"><view><view class="monthly-title">月度汇总</view><view class="monthly-note">按月份查看拿货、退货和收款</view></view><text>查看 ›</text></view>
  <view class="filter-ledger"><view class="search-box"><text class="search-icon">查</text><input class="search-input" value="{{keyword}}" placeholder="工厂、联系人或电话" bindinput="onKeywordInput" bindconfirm="loadData" confirm-type="search" /></view><view class="filter-actions"><view class="btn btn-outline btn-sm" role="button" bindtap="loadData">查询</view></view></view>
  <view class="loading-state" wx:if="{{loading}}">正在读取账本…</view>
  <view class="error-state" wx:elif="{{error}}"><view>{{error}}</view><view class="state-action" role="button" bindtap="loadData">重新加载</view></view>
  <view class="book-list" wx:elif="{{ledgers.length}}"><view class="book-row" wx:for="{{ledgers}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail" role="button" aria-label="打开{{item.factoryName}}账本"><view class="book-spine {{item.totalDueCents > 0 ? 'owing' : ''}}">账</view><view class="book-main"><view class="book-name">{{item.factoryName}}</view><view class="book-contact">{{item.contactPerson || '未填联系人'}} · {{item.phone || '未填电话'}}</view></view><view class="book-money"><text>还需付</text><text class="book-amount {{item.totalDueCents > 0 ? 'danger-text' : ''}}">¥{{item.totalDueAmount || '0.00'}}</text><text class="book-status" wx:if="{{item.creditCents > 0}}">已多付 ¥{{item.creditAmount}}</text></view></view></view>
  <view class="empty-state" wx:else><view class="empty-title">{{keyword ? '没有找到这家工厂' : '还没有工厂账本'}}</view><view class="state-action" role="button" bindtap="openCreate">新建账本</view></view>
</view>
