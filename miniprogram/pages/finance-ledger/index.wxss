.finance-screen{padding-top:20rpx}.head{display:flex;justify-content:space-between;gap:20rpx;padding:10rpx 0 24rpx}.title{margin-top:7rpx;color:#17231E;font-size:42rpx;font-weight:760}.subtitle{max-width:460rpx;margin-top:9rpx;color:#66746E;font-size:23rpx}.head-actions{display:flex;flex-direction:column;gap:10rpx}.small-button,.add-button{min-height:62rpx;padding:0 16rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx;font-size:22rpx;box-sizing:border-box}.small-button{border:1rpx solid #CAD5D0;background:#FFF}.add-button{color:#FFF;background:#245E9B;font-weight:700}.summary{display:grid;grid-template-columns:1fr 1fr;overflow:hidden;border:1rpx solid #D4DDD8;border-radius:18rpx;background:#FFF}.summary>view{padding:24rpx;display:flex;flex-direction:column;gap:6rpx}.summary>view+view{border-left:1rpx solid #E0E6E3}.summary text:first-child{color:#6B7872;font-size:22rpx}.summary text:last-child{font-size:36rpx;font-weight:780}.red{color:#A84635}.amber{color:#8A5717}.summary .summary-foot{grid-column:1/3;display:block;border-top:1rpx solid #E0E6E3;border-left:0;color:#607068;font-size:20rpx}.tabs,.subtabs{display:flex;gap:10rpx;margin-top:20rpx}.tab{min-width:108rpx;min-height:66rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #CDD7D2;border-radius:12rpx;background:#FFF;color:#5F6E67;font-size:23rpx}.tab.active{border-color:#245E9B;background:#245E9B;color:#FFF;font-weight:700}.subtabs{margin-top:10rpx}.subtab{min-height:54rpx;padding:0 18rpx;display:flex;align-items:center;border-bottom:4rpx solid transparent;color:#69766F;font-size:22rpx}.subtab.active{border-color:#245E9B;color:#245E9B;font-weight:700}.list{margin-top:18rpx;border-top:1rpx solid #D6DEDA;border-bottom:1rpx solid #D6DEDA;background:#FFF}.row{min-height:120rpx;padding:22rpx 18rpx;display:flex;align-items:center;gap:15rpx;border-bottom:1rpx solid #E2E7E4}.mark{width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:12rpx;font-weight:760}.mark.RECEIVABLE{color:#A84635;background:#FCE9E4}.mark.PAYABLE{color:#8A5717;background:#F8EEDC}.copy{flex:1;min-width:0}.name{font-size:27rpx;font-weight:720}.meta,.flow{margin-top:6rpx;color:#6D7A73;font-size:20rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.money{display:flex;flex-direction:column;align-items:flex-end;gap:5rpx;color:#727F78;font-size:19rpx}.money text:first-child{color:#A84635;font-size:22rpx;font-weight:700}.error-state{margin-top:28rpx;padding:36rpx;background:#FFF;text-align:center;color:#66746E}
.quick-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-bottom:18rpx}.quick-actions>view{min-height:86rpx;padding:14rpx;display:flex;flex-direction:column;justify-content:center;border:1rpx solid #CED8D3;border-radius:14rpx;background:#FFF;box-sizing:border-box}.quick-actions text:first-child{color:#21332B;font-size:23rpx;font-weight:720}.quick-actions text:last-child{margin-top:5rpx;color:#718078;font-size:18rpx}.summary .overdue-summary{grid-column:1/3;display:flex;flex-direction:row;justify-content:space-between;border-top:1rpx solid #E0E6E3;border-left:0;color:#A84635}.summary .overdue-summary text:last-child{font-size:25rpx}.aging{margin-top:16rpx;padding:18rpx;border:1rpx solid #D4DDD8;border-radius:16rpx;background:#FFF}.aging-title{color:#425249;font-size:22rpx;font-weight:700}.aging-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;margin-top:13rpx}.aging-grid>view{min-width:0;padding:10rpx 6rpx;border-radius:9rpx;background:#F3F6F4;text-align:center}.aging-grid text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#718078;font-size:17rpx}.aging-grid text:nth-child(2){margin-top:5rpx;color:#27372F;font-size:20rpx;font-weight:720}.aging-grid text:nth-child(3){margin-top:3rpx}.money.overdue text:first-child{color:#A84635}
