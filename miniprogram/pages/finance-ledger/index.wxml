<view class="screen finance-screen">
  <view class="head"><view><view class="page-kicker">往来账</view><view class="title">谁欠我，我欠谁</view><view class="subtitle">订单自动入账，收付款优先冲抵最早欠款</view></view><view class="head-actions"><picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view class="small-button">{{month}} ›</view></picker><view class="add-button" role="button" aria-label="新增往来账" bindtap="add">＋ 记一笔</view></view></view>
  <view class="quick-actions"><view role="button" aria-label="登记一笔收付款" bindtap="addPayment"><text>收付款</text><text>自动冲账 ›</text></view><view role="button" aria-label="导出客户或厂商对账单" bindtap="exportStatement"><text>对账单</text><text>生成 Excel ›</text></view><view role="button" aria-label="同步历史订单到账款" bindtap="syncOrders"><text>{{syncing ? '同步中…' : '同步订单'}}</text><text>历史单据补入账 ›</text></view></view>
  <view class="summary"><view><text>待收款</text><text class="red">¥{{summary.receivable}}</text></view><view><text>待付款</text><text class="amber">¥{{summary.payable}}</text></view><view class="overdue-summary"><text>已逾期 {{summary.overdueCount}} 张</text><text>¥{{summary.overdue}}</text></view><view class="summary-foot">本月发生 ¥{{summary.occurred}} · 本月收付 ¥{{summary.settled}} · {{summary.count}} 张未结</view></view>
  <view class="aging" wx:if="{{aging.length}}"><view class="aging-title">未结账龄</view><view class="aging-grid"><view wx:for="{{aging}}" wx:key="code"><text>{{item.label}}</text><text>¥{{item.amountText}}</text><text>{{item.documentCount}} 张</text></view></view></view>
  <view class="tabs"><view class="tab {{!direction ? 'active' : ''}}" data-value="" bindtap="selectDirection">全部</view><view class="tab {{direction === 'RECEIVABLE' ? 'active' : ''}}" data-value="RECEIVABLE" bindtap="selectDirection">应收</view><view class="tab {{direction === 'PAYABLE' ? 'active' : ''}}" data-value="PAYABLE" bindtap="selectDirection">应付</view></view>
  <view class="subtabs"><view class="subtab {{status === 'OPEN' ? 'active' : ''}}" data-value="OPEN" bindtap="selectStatus">未结清</view><view class="subtab {{status === 'OVERDUE' ? 'active' : ''}}" data-value="OVERDUE" bindtap="selectStatus">已逾期</view><view class="subtab {{status === 'SETTLED' ? 'active' : ''}}" data-value="SETTLED" bindtap="selectStatus">已结清</view></view>
  <view class="search-box"><text class="search-icon">查</text><input class="search-input" aria-label="搜索客户厂商或单号" placeholder="搜索客户、厂商、单号" value="{{keyword}}" bindinput="inputKeyword" bindconfirm="search" /></view>
  <view class="loading-state" wx:if="{{loading && !documents.length}}">正在读取往来账…</view><view class="error-state" wx:elif="{{loadError && !documents.length}}">{{loadError}}<view class="state-action" bindtap="retry">重新加载</view></view>
  <view class="list" wx:elif="{{documents.length}}"><view class="row" wx:for="{{documents}}" wx:key="id" role="button" aria-label="查看{{item.counterpartyName}}账款" data-id="{{item.id}}" bindtap="open"><view class="mark {{item.direction}}">{{item.mark}}</view><view class="copy"><view class="name">{{item.counterpartyName}}</view><view class="meta">{{item.directionText}} · {{item.documentDate}} · {{item.numberText}}</view><view class="flow">单据 ¥{{item.totalText}} · {{item.agingText}}</view></view><view class="money {{item.overdue ? 'overdue' : ''}}"><text>{{item.statusText}}</text><text>剩余 ¥{{item.outstandingText}}</text><text>查看 ›</text></view></view></view>
  <view class="empty-state" wx:else><view class="empty-title">还没有{{status === 'SETTLED' ? '已结清' : '未结'}}账款</view><view class="empty-desc">销售和采购单会自动入账，也可以从文件或手动建立。</view><view class="state-action" bindtap="add">手动记一笔</view></view>
</view>
