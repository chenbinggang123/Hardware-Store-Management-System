<view class="login-screen">
  <view class="login-brand">
    <view class="login-brand-icon">恒</view>
    <view class="login-brand-name">恒迪五金</view>
    <view class="login-brand-desc">商品、单据和库存都在这里</view>
  </view>

  <view class="login-card">
    <view class="title-md" style="margin-bottom: 4rpx;">账号登录</view>
    <view class="text-muted">输入账号和密码即可进入</view>

    <view class="login-field">
      <view class="form-label">账号</view>
      <view class="search-box" style="margin-top: 8rpx;">
        <text class="search-icon">账号</text>
        <input class="search-input" placeholder="请输入账号" value="{{username}}" bindinput="onUsernameInput" />
      </view>
    </view>

    <view class="login-field">
      <view class="form-label">密码</view>
      <view class="search-box" style="margin-top: 8rpx;">
        <text class="search-icon">密码</text>
        <input class="search-input" password="{{!showPassword}}" placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
        <view class="password-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</view>
      </view>
    </view>

    <view class="login-error" wx:if="{{loginError}}"><text>登录失败</text><view>{{loginError}}</view></view>

    <button class="login-btn" loading="{{loading}}" bindtap="handleLogin">
      {{loading ? '正在登录...' : '进入恒迪五金'}}
    </button>
  </view>

  <view style="text-align: center; margin-top: 32rpx;">
    <text class="text-muted">首次使用请联系管理员创建账号</text>
  </view>
</view>
