<view class="screen home-screen">
  <view class="home-head">
    <view>
      <view class="home-title">今天想做什么？</view>
      <view class="home-subtitle">{{currentUser.name || '老板'}}，常用的直接点，麻烦的交给小五。</view>
    </view>
    <view class="home-profile" bindtap="openModule" data-path="/pages/settings/index">{{userInitial}}</view>
  </view>

  <view class="home-status-widget">
    <view class="home-status-main"><view class="status-pulse"></view><text>{{dashboardMeta.status}}</text></view>
    <view class="home-status-time">更新于 {{dashboardMeta.updatedAt}}</view>
    <view class="home-status-tip">下拉刷新</view>
  </view>

  <view class="home-section-head">
    <view class="home-section-title">常用操作</view>
    <view class="home-section-note">大按钮，直接进入</view>
  </view>
  <view class="home-actions">
    <block wx:for="{{directActions}}" wx:key="title">
      <view class="home-action {{item.tone}}" bindtap="openModule" data-path="{{item.path}}">
        <view class="home-action-mark">{{item.mark}}</view>
        <view>
          <view class="home-action-title">{{item.title}}</view>
          <view class="home-action-desc">{{item.desc}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="home-section-head overview-head">
    <view class="home-section-title">一眼看看</view>
    <view class="home-section-note">点一行看明细</view>
  </view>
  <view class="home-overview">
    <view class="home-result" bindtap="openModule" data-path="/pages/sales-orders/index">
      <view class="home-result-mark">销</view>
      <view class="home-result-copy"><view class="home-result-title">今天卖了多少</view><view class="home-result-desc">查看今天的销售情况</view></view>
      <view class="home-result-value">¥{{report.sales || 0}}</view><view class="home-result-arrow">›</view>
    </view>
    <view class="home-result warning" bindtap="openModule" data-path="/pages/inventories/index">
      <view class="home-result-mark">货</view>
      <view class="home-result-copy"><view class="home-result-title">快没货的商品</view><view class="home-result-desc">建议今天看一下</view></view>
      <view class="home-result-value">{{stats.warningCount}} 件</view><view class="home-result-arrow">›</view>
    </view>
    <view class="home-result" bindtap="openModule" data-path="/pages/products/index">
      <view class="home-result-mark">品</view>
      <view class="home-result-copy"><view class="home-result-title">店里有多少商品</view><view class="home-result-desc">直接查看商品列表</view></view>
      <view class="home-result-value">{{stats.productCount}} 件</view><view class="home-result-arrow">›</view>
    </view>
  </view>

  <view class="home-agent" bindtap="openModule" data-path="/pages/agent/index">
    <view class="home-agent-head">
      <view class="home-agent-mark">小</view>
      <view>
        <view class="home-agent-title">复杂的事，交给小五</view>
        <view class="home-agent-desc">复杂开单、模糊查找、经营分析，用一句话说明就行。</view>
      </view>
    </view>
    <view class="home-agent-input"><view>按住说话，或点这里打字</view><view class="home-agent-mic">说</view></view>
    <view class="home-agent-trust">查询直接完成；改库存、改账目、正式开单都要你确认</view>
  </view>

  <view class="section more-section">
    <view class="section-head"><view class="home-section-title">更多功能</view><view class="section-link" bindtap="openModule" data-path="/pages/analysis/index">经营分析</view></view>
    <view class="more-grid">
      <block wx:for="{{moreFunctions}}" wx:key="title">
        <view class="more-item" bindtap="openModule" data-path="{{item.path}}"><view class="more-mark">{{item.mark}}</view><view>{{item.title}}</view></view>
      </block>
    </view>
  </view>

  <view class="section recent-section" wx:if="{{recentLogs.length}}">
    <view class="section-head"><view class="home-section-title">最近操作</view><view class="section-link" bindtap="openModule" data-path="/pages/system-logs/index">查看全部</view></view>
    <view class="home-recent">
      <block wx:for="{{recentLogs}}" wx:key="id">
        <view class="home-recent-row"><view><view class="home-recent-title">{{item.module}} · {{item.action}}</view><view class="home-recent-desc">{{item.detail}}</view></view><view class="home-recent-time">{{item.createTime}}</view></view>
      </block>
    </view>
  </view>
</view>
