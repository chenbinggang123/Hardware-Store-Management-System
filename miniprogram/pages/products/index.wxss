.catalog-screen { padding-top: 20rpx; }
.catalog-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 10rpx 0 24rpx; }
.catalog-title { margin-top: 8rpx; color: #17231E; font-size: 44rpx; line-height: 1.2; font-weight: 760; }
.catalog-subtitle { margin-top: 8rpx; color: #66746E; font-size: 23rpx; line-height: 1.5; }
.catalog-tools { padding: 22rpx 0 16rpx; border-top: 1rpx solid #D6DEDA; }
.search-box { min-height: 82rpx; display: flex; align-items: center; gap: 14rpx; padding: 0 20rpx; border: 1rpx solid #CBD5D0; border-radius: 14rpx; background: #FFF; box-sizing: border-box; }
.search-icon { color: #245E9B; font-size: 22rpx; font-weight: 750; }
.search-input { flex: 1; min-width: 0; height: 80rpx; color: #17231E; font-size: 25rpx; }
.search-clear { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: #65736C; font-size: 34rpx; }
.catalog-tabs { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.catalog-tab { min-height: 68rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; border: 1rpx solid #CBD5D0; border-radius: 12rpx; color: #5F6E67; background: #FFF; font-size: 23rpx; font-weight: 650; }
.catalog-tab.active { color: #FFF; border-color: #245E9B; background: #245E9B; }
.catalog-tab text { min-width: 28rpx; height: 28rpx; display: inline-flex; align-items: center; justify-content: center; padding: 0 6rpx; border-radius: 14rpx; color: #A33E32; background: #FCE9E4; font-size: 17rpx; box-sizing: border-box; }
.catalog-context { padding: 4rpx 2rpx 16rpx; display: flex; justify-content: space-between; gap: 16rpx; color: #78847E; font-size: 20rpx; }
.catalog-list { overflow: hidden; border-top: 1rpx solid #D6DEDA; background: #FFF; }
.catalog-row { position: relative; padding: 22rpx 18rpx; border-bottom: 1rpx solid #E1E6E3; }
.catalog-row.needs-attention::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6rpx; background: #C27B24; }
.catalog-summary { min-height: 100rpx; display: flex; align-items: flex-start; gap: 16rpx; }
.product-thumb { width: 86rpx; height: 86rpx; flex: 0 0 auto; border-radius: 14rpx; background: #E8EFEB; }
.product-thumb.placeholder { display: flex; align-items: center; justify-content: center; color: #245E9B; background: #E7F0F8; font-size: 30rpx; font-weight: 760; }
.catalog-copy { flex: 1; min-width: 0; }
.catalog-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #17231E; font-size: 28rpx; font-weight: 730; }
.catalog-spec { margin-top: 3rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #728078; font-size: 21rpx; }
.catalog-price { margin-top: 8rpx; color: #17231E; font-size: 27rpx; font-weight: 740; }
.catalog-price text { color: #247052; font-size: 22rpx; font-weight: 700; }
.catalog-activity { margin-top: 5rpx; color: #718078; font-size: 20rpx; line-height: 1.4; }
.catalog-alert { margin-top: 6rpx; color: #A14A26; font-size: 20rpx; line-height: 1.4; }
.catalog-arrow { width: 30rpx; align-self: center; color: #245E9B; font-size: 32rpx; text-align: right; }
.catalog-actions { margin-top: 18rpx; margin-left: 102rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.catalog-action { min-height: 64rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #CBD5D0; border-radius: 10rpx; color: #405149; background: #FFF; font-size: 22rpx; font-weight: 680; }
.catalog-action.primary { color: #FFF; border-color: #247052; background: #247052; }
.catalog-loading-more, .catalog-end { padding: 24rpx; color: #7A8680; font-size: 21rpx; text-align: center; }
.catalog-scope { display:flex; gap:16rpx; border-bottom:1rpx solid #D6DEDA; }
.catalog-scope > view { flex:1; min-height:88rpx; display:flex; align-items:center; justify-content:center; font-size:28rpx; color:#53665A; }
.catalog-scope > .active { color:#245E9B; font-weight:700; border-bottom:3rpx solid #245E9B; }
.factory-actions { display:flex; gap:28rpx; min-height:88rpx; align-items:center; color:#245E9B; font-size:28rpx; }
.factory-actions > view { min-height:88rpx; display:flex; align-items:center; }
.factory-row { padding:24rpx; margin:16rpx 0; background:#FFF; border:1rpx solid #D6DEDA; border-radius:14rpx; }
.catalog-head > .btn { flex: 0 0 auto; min-width: 96rpx; white-space: nowrap; }

/* 按源头厂商筛选：默认“全部厂商”，横向滑动选一家 */
.factory-chips { margin-top: 18rpx; white-space: nowrap; display: flex; }
.factory-chip { display: inline-flex; align-items: center; flex-shrink: 0; min-height: 68rpx; margin-right: 14rpx; padding: 0 24rpx; border: 1rpx solid #CED8D3; border-radius: 34rpx; background: #FFF; color: #33443C; font-size: 26rpx; }
.factory-chip text { margin-left: 8rpx; color: #7A8882; font-size: 22rpx; }
.factory-chip.active { border-color: #245E9B; background: #E8F1F8; color: #245E9B; font-weight: 700; }
.factory-chip.active text { color: #245E9B; }
/* ===== 2026-10 紧凑版：筛选用下拉，一行一个商品 ===== */
.catalog-screen { padding-top: 14rpx; }
.catalog-head { align-items: center; padding: 0; }
.catalog-title { margin-top: 0; font-size: 34rpx; }
.catalog-count { margin-left: 12rpx; color: #66746E; font-size: 22rpx; font-weight: 500; }
.catalog-tools { padding: 10rpx 0; border-top: 0; }
.pick.on { border-color: #245E9B; color: #245E9B; background: #E8F1F8; font-weight: 700; }
.pick-badge { min-width: 26rpx; height: 26rpx; padding: 0 6rpx; display: inline-flex; align-items: center; justify-content: center; border-radius: 13rpx; color: #A33E32; background: #FCE9E4; font-size: 18rpx; box-sizing: border-box; }
.factory-links { display: flex; gap: 18rpx; color: #245E9B; font-size: 23rpx; font-weight: 700; }
.catalog-list { border-radius: 10rpx; border: 1rpx solid #D6DEDA; }
.catalog-row { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 14rpx; }
.catalog-summary { flex: 1; min-width: 0; min-height: 0; align-items: center; gap: 12rpx; }
.product-thumb { width: 60rpx; height: 60rpx; border-radius: 10rpx; }
.product-thumb.placeholder { font-size: 24rpx; }
.catalog-name { font-size: 26rpx; }
.catalog-spec { margin-top: 2rpx; font-size: 21rpx; }
.catalog-price { margin-top: 2rpx; font-size: 22rpx; font-weight: 700; }
.catalog-price text { margin-left: 8rpx; font-size: 22rpx; }
.catalog-alert { margin-top: 2rpx; font-size: 20rpx; }
.catalog-side { flex: 0 0 auto; width: 128rpx; display: flex; flex-direction: column; align-items: stretch; gap: 4rpx; }
.catalog-stock { color: #17231E; font-size: 24rpx; font-weight: 800; text-align: center; white-space: nowrap; }
.catalog-stock.warn { color: #A83F32; }
.catalog-side .catalog-action { min-height: 46rpx; border-radius: 8rpx; color: #245E9B; border-color: #B9D0E2; background: #E8F1F8; font-size: 22rpx; }
.catalog-more { min-height: 36rpx; display: flex; align-items: center; justify-content: center; color: #66746E; font-size: 21rpx; }
.catalog-loading-more, .catalog-end { padding: 16rpx; font-size: 20rpx; }
