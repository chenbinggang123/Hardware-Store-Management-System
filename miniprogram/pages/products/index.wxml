<view class="screen catalog-screen">
  <view class="catalog-head"><view><view class="page-kicker">商品与库存</view><view class="catalog-title">商品库</view><view class="catalog-subtitle">常用商品优先，需要维护时再提醒</view></view><view class="btn btn-primary btn-sm" role="button" aria-label="新增商品" bindtap="openCreate">＋ 新增</view></view>

  <view class="catalog-tools">
    <view class="search-box"><text class="search-icon">查</text><input class="search-input" aria-label="搜索商品" placeholder="名称、条码或厂商" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="submitSearch" /><view class="search-clear" wx:if="{{keyword}}" role="button" aria-label="清除商品搜索" bindtap="clearKeyword">×</view></view>
    <view class="catalog-tabs" role="tablist" aria-label="商品视图"><view class="catalog-tab {{view === 'frequent' ? 'active' : ''}}" role="tab" aria-selected="{{view === 'frequent'}}" data-view="frequent" bindtap="selectView">常用</view><view class="catalog-tab {{view === 'attention' ? 'active' : ''}}" role="tab" aria-selected="{{view === 'attention'}}" data-view="attention" bindtap="selectView">需处理 <text wx:if="{{summary.attentionCount}}">{{summary.attentionCount}}</text></view><view class="catalog-tab {{view === 'all' ? 'active' : ''}}" role="tab" aria-selected="{{view === 'all'}}" data-view="all" bindtap="selectView">全部</view></view>
  </view>

  <view class="catalog-context"><text>{{view === 'frequent' ? '按最近成交和进货频次排列' : view === 'attention' ? '只显示低库存、未定价或库存未记录' : '全部商品，按名称排列'}}</text><text>{{totalElements}} 件</text></view>

  <view class="loading-state" wx:if="{{loading}}">商品数据加载中…</view>
  <view class="catalog-list" wx:elif="{{products.length}}">
    <view class="catalog-row {{item.attentionReasons.length ? 'needs-attention' : ''}}" wx:for="{{products}}" wx:key="id">
      <view class="catalog-summary" role="button" aria-label="查看商品{{item.name}}" data-id="{{item.id}}" bindtap="openDetail"><image class="product-thumb" wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" /><view class="product-thumb placeholder" wx:else>{{item.initial}}</view><view class="catalog-copy"><view class="catalog-name">{{item.name}}</view><view class="catalog-spec">{{item.specText}}</view><view class="catalog-price">¥{{item.retailPrice}} <text>· {{item.stockStateText}}</text></view><view class="catalog-activity">{{item.activityText}}<text wx:if="{{item.inventoryRecorded}}"> · 库存 {{item.stockText}}</text></view><view class="catalog-alert" wx:if="{{item.attentionText}}">{{item.attentionText}}</view></view><view class="catalog-arrow">›</view></view>
      <view class="catalog-actions"><view class="catalog-action primary" role="button" aria-label="用{{item.name}}开单" data-id="{{item.id}}" bindtap="openSale">开单</view><view class="catalog-action" role="button" aria-label="盘点{{item.name}}库存" data-id="{{item.id}}" data-inventory-id="{{item.inventoryId}}" bindtap="openAdjust">盘点</view><view class="catalog-action" role="button" aria-label="{{item.name}}更多操作" data-id="{{item.id}}" data-inventory-id="{{item.inventoryId}}" data-name="{{item.name}}" bindtap="manageProduct">更多</view></view>
    </view>
    <view class="catalog-loading-more" wx:if="{{loadingMore}}">正在加载更多…</view><view class="catalog-end" wx:elif="{{totalPages && page + 1 >= totalPages}}">已经到底了</view>
  </view>

  <view class="empty-state" wx:elif="{{loadError}}"><text class="empty-icon">!</text><view class="empty-title">商品加载失败</view><view class="empty-desc">{{loadError}}</view><view class="state-action" bindtap="retryLoad">重新加载商品</view></view>
  <view class="empty-state" wx:else><view class="empty-title">{{emptyTitle}}</view><view class="empty-desc">{{emptyDesc}}</view><view class="state-action" wx:if="{{view === 'all' && !keyword}}" bindtap="openCreate">新增第一个商品</view><view class="state-action" wx:elif="{{view === 'frequent'}}" bindtap="openAgent">让小五帮我查商品</view></view>
</view>
