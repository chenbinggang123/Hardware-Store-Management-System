<view class="screen">
  <view class="page-heading">
    <view class="page-heading-copy">
      <view class="page-kicker">商品资料</view>
      <view class="section-title">查商品、看价格</view>
      <view class="page-description">名称、条码和库存都能直接查</view>
    </view>
    <view class="btn btn-primary btn-sm" bindtap="openCreate">＋ 新增</view>
  </view>

  <view class="stats-strip">
    <view class="stat-item">
      <view class="stat-value">{{metrics.total}}</view>
      <view class="stat-label">全部商品</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{metrics.online}}</view>
      <view class="stat-label">已上架</view>
    </view>
    <view class="stat-item">
      <view class="stat-value" style="color: #B95034;">{{metrics.lowStock}}</view>
      <view class="stat-label">低库存</view>
    </view>
  </view>

  <view class="page-widget-row">
    <view class="page-widget-alert {{metrics.lowStock ? 'is-warning' : ''}}">
      <view class="page-widget-mark">警</view>
      <view><view class="page-widget-title">{{metrics.lowStock ? metrics.lowStock + ' 件需要补货' : '库存状态正常'}}</view><view class="page-widget-desc">低于 10 件自动提醒</view></view>
    </view>
    <view class="agent-assist" bindtap="openAgent"><text>小五帮我找</text><text class="agent-assist-arrow">›</text></view>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索名称 / 条码 / 厂商" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="loadProducts" />
    </view>
    <view class="chip-row">
      <view class="chip {{status === '' ? 'active' : ''}}" data-status="" bindtap="selectStatus">全部</view>
      <view class="chip {{status === '1' ? 'active' : ''}}" data-status="1" bindtap="selectStatus">上架</view>
      <view class="chip {{status === '0' ? 'active' : ''}}" data-status="0" bindtap="selectStatus">下架</view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">商品数据加载中...</view>

  <view class="list" wx:if="{{!loading && hasProducts}}">
    <block wx:for="{{products}}" wx:key="id">
      <view class="list-card {{item.lowStock ? 'low-stock-card' : ''}}">
        <view class="list-head">
          <view style="flex:1; min-width:0;">
            <view class="list-title">{{item.name}}</view>
            <view class="list-meta">{{item.spec}} · {{item.unit}} · 条码 {{item.barcode}}</view>
          </view>
          <view style="display:flex; flex-direction:column; gap:8rpx; align-items:flex-end;">
            <view class="tag {{item.status === 1 ? 'tag-success' : 'tag-neutral'}}">{{item.statusText}}</view>
            <view class="tag tag-warning" wx:if="{{item.lowStock}}">低库存</view>
          </view>
        </view>
        <view class="list-meta">零售 ¥{{item.retailPrice}} · 批发 ¥{{item.wholesalePrice}} · 老客户 ¥{{item.oldCustomerPrice}}</view>
        <view class="list-meta">库存 {{item.stock}} · 库位 {{item.locationText}} · 厂商 {{item.sourceFactoryText}}</view>
        <view class="ledger-actions">
          <view class="ledger-action primary" bindtap="openDetail" data-id="{{item.id}}">查看商品</view>
          <view class="ledger-action" bindtap="openEdit" data-id="{{item.id}}">编辑资料</view>
          <view class="ledger-action" bindtap="manageProduct" data-id="{{item.id}}" data-name="{{item.name}}" data-status="{{item.nextStatus}}" data-status-text="{{item.nextStatusText}}">更多操作</view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{!loading && loadError}}"><text class="empty-icon">!</text><view class="empty-title">商品加载失败</view><view class="empty-desc">{{loadError}}，请检查网络后重试。</view><view class="state-action" bindtap="retryLoad">重新加载商品</view></view>
  <view class="empty-state" wx:if="{{!loading && !loadError && !hasProducts}}">
    <text class="empty-icon">📦</text>
    <view class="empty-title">暂无商品</view>
    <view class="empty-desc">点击右上角“新增”，添加第一个商品</view>
  </view>
</view>
