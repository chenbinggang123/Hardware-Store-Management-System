<view class="screen catalog-screen">
  <view class="catalog-head"><view class="catalog-title">商品<text class="catalog-count">{{totalElements}} 件</text></view><view class="btn btn-outline btn-sm" role="button" aria-label="手动补录商品" bindtap="openCreate">补录</view></view>

  <!-- 筛选都用下拉：厂商、视图；和搜索框一起占一两行 -->
  <view class="catalog-tools pick-row">
    <picker range="{{factoryNames}}" value="{{factoryIndex}}" bindchange="pickFactory"><view class="pick {{factory ? 'on' : ''}}">{{factory || '全部厂商'}}</view></picker>
    <picker range="{{viewNames}}" value="{{view === 'frequent' ? 1 : (view === 'attention' ? 2 : 0)}}" bindchange="pickView"><view class="pick {{view !== 'all' ? 'on' : ''}}">{{view === 'frequent' ? '常用' : (view === 'attention' ? '需处理' : '全部')}}<text class="pick-badge" wx:if="{{summary.attentionCount}}">{{summary.attentionCount}}</text></view></picker>
    <view class="factory-links" wx:if="{{factory}}"><text bindtap="openProcurement">记进货</text><text bindtap="openFactoryLedger">进货账本</text></view>
    <view class="search-box"><text class="search-icon">查</text><input class="search-input" aria-label="搜索商品" placeholder="名称、条码或厂商" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="submitSearch" /><view class="search-clear" wx:if="{{keyword}}" role="button" aria-label="清除商品搜索" bindtap="clearKeyword">×</view></view>
  </view>


  <view class="loading-state" wx:if="{{loading}}">商品数据加载中…</view>
  <view class="catalog-list" wx:elif="{{products.length}}">
    <view class="catalog-row {{item.attentionReasons.length ? 'needs-attention' : ''}}" wx:for="{{products}}" wx:key="id">
      <view class="catalog-summary" role="button" aria-label="查看商品{{item.name}}" data-id="{{item.id}}" bindtap="openDetail"><image class="product-thumb" wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" /><view class="product-thumb placeholder" wx:else>{{item.initial}}</view><view class="catalog-copy"><view class="catalog-name">{{item.name}}</view><view class="catalog-spec">{{item.specText}}<text wx:if="{{!factory}}"> · {{item.sourceFactory || '未分厂商'}}</text></view><view class="catalog-price">进 ¥{{item.costPrice}} <text>售 ¥{{item.retailPrice}}</text></view><view class="catalog-alert" wx:if="{{item.attentionText}}">{{item.attentionText}}</view></view></view>
      <!-- 右侧：库存数和改数量放在一起，一眼看到、一下改好 -->
      <view class="catalog-side"><text class="catalog-stock {{item.stockState === 'OUT_OF_STOCK' || item.stockState === 'LOW' ? 'warn' : ''}}">{{item.stockText}}</text><view class="catalog-action" role="button" aria-label="修改{{item.name}}数量" data-id="{{item.id}}" data-inventory-id="{{item.inventoryId}}" bindtap="openAdjust">改数量</view><view class="catalog-more" role="button" aria-label="{{item.name}}更多操作" data-id="{{item.id}}" data-inventory-id="{{item.inventoryId}}" data-name="{{item.name}}" bindtap="manageProduct">更多</view></view>
    </view>
    <view class="catalog-loading-more" wx:if="{{loadingMore}}">正在加载更多…</view><view class="catalog-end" wx:elif="{{totalPages && page + 1 >= totalPages}}">已经到底了</view>
  </view>

  <view class="empty-state" wx:elif="{{loadError}}"><text class="empty-icon">!</text><view class="empty-title">商品加载失败</view><view class="empty-desc">{{loadError}}</view><view class="state-action" bindtap="retryLoad">重新加载商品</view></view>
  <view class="empty-state" wx:else><view class="empty-title">{{emptyTitle}}</view><view class="empty-desc">{{emptyDesc}}</view><view class="state-action" wx:if="{{factory}}" bindtap="openProcurement">记一笔进货</view><view class="state-action" wx:elif="{{view === 'all' && !keyword}}" bindtap="openCreate">新增第一个商品</view><view class="state-action" wx:elif="{{view === 'frequent'}}" bindtap="openAgent">让小五帮我查商品</view></view>
</view>
