<view class="screen">
  <view class="section-head">
    <view class="section-title">商品管理</view>
    <view class="btn btn-primary btn-sm" bindtap="openCreate">＋ 新增</view>
  </view>

  <view class="stats-strip">
    <view class="stat-item">
      <view class="stat-value">{{metrics.total}}</view>
      <view class="stat-label">全部商品</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{metrics.online}}</view>
      <view class="stat-label">已上架</view>
    </view>
    <view class="stat-item">
      <view class="stat-value" style="color: #BF4F1C;">{{metrics.lowStock}}</view>
      <view class="stat-label">低库存</view>
    </view>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索名称 / 条码 / 厂商" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="loadProducts" />
    </view>
    <view class="chip-row">
      <view class="chip {{status === '' ? 'active' : ''}}" data-status="" bindtap="selectStatus">全部</view>
      <view class="chip {{status === '1' ? 'active' : ''}}" data-status="1" bindtap="selectStatus">上架</view>
      <view class="chip {{status === '0' ? 'active' : ''}}" data-status="0" bindtap="selectStatus">下架</view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">商品数据加载中...</view>

  <view class="list" wx:if="{{!loading && hasProducts}}">
    <block wx:for="{{products}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view style="flex:1; min-width:0;">
            <view class="list-title">{{item.name}}</view>
            <view class="list-meta">{{item.spec}} · {{item.unit}} · 条码 {{item.barcode}}</view>
          </view>
          <view style="display:flex; flex-direction:column; gap:8rpx; align-items:flex-end;">
            <view class="tag {{item.status === 1 ? 'tag-success' : 'tag-neutral'}}">{{item.statusText}}</view>
            <view class="tag tag-warning" wx:if="{{item.lowStock}}">低库存</view>
          </view>
        </view>
        <view class="list-meta">零售 ¥{{item.retailPrice}} · 批发 ¥{{item.wholesalePrice}} · 老客户 ¥{{item.oldCustomerPrice}}</view>
        <view class="list-meta">库存 {{item.stock}} · 库位 {{item.locationText}} · 厂商 {{item.sourceFactoryText}}</view>
        <view class="action-row">
          <view class="btn btn-outline btn-sm" bindtap="openDetail" data-id="{{item.id}}">详情</view>
          <view class="btn btn-outline btn-sm" bindtap="openEdit" data-id="{{item.id}}">编辑</view>
          <view class="btn btn-ghost btn-sm" bindtap="toggleStatus" data-id="{{item.id}}" data-status="{{item.nextStatus}}">{{item.nextStatusText}}</view>
          <view class="btn btn-danger btn-sm" bindtap="deleteProduct" data-id="{{item.id}}" data-name="{{item.name}}">删除</view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{!loading && !hasProducts}}">
    <text class="empty-icon">📦</text>
    <view class="empty-title">暂无商品</view>
    <view class="empty-desc">点击右上角"新增"添加第一个商品</view>
  </view>
</view>
