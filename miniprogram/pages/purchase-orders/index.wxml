<view class="screen">
  <view class="section-head">
    <view class="section-title">采购管理</view>
    <view class="btn btn-primary btn-sm" bindtap="openCreate">＋ 新建采购单</view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">采购数据加载中...</view>

  <view class="list" wx:if="{{!loading && purchaseOrders.length}}">
    <block wx:for="{{purchaseOrders}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view style="flex:1; min-width:0;">
            <view class="list-title">{{item.orderNumber}}</view>
            <view class="list-meta">供应商 ID {{item.supplierId}} · 经办人 {{item.operatorId}}</view>
          </view>
          <view class="tag {{item.status === '已入库' ? 'tag-success' : 'tag-warning'}}">{{item.status}}</view>
        </view>
        <view class="list-meta">总金额 ¥{{item.totalAmount}} · {{item.orderTime}}</view>
        <view class="list-meta">明细 {{item.items ? item.items.length : 0}} 行 · {{item.remark || '无备注'}}</view>
        <view class="action-row">
          <view class="btn btn-outline btn-sm" bindtap="openDetail" data-id="{{item.id}}">详情</view>
          <view class="btn btn-outline btn-sm" bindtap="openEdit" data-id="{{item.id}}">编辑</view>
          <view class="btn btn-ghost btn-sm" bindtap="openDetail" data-id="{{item.id}}">确认入库</view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{!loading && !purchaseOrders.length}}">
    <text class="empty-icon">📥</text>
    <view class="empty-title">暂无采购单</view>
    <view class="empty-desc">点击右上角新建第一张采购单</view>
  </view>
</view>
