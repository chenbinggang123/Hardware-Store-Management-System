.settlement-title { margin-top: 4rpx; color: #17231E; font-size: 46rpx; font-weight: 800; }.settlement-desc { margin-top: 8rpx; color: #52605A; font-size: 25rpx; line-height: 1.65; }
.settlement-total { margin-top: 24rpx; padding: 24rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; color: #FFF; background: #174C5B; border-top: 9rpx solid #F2B84B; }.settlement-total text { display: block; color: #CFE0E4; font-size: 23rpx; }.settlement-total .total-value { display: block; margin-top: 7rpx; color: #FFF; font-size: 43rpx; font-weight: 800; }.month-button { min-height: 68rpx; padding: 0 16rpx; display: flex; align-items: center; border: 1rpx solid #8EB0B8; font-size: 22rpx; font-weight: 700; }.progress-note { padding: 16rpx 20rpx; color: #52605A; background: #E8F1F8; font-size: 23rpx; }
.settlement-list { margin-top: 24rpx; }.settlement-row { margin-bottom: 18rpx; background: #FFF; border: 1rpx solid #CED8D3; }.settlement-head { padding: 22rpx 20rpx; display: flex; justify-content: space-between; gap: 16rpx; border-bottom: 1rpx solid #DCE3DF; }.settlement-name { color: #17231E; font-size: 30rpx; font-weight: 800; }.settlement-code { margin-top: 4rpx; color: #718079; font: 21rpx monospace; }.settlement-balance { color: #A83F32; font-size: 30rpx; font-weight: 800; white-space: nowrap; }
.settlement-numbers { display: grid; grid-template-columns: 1fr 1fr; }.settlement-numbers view { min-height: 98rpx; padding: 16rpx 20rpx; box-sizing: border-box; border-right: 1rpx solid #E0E6E3; border-bottom: 1rpx solid #E0E6E3; }.settlement-numbers view:nth-child(2n) { border-right: 0; }.settlement-numbers text { display: block; color: #66746E; font-size: 21rpx; }.settlement-numbers .number-value { color: #26332E; font-size: 27rpx; font-weight: 800; }.status-picker { min-height: 82rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; color: #245E9B; background: #F3F6F4; font-size: 25rpx; font-weight: 700; }.status-picker text { color: #718079; font-size: 21rpx; font-weight: 500; }
