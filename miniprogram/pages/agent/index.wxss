.run-progress-stage { margin-top: 5rpx; color: #52605A; font-size: 25rpx; }
.run-progress-track { height: 10rpx; margin-top: 20rpx; overflow: hidden; background: #DCE3DF; }
.run-progress-track view { min-width: 12%; height: 100%; background: #245E9B; animation: agent-progress 1.35s ease-in-out infinite alternate; }
.run-progress-track view.determinate { min-width: 0; animation: none; transform: none; }
@keyframes agent-progress { from { transform: translateX(-18%); } to { transform: translateX(182%); } }
.run-progress-note { margin-top: 16rpx; color: #52605A; font-size: 24rpx; line-height: 1.6; }
.run-progress-count { margin-top: 12rpx; color: #40504A; font-size: 23rpx; font-weight: 650; }
.run-progress-actions { margin-top: 16rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.run-progress-action { min-height: 76rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #B9D0E2; color: #245E9B; background: #E8F1F8; font-size: 27rpx; font-weight: 700; }
.run-progress-action.secondary { color: #7D342A; border-color: #E0B8AF; background: #F7E7E3; }
.network-state { margin: 20rpx 0; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-left: 7rpx solid #B94C3A; background: #FCE9E4; }
.network-title { color: #A83F32; font-size: 28rpx; font-weight: 750; }
.network-desc { margin-top: 4rpx; color: #73483E; font-size: 24rpx; }
.network-retry { min-height: 72rpx; padding: 0 18rpx; display: flex; align-items: center; flex: 0 0 auto; color: #FFF; background: #A83F32; font-size: 26rpx; font-weight: 700; }
.result-sheet { border-left-width: 7rpx; }
.result-sheet.tone-danger { border-left-color: #A83F32; background: #FCE9E4; }
.result-actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.result-actions view { min-height: 72rpx; padding: 0 18rpx; display: flex; align-items: center; border-radius: 10rpx; color: #245E9B; background: #E8F1F8; font-size: 25rpx; font-weight: 700; }
.attach-button { width: 100rpx; min-height: 76rpx; border-radius: 12rpx; font-size: 25rpx; font-weight: 700; }
.send-button { width: 116rpx; min-height: 76rpx; border-radius: 12rpx; font-size: 27rpx; }
.composer-input { font-size: 28rpx; }
.composer-hint { font-size: 23rpx; }
.history-entry-action { min-width: 52rpx; min-height: 52rpx; }
@media (max-width: 340px) {
  .agent-screen { padding-left: 20rpx; padding-right: 20rpx; }
  .task-entry { padding-left: 14rpx; padding-right: 14rpx; }
  .attach-button { width: 88rpx; }
  .send-button { width: 102rpx; }
}
.message-attachments { margin-bottom: 10rpx; }
.composer-space { height: 260rpx; }

/* Supply-chain ledger palette */
.agent-mark, .send-button, .user .message, .history-new { background: #245E9B; }
.agent-live, .history-button, .new-task, .history-close, .attachment-remove { color: #245E9B; }
.agent-live-dot { background: #247052; }
.suggestion-mark, .attachment-icon { color: #245E9B; background: #E6F0F7; }
.history-entry.active { border-left-color: #245E9B; background: #EEF4F8; }
.approval-topline, .approval-button.confirm { background: #245E9B; }
.risk-badge { color: #245E9B; background: #E6F0F7; }
.composer-input:focus { border-color: #245E9B; }

/* Mobile conversation workspace: quiet chrome, conversation-first hierarchy. */
page { height: 100%; overflow: hidden; background: #FFFFFF; }
.agent-screen {
  height: 100vh;
  min-height: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #FFFFFF;
  color: #171717;
}
.agent-header {
  min-height: 104rpx;
  padding: 10rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-bottom: 1rpx solid #ECECEC;
  background: rgba(255,255,255,.98);
}
.icon-button {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 18rpx;
  color: #262626;
}
.icon-button:active { background: #F1F1F1; }
.menu-button { flex-direction: column; gap: 7rpx; }
.menu-line { width: 34rpx; height: 3rpx; border-radius: 3rpx; background: #242424; }
.menu-line.short { width: 24rpx; margin-right: 10rpx; }
.agent-heading { flex: 1; min-width: 0; text-align: center; }
.agent-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #171717;
  font-size: 29rpx;
  line-height: 1.25;
  font-weight: 650;
}
.agent-subtitle {
  min-height: 26rpx;
  margin-top: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #7A7A7A;
  font-size: 20rpx;
}
.stream-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #21865A; }
.compose-square { width: 30rpx; height: 30rpx; border: 3rpx solid #242424; border-radius: 5rpx; box-sizing: border-box; }
.compose-stroke { position: absolute; width: 23rpx; height: 3rpx; top: 23rpx; right: 18rpx; background: #242424; transform: rotate(-45deg); box-shadow: 0 -7rpx 0 #FFFFFF; }

.conversation-scroll { flex: 1; min-height: 0; height: 0; background: #FFFFFF; }
.welcome { padding: 104rpx 44rpx 20rpx; text-align: center; }
.welcome-mark {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx 26rpx 26rpx 8rpx;
  color: #FFFFFF;
  background: #1F6F5B;
  font-size: 32rpx;
  font-weight: 750;
}
.welcome-title { margin-top: 28rpx; color: #171717; font-size: 40rpx; line-height: 1.3; font-weight: 680; }
.welcome-subtitle { max-width: 590rpx; margin: 14rpx auto 0; color: #727272; font-size: 25rpx; line-height: 1.65; }
.quick-actions { margin-top: 32rpx; display: flex; justify-content: center; gap: 14rpx; }
.quick-action {
  min-height: 68rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid #DEDEDE;
  border-radius: 34rpx;
  color: #333333;
  background: #FFFFFF;
  font-size: 23rpx;
}
.quick-action:active { background: #F4F4F4; }
.quick-icon { color: #1F6F5B; font-size: 21rpx; font-weight: 700; }
.suggestions { margin: 34rpx 28rpx 48rpx; }
.suggestion-title { margin: 0 6rpx 12rpx; color: #828282; font-size: 22rpx; font-weight: 500; }
.suggestion {
  min-height: 84rpx;
  margin-top: 10rpx;
  padding: 17rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  color: #2A2A2A;
  background: #FFFFFF;
  font-size: 25rpx;
}
.suggestion:active { background: #F6F6F6; }
.suggestion-copy { flex: 1; min-width: 0; }
.suggestion-arrow { color: #9A9A9A; font-size: 25rpx; }

.conversation { margin: 0; padding: 24rpx 28rpx 12rpx; }
.message-row { margin: 22rpx 0; }
.message-row.user { justify-content: flex-end; }
.message { font-size: 28rpx; line-height: 1.72; }
.user .message {
  max-width: 84%;
  padding: 18rpx 24rpx;
  border-radius: 24rpx 24rpx 7rpx 24rpx;
  color: #1D1D1D;
  background: #F1F1F1;
}
.assistant .message-stack, .error .message-stack { width: 100%; }
.assistant-author {
  margin: 0 0 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #5F5F5F;
  font-size: 22rpx;
  font-weight: 600;
}
.assistant-dot {
  width: 38rpx;
  height: 38rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx 12rpx 12rpx 4rpx;
  color: #FFFFFF;
  background: #1F6F5B;
  font-size: 17rpx;
}
.assistant .message, .error .message {
  max-width: none;
  padding: 0 4rpx 0 48rpx;
  border: 0;
  border-radius: 0;
  color: #242424;
  background: transparent;
  box-shadow: none;
}
.error .message { color: #A13228; border: 0; }
.answer-field { border-color: #ECECEC; }
.product-result { border-left-color: #1F6F5B; background: #F0F7F4; }
.product-result-price { color: #17604E; }
.typing-indicator { height: 42rpx; display: flex; align-items: center; gap: 8rpx; }
.typing-indicator text { width: 9rpx; height: 9rpx; border-radius: 50%; background: #8B8B8B; animation: typing-dot 1.1s infinite ease-in-out; }
.typing-indicator text:nth-child(2) { animation-delay: .15s; }
.typing-indicator text:nth-child(3) { animation-delay: .3s; }
.stream-cursor { display: inline-block; width: 3rpx; height: 30rpx; margin-left: 4rpx; vertical-align: -5rpx; background: #1F6F5B; animation: stream-cursor .85s steps(1) infinite; }
@keyframes typing-dot { 0%, 70%, 100% { opacity: .28; transform: translateY(0); } 35% { opacity: 1; transform: translateY(-4rpx); } }
@keyframes stream-cursor { 0%, 48% { opacity: 1; } 49%, 100% { opacity: 0; } }
.conversation-end { height: 30rpx; }

.approval-sheet { margin: 18rpx 28rpx 34rpx; border-radius: 22rpx; box-shadow: 0 10rpx 34rpx rgba(0,0,0,.07); }
.result-sheet { margin: 18rpx 28rpx 34rpx; }

.composer {
  position: relative;
  z-index: 10;
  left: auto;
  right: auto;
  bottom: auto;
  flex: 0 0 auto;
  padding: 14rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  display: block;
  background: #FFFFFF;
  border-top: 1rpx solid #ECECEC;
}
.composer-row {
  min-height: 88rpx;
  padding: 7rpx;
  display: flex;
  align-items: flex-end;
  gap: 7rpx;
  border: 2rpx solid #D9D9D9;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 18rpx rgba(0,0,0,.045);
}
.composer-row:focus-within { border-color: #AFAFAF; }
.attach-button {
  width: 72rpx;
  height: 72rpx;
  border: 0;
  border-radius: 22rpx;
  color: #3C3C3C;
  background: transparent;
  font-size: 39rpx;
}
.attach-button:active { background: #F1F1F1; }
.composer-input {
  min-height: 72rpx;
  max-height: 190rpx;
  padding: 15rpx 10rpx;
  border: 0;
  border-radius: 0;
  color: #1E1E1E;
  background: transparent;
  font-size: 28rpx;
  line-height: 1.5;
}
.composer-input:focus { border: 0; }
.send-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: #202020;
  font-size: 35rpx;
  font-weight: 500;
}
.send-button[disabled] { color: #AFAFAF; background: #E9E9E9; }
.composer-hint { margin-top: 9rpx; color: #929292; text-align: center; font-size: 18rpx; line-height: 1.4; }
.composer-attachments { margin: 0 4rpx 10rpx; }
.attachment-card { border-color: #E2E2E2; background: #F7F7F7; }
.attachment-icon { color: #17604E; background: #E1F0EA; }

.history-backdrop { z-index: 40; inset: 0; background: rgba(0,0,0,.38); }
.history-drawer {
  z-index: 41;
  top: 0;
  left: 0;
  right: auto;
  bottom: 0;
  width: 86vw;
  height: 100vh;
  padding: calc(20rpx + env(safe-area-inset-top)) 18rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  border-radius: 0 28rpx 28rpx 0;
  background: #F7F7F8;
  transform: translateX(-104%);
  transition: transform .2s ease-out;
  box-shadow: 18rpx 0 60rpx rgba(0,0,0,.16);
}
.history-drawer.open { transform: translateX(0); }
.history-head { min-height: 76rpx; padding: 4rpx 8rpx 18rpx; align-items: center; border: 0; }
.drawer-brand { display: flex; align-items: center; gap: 14rpx; }
.drawer-mark { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx 16rpx 16rpx 5rpx; color: #FFFFFF; background: #1F6F5B; font-size: 21rpx; font-weight: 700; }
.history-title { font-size: 28rpx; font-weight: 680; }
.history-subtitle { margin-top: 1rpx; font-size: 19rpx; }
.history-close { width: 60rpx; height: 60rpx; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #4B4B4B; font-size: 40rpx; font-weight: 300; }
.history-new { min-height: 82rpx; padding: 0 20rpx; justify-content: flex-start; gap: 13rpx; border: 1rpx solid #DCDCDC; border-radius: 18rpx; color: #252525; background: #FFFFFF; font-size: 25rpx; font-weight: 600; }
.history-new:active { background: #EFEFEF; }
.history-new-icon { font-size: 34rpx; font-weight: 300; }
.history-section-label { padding: 26rpx 14rpx 10rpx; color: #848484; font-size: 20rpx; font-weight: 600; }
.history-list { flex: 1; min-height: 0; height: auto; }
.history-entry {
  min-height: 94rpx;
  padding: 13rpx 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 0;
  border-radius: 15rpx;
}
.history-entry + .history-entry { margin-top: 3rpx; }
.history-entry.active { padding-left: 10rpx; border: 0; background: #E8E8EA; }
.history-entry:active { background: #ECECEE; }
.history-chat-icon { width: 44rpx; flex: 0 0 auto; color: #6B6B6B; text-align: center; font-size: 27rpx; }
.history-entry-body { flex: 1; min-width: 0; }
.history-entry-top { gap: 10rpx; }
.history-entry-title { color: #2B2B2B; font-size: 24rpx; font-weight: 560; }
.history-entry-time { color: #929292; font-size: 18rpx; }
.history-entry-preview { margin-top: 4rpx; color: #7B7B7B; font-size: 20rpx; }
.history-entry-actions { flex: 0 0 auto; display: flex; align-items: center; gap: 2rpx; }
.history-entry-action { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #666666; font-size: 25rpx; }
.history-entry-action:active { background: #DCDCDD; }
.history-entry-action.delete { color: #A63A32; font-size: 30rpx; }
.history-loading, .history-empty { padding: 70rpx 20rpx; }
.drawer-foot { padding: 16rpx 12rpx 4rpx; border-top: 1rpx solid #E0E0E0; color: #858585; text-align: center; font-size: 18rpx; }

/* Final family ledger overrides */
.agent-screen { background: #F3F5F2; }
.welcome-subtitle { color: #52605A; font-size: 26rpx; }
.task-entry-list { border-radius: 0; }
.suggestion, .message, .assistant-content { font-size: 28rpx; }
.run-progress { margin-left: 28rpx; margin-right: 28rpx; }
.network-state { margin-left: 28rpx; margin-right: 28rpx; }
.result-sheet { border-radius: 0; }
.composer-row { border-radius: 16rpx; }
.attach-button { width: 100rpx; min-width: 100rpx; height: 76rpx; min-height: 76rpx; border-radius: 12rpx; color: #245E9B; background: #E8F1F8; font-size: 25rpx; font-weight: 700; }
.send-button { width: 116rpx; min-width: 116rpx; height: 76rpx; min-height: 76rpx; border-radius: 12rpx; color: #FFF; background: #245E9B; font-size: 27rpx; font-weight: 700; }
.composer-hint { color: #52605A; font-size: 23rpx; }
.history-subtitle, .history-entry-time, .history-entry-preview, .history-section-label, .drawer-foot { font-size: 24rpx; }
.history-entry-action { width: 56rpx; height: 56rpx; }
@media (max-width: 340px) {
  .attach-button { width: 88rpx; min-width: 88rpx; }
  .send-button { width: 102rpx; min-width: 102rpx; }
}
