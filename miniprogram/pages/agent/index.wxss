/* 小五对话页
   一套色板：纸面 #F3F5F2、墨 #17231E、灰 #6C7873、账本蓝 #245E9B、表格绿 #247052。
   蓝色只用于操作和用户自己的消息，绿色只用于 Excel 和文件，其余保持安静。 */

page { height: 100%; overflow: hidden; background: #F3F5F2; }
.agent-screen { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #F3F5F2; color: #17231E; }

/* 顶栏 */
.agent-header { padding: 8rpx 16rpx; position: relative; box-sizing: border-box; display: flex; align-items: flex-end; gap: 8rpx; background: rgba(248, 250, 249, .96); border-bottom: 1rpx solid #D9E0DC; }
.icon-button { width: 76rpx; height: 76rpx; flex: 0 0 auto; position: relative; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #17231E; }
.icon-button:active { background: #E6EBE8; }
.menu-button { flex-direction: column; gap: 7rpx; }
.menu-line { width: 34rpx; height: 3rpx; border-radius: 3rpx; background: #17231E; }
.menu-line.short { width: 24rpx; margin-right: 10rpx; }
.agent-heading { flex: 1; min-width: 0; padding: 0 8rpx; text-align: center; pointer-events: none; }
.compose-button { margin-left: 0; }
.agent-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #17231E; font-size: 31rpx; line-height: 1.22; font-weight: 760; letter-spacing: .5rpx; }
.agent-subtitle { min-height: 26rpx; margin-top: 3rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #6C7873; font-size: 21rpx; }
.stream-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #247052; }
.compose-square { width: 30rpx; height: 30rpx; border: 3rpx solid #17231E; border-radius: 5rpx; box-sizing: border-box; }
.compose-stroke { position: absolute; width: 23rpx; height: 3rpx; top: 23rpx; right: 18rpx; background: #17231E; transform: rotate(-45deg); box-shadow: 0 -7rpx 0 #F3F5F2; }

/* 会话列表抽屉 */
.history-backdrop { position: fixed; z-index: 40; inset: 0; background: rgba(23, 35, 30, .38); }
.history-drawer { position: fixed; z-index: 41; top: 0; left: 0; bottom: 0; width: 86vw; max-width: 680rpx; box-sizing: border-box; padding: calc(20rpx + env(safe-area-inset-top)) 18rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; background: #F8FAF9; transform: translateX(-104%); transition: transform .2s ease-out; box-shadow: 18rpx 0 60rpx rgba(23, 42, 34, .16); }
.history-drawer.open { transform: translateX(0); }
.history-head { min-height: 76rpx; padding: 4rpx 8rpx 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.drawer-brand { display: flex; align-items: center; gap: 14rpx; }
.drawer-mark { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx 16rpx 16rpx 5rpx; color: #FFFFFF; background: #245E9B; font-size: 21rpx; font-weight: 700; }
.history-title { color: #17231E; font-size: 28rpx; font-weight: 700; }
.history-subtitle { margin-top: 1rpx; color: #6C7873; font-size: 22rpx; }
.history-close { width: 60rpx; height: 60rpx; position: relative; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; }
.history-close view { position: absolute; width: 30rpx; height: 3rpx; border-radius: 3rpx; background: #34413C; transform: rotate(45deg); }
.history-close view:last-child { transform: rotate(-45deg); }
.history-new { min-height: 82rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 13rpx; border-radius: 16rpx; color: #FFFFFF; background: #245E9B; font-size: 26rpx; font-weight: 700; }
.history-new-icon { width: 34rpx; height: 34rpx; position: relative; flex: 0 0 auto; }
.history-new-icon view { position: absolute; top: 15rpx; left: 5rpx; width: 24rpx; height: 3rpx; border-radius: 3rpx; background: #FFFFFF; }
.history-new-icon view:last-child { transform: rotate(90deg); }
.history-section-head { padding: 28rpx 10rpx 12rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; }
.history-section-label { color: #25332D; font-size: 24rpx; font-weight: 750; letter-spacing: .5rpx; }
.history-section-note { margin-top: 3rpx; color: #8A948F; font-size: 21rpx; }
.history-count { min-width: 38rpx; height: 30rpx; padding: 0 9rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 15rpx; color: #527061; background: #E5ECE8; font-size: 19rpx; font-variant-numeric: tabular-nums; }
.drawer-scroll { flex: 1; min-height: 0; margin-top: 8rpx; }
.history-search { height: 68rpx; margin: 0 8rpx 12rpx; padding: 0 12rpx 0 16rpx; display: flex; align-items: center; gap: 13rpx; box-sizing: border-box; border: 1rpx solid #D5DEDA; border-radius: 18rpx; background: #FFFFFF; }
.history-search:focus-within { border-color: #7EA293; box-shadow: 0 0 0 4rpx rgba(36, 112, 82, .08); }
.history-search input { flex: 1; min-width: 0; height: 100%; color: #17231E; font-size: 24rpx; }
.history-search-icon { width: 23rpx; height: 23rpx; position: relative; flex: 0 0 auto; border: 3rpx solid #6D7D76; border-radius: 50%; box-sizing: border-box; }
.history-search-icon::after { content: ''; position: absolute; width: 10rpx; height: 3rpx; right: -8rpx; bottom: -4rpx; border-radius: 3rpx; background: #6D7D76; transform: rotate(45deg); }
.history-search-clear { width: 48rpx; height: 48rpx; position: relative; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.history-search-clear view { position: absolute; width: 22rpx; height: 3rpx; border-radius: 3rpx; background: #8A948F; transform: rotate(45deg); }
.history-search-clear view:last-child { transform: rotate(-45deg); }
.history-list-scroll { height: 470rpx; margin: 0 6rpx; padding: 7rpx; box-sizing: border-box; border-radius: 18rpx; background: #EEF2F0; }
.history-entry { min-height: 88rpx; padding: 12rpx 8rpx 12rpx 14rpx; display: flex; align-items: center; gap: 10rpx; border-radius: 13rpx; background: transparent; }
.history-entry + .history-entry { margin-top: 2rpx; }
.history-entry.active { background: #FFFFFF; box-shadow: 0 5rpx 15rpx rgba(34, 55, 45, .07), inset 5rpx 0 0 #245E9B; }
.history-entry:active { background: #E1E8E4; }
.history-entry-body { flex: 1; min-width: 0; }
.history-entry-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10rpx; }
.history-entry-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #17231E; font-size: 24rpx; font-weight: 680; }
.history-entry-time { flex: 0 0 auto; color: #8A948F; font-size: 20rpx; }
.history-entry-preview { margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #6C7873; font-size: 22rpx; }
.history-entry-more { width: 56rpx; height: 56rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; gap: 5rpx; border-radius: 12rpx; }
.history-entry-more view { width: 6rpx; height: 6rpx; border-radius: 50%; background: #6C7873; }
.history-entry-more:active { background: #DCE2DF; }
.history-loading, .history-empty { margin: 0 6rpx; padding: 70rpx 20rpx; border-radius: 18rpx; background: #EEF2F0; text-align: center; color: #6C7873; font-size: 25rpx; line-height: 1.8; }
.history-empty text { color: #8A948F; font-size: 22rpx; }
.drawer-divider { height: 1rpx; margin: 28rpx 10rpx 0; background: #DCE2DF; }
.nav-heading { padding-top: 24rpx; }
.drawer-feature-panel, .drawer-nav-panel { margin: 0 6rpx; overflow: hidden; border: 1rpx solid #D9E1DD; border-radius: 18rpx; background: #FFFFFF; }
.drawer-feature { min-height: 98rpx; padding: 15rpx 15rpx; display: flex; align-items: center; justify-content: space-between; gap: 15rpx; box-sizing: border-box; }
.drawer-feature + .drawer-feature { border-top: 1rpx solid #E7ECE9; }
.drawer-feature:active, .drawer-group-head:active, .drawer-group-body view:active { background: #E8ECEA; }
.drawer-feature-symbol { width: 54rpx; height: 54rpx; position: relative; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; background: #EAF3EF; }
.drawer-feature-symbol > view { width: 27rpx; height: 34rpx; box-sizing: border-box; border: 3rpx solid #247052; border-radius: 4rpx; }
.drawer-feature-symbol.receipt > view::after { content: ''; position: absolute; left: 19rpx; right: 19rpx; top: 22rpx; height: 3rpx; background: #247052; box-shadow: 0 8rpx 0 #247052, 0 16rpx 0 #247052; }
.drawer-feature-symbol.file { background: #E9F0F7; }
.drawer-feature-symbol.file > view { border-color: #245E9B; }
.drawer-feature-symbol.file > view::after { content: ''; position: absolute; width: 10rpx; height: 10rpx; right: 12rpx; top: 10rpx; border-left: 3rpx solid #245E9B; border-bottom: 3rpx solid #245E9B; }
.drawer-feature-copy { flex: 1; min-width: 0; }
.drawer-feature-title { color: #17231E; font-size: 27rpx; font-weight: 740; }
.drawer-feature-desc { margin-top: 2rpx; color: #6C7873; font-size: 22rpx; }
.drawer-chevron { width: 14rpx; height: 14rpx; flex: 0 0 auto; border-right: 3rpx solid #7A8680; border-bottom: 3rpx solid #7A8680; transform: rotate(-45deg); transition: transform .16s ease; }
.drawer-chevron.open { transform: rotate(45deg); }
.drawer-group { border-bottom: 1rpx solid #E4E9E6; }
.drawer-group:last-child { border-bottom: 0; }
.drawer-group-head { min-height: 94rpx; padding: 13rpx 18rpx; display: flex; align-items: center; justify-content: space-between; color: #25332D; }
.drawer-group-copy { display: flex; flex-direction: column; gap: 4rpx; }
.drawer-group-copy text:first-child { font-size: 27rpx; font-weight: 740; }
.drawer-group-copy text:last-child { color: #78867F; font-size: 22rpx; font-weight: 400; }
.drawer-group-body { padding: 0 8rpx 12rpx; }
.drawer-group-body view { min-height: 72rpx; padding: 0 28rpx; display: flex; align-items: center; border-radius: 12rpx; color: #40504A; font-size: 25rpx; }
.drawer-foot { padding: 16rpx 12rpx 4rpx; border-top: 1rpx solid #DCE2DF; color: #6C7873; text-align: center; font-size: 22rpx; }

/* 对话区 */
.conversation-scroll { flex: 1; min-height: 0; height: 0; }

/* 欢迎页：对话优先，文件入口统一收进输入框的加号 */
.welcome { min-height: 62vh; padding: 70rpx 28rpx 34rpx; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; text-align: center; }
.welcome-title { color: #17231E; font-size: 50rpx; line-height: 1.22; font-weight: 800; letter-spacing: -1rpx; }
.welcome-subtitle { margin-top: 14rpx; color: #65726C; font-size: 25rpx; line-height: 1.6; }
.core-actions { margin-top: 42rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; text-align: left; }
.core-action { min-height: 134rpx; padding: 18rpx 16rpx; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 15rpx; box-sizing: border-box; border: 1rpx solid #CFD9D4; border-radius: 20rpx; background: rgba(255,255,255,.9); box-shadow: 0 8rpx 24rpx rgba(34, 55, 45, .045); }
.core-action:active { border-color: #8FAC9D; background: #EDF5F1; transform: translateY(1rpx); }
.core-action-icon { width: 44rpx; height: 44rpx; position: relative; flex: 0 0 auto; color: #247052; }
.core-action-icon > view { position: absolute; box-sizing: border-box; }
.core-action-billing > view:first-child { inset: 2rpx 8rpx 2rpx 8rpx; border: 3rpx solid #247052; border-radius: 5rpx; }
.core-action-billing > view:last-child { left: 15rpx; right: 15rpx; top: 15rpx; height: 3rpx; background: #247052; box-shadow: 0 10rpx 0 #247052, 0 20rpx 0 #247052; }
.core-action-scan > view:first-child { inset: 4rpx; border: 3rpx solid #247052; border-left-color: transparent; border-right-color: transparent; }
.core-action-scan > view:last-child { top: 11rpx; bottom: 11rpx; left: 4rpx; right: 4rpx; border: 3rpx solid #247052; border-top-color: transparent; border-bottom-color: transparent; }
.core-action-inventory > view:first-child { width: 30rpx; height: 30rpx; left: 3rpx; top: 3rpx; border: 3rpx solid #247052; border-radius: 50%; }
.core-action-inventory > view:last-child { width: 20rpx; height: 3rpx; right: 0; bottom: 7rpx; border-radius: 3rpx; background: #247052; transform: rotate(45deg); }
.core-action-ledger > view:first-child { inset: 3rpx 6rpx; border: 3rpx solid #247052; border-radius: 4rpx; }
.core-action-ledger > view:last-child { left: 15rpx; right: 15rpx; top: 16rpx; height: 3rpx; background: #247052; box-shadow: 0 10rpx 0 #247052, 0 20rpx 0 #247052; }
.core-action-copy { flex: 1; min-width: 0; }
.core-action-title { color: #17231E; font-size: 28rpx; line-height: 1.3; font-weight: 760; letter-spacing: -.3rpx; }
.core-action-desc { margin-top: 4rpx; color: #69766F; font-size: 22rpx; line-height: 1.4; }

/* 消息 */
.conversation { padding: 24rpx 28rpx 12rpx; }
.compact-actions { width: 100%; flex: 0 0 auto; box-sizing: border-box; border-top: 1rpx solid #E1E6E3; background: #F8FAF9; white-space: nowrap; }
.compact-actions-row { padding: 12rpx 20rpx; display: inline-flex; gap: 10rpx; }
.compact-action { min-height: 60rpx; padding: 0 20rpx; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #CDD8D2; border-radius: 30rpx; color: #2C5F4A; background: #FFFFFF; font-size: 23rpx; font-weight: 650; }
.compact-action:active { border-color: #8CB29F; background: #EDF5F1; }
.message-row { display: flex; margin: 22rpx 0; }
.message-row.user { justify-content: flex-end; }
.message { box-sizing: border-box; font-size: 29rpx; line-height: 1.82; overflow-wrap: anywhere; word-break: break-word; }
.user .message { max-width: 84%; padding: 18rpx 24rpx; border-radius: 22rpx 22rpx 6rpx 22rpx; color: #FFFFFF; background: #245E9B; }
.assistant .message-stack, .error .message-stack { width: 100%; }
.assistant-author { margin: 0 0 10rpx; display: flex; align-items: center; gap: 10rpx; color: #5B6762; font-size: 22rpx; font-weight: 600; }
.assistant-dot { width: 38rpx; height: 38rpx; display: inline-flex; align-items: center; justify-content: center; border-radius: 12rpx 12rpx 12rpx 4rpx; color: #FFFFFF; background: #245E9B; font-size: 17rpx; }
.assistant .message, .error .message { max-width: none; padding: 0 4rpx 0 48rpx; color: #17231E; }
.error .message { color: #A83F32; }
.answer-paragraph + .answer-paragraph { margin-top: 20rpx; }
.answer-heading { margin: 34rpx 0 10rpx; color: #17231E; font-size: 33rpx; line-height: 1.45; font-weight: 760; }
.answer-heading:first-child { margin-top: 0; }
.answer-list { margin-top: 9rpx; display: flex; align-items: flex-start; gap: 13rpx; color: #25332D; font-size: 29rpx; line-height: 1.72; }
.answer-list-marker { width: 22rpx; flex: 0 0 auto; color: #247052; font-weight: 800; text-align: center; }
.answer-field { display: flex; align-items: flex-start; gap: 18rpx; padding: 14rpx 0; border-bottom: 1rpx solid #E4E9E6; }
.answer-field:last-child { border-bottom: 0; }
.answer-field-label { width: 116rpx; flex: 0 0 auto; color: #6C7873; font-size: 24rpx; }
.answer-field-value { flex: 1; min-width: 0; color: #17231E; font-weight: 600; }
.product-result { min-height: 88rpx; margin: 18rpx 0; padding: 20rpx 20rpx 18rpx; border-left: 6rpx solid #245E9B; border-radius: 0 16rpx 16rpx 0; background: #E8F0F7; }
.product-result:first-child { margin-top: 0; }
.product-result:last-child { margin-bottom: 0; }
.product-result::after { content: '查看商品 ›'; display: block; margin-top: 12rpx; color: #245E9B; font-size: 25rpx; font-weight: 700; }
.product-result-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.product-result-name { flex: 1; min-width: 0; color: #17231E; font-size: 29rpx; font-weight: 700; line-height: 1.4; }
.product-result-price { flex: 0 0 auto; color: #245E9B; font-size: 29rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.product-result-meta { margin-top: 8rpx; color: #52605A; font-size: 24rpx; }
.product-result-id { margin-top: 12rpx; color: #8A948F; font-size: 21rpx; }
.typing-indicator { height: 42rpx; display: flex; align-items: center; gap: 8rpx; }
.typing-indicator text { width: 9rpx; height: 9rpx; border-radius: 50%; background: #8A948F; animation: typing-dot 1.1s infinite ease-in-out; }
.typing-indicator text:nth-child(2) { animation-delay: .15s; }
.typing-indicator text:nth-child(3) { animation-delay: .3s; }
.stream-cursor { display: inline-block; width: 3rpx; height: 30rpx; margin-left: 4rpx; vertical-align: -5rpx; background: #245E9B; animation: stream-cursor .85s steps(1) infinite; }
@keyframes typing-dot { 0%, 70%, 100% { opacity: .28; transform: translateY(0); } 35% { opacity: 1; transform: translateY(-4rpx); } }
@keyframes stream-cursor { 0%, 48% { opacity: 1; } 49%, 100% { opacity: 0; } }
.conversation-end { height: 30rpx; }

/* 文件卡：绿色左线表示可打开，红色表示失效 */
.file-card-list { margin-top: 18rpx; }
.file-card { display: flex; align-items: flex-start; gap: 14rpx; padding: 16rpx 18rpx; border: 1rpx solid #CFE0D6; border-left: 6rpx solid #247052; border-radius: 0 16rpx 16rpx 0; background: #F1F8F4; }
.file-card + .file-card { margin-top: 10rpx; }
.file-card.failed { border-color: #F1C1B5; border-left-color: #B94C3A; background: #FCEBE6; }
.file-card-mark { width: 56rpx; height: 56rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border: 2rpx solid #247052; border-radius: 10rpx; box-sizing: border-box; color: #247052; background-color: #FFFFFF; background-image: linear-gradient(#CFE0D6 1rpx, transparent 1rpx), linear-gradient(90deg, #CFE0D6 1rpx, transparent 1rpx); background-size: 100% 14rpx, 14rpx 100%; font-size: 20rpx; font-weight: 750; }
.file-card-mark text { padding: 0 4rpx; background: #FFFFFF; }
.file-card.failed .file-card-mark { border-color: #B94C3A; color: #A83F32; background-image: none; }
.file-card-copy { flex: 1; min-width: 0; }
.file-card-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #17231E; font-size: 25rpx; font-weight: 700; }
.file-card-meta { margin-top: 4rpx; color: #5F6E68; font-size: 21rpx; line-height: 1.5; }
.file-card-error { margin-top: 4rpx; color: #A83F32; font-size: 21rpx; }
.file-card-actions { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.file-card-action { min-width: 96rpx; min-height: 58rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 10rpx; color: #FFFFFF; background: #247052; font-size: 23rpx; font-weight: 700; }
.file-card-action.secondary { color: #247052; background: #FFFFFF; border: 1rpx solid #CFE0D6; }
.file-card-action.danger { color: #A83F32; background: #FCE9E4; }
.message-retry { min-height: 72rpx; margin-top: 16rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #245E9B; background: #E8F0F7; font-size: 26rpx; font-weight: 700; }

/* 附件：输入区里待发送的附件，以及消息里已发送的附件 */
.message-attachments { margin-bottom: 10rpx; }
.attachment-card { display: flex; align-items: center; gap: 14rpx; min-height: 70rpx; padding: 10rpx 12rpx; box-sizing: border-box; border: 1rpx solid #D8E0DC; border-radius: 14rpx; background: #F5F8F7; }
.attachment-card + .attachment-card { margin-top: 8rpx; }
.attachment-card.sent { margin-bottom: 12rpx; color: #FFFFFF; background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.3); }
.attachment-icon { width: 48rpx; height: 48rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #245E9B; background: #E8F0F7; font-size: 20rpx; font-weight: 700; }
.attachment-card.sent .attachment-icon { background: #FFFFFF; }
.attachment-copy { flex: 1; min-width: 0; }
.attachment-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: inherit; font-size: 23rpx; font-weight: 650; }
.attachment-meta { margin-top: 3rpx; color: #6C7873; font-size: 20rpx; }
.attachment-card.sent .attachment-meta { color: rgba(255,255,255,.82); }
.attachment-meta.waiting { color: #A83F32; white-space: normal; }
.attachment-actions { flex: 0 0 auto; display: flex; align-items: center; gap: 4rpx; }
.attachment-save { min-height: 60rpx; padding: 0 10rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; color: #245E9B; background: #E8F0F7; font-size: 20rpx; white-space: nowrap; }
.attachment-save:active { opacity: .72; }
.attachment-remove { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; color: #6C7873; font-size: 34rpx; line-height: 1; }
.uploading-line { padding: 10rpx 4rpx 0; color: #6C7873; font-size: 21rpx; }

/* 运行中与网络提示 */
.run-progress { margin: 24rpx 28rpx; padding: 22rpx; border-left: 7rpx solid #245E9B; border-radius: 0 16rpx 16rpx 0; background: #FFFFFF; }
.run-progress-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.run-progress-title { color: #17231E; font-size: 30rpx; font-weight: 700; }
.run-progress-stage { margin-top: 5rpx; color: #52605A; font-size: 25rpx; }
.run-progress-track { height: 10rpx; margin-top: 20rpx; overflow: hidden; border-radius: 10rpx; background: #DCE3DF; }
.run-progress-track view { min-width: 12%; height: 100%; background: #245E9B; animation: agent-progress 1.35s ease-in-out infinite alternate; }
.run-progress-track view.determinate { min-width: 0; animation: none; transform: none; }
@keyframes agent-progress { from { transform: translateX(-18%); } to { transform: translateX(182%); } }
.run-progress-count { margin-top: 12rpx; color: #40504A; font-size: 23rpx; font-weight: 650; }
.run-progress-note { margin-top: 16rpx; color: #52605A; font-size: 24rpx; line-height: 1.6; }
.run-progress-actions { margin-top: 16rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.run-progress-action { min-height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #245E9B; background: #E8F0F7; font-size: 27rpx; font-weight: 700; }
.run-progress-action.secondary { color: #A83F32; background: #FCE9E4; }
.network-state { margin: 20rpx 28rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-left: 7rpx solid #B94C3A; border-radius: 0 16rpx 16rpx 0; background: #FCE9E4; }
.network-title { color: #A83F32; font-size: 28rpx; font-weight: 700; }
.network-desc { margin-top: 4rpx; color: #73483E; font-size: 24rpx; }
.network-retry { min-height: 72rpx; padding: 0 18rpx; display: flex; align-items: center; flex: 0 0 auto; border-radius: 12rpx; color: #FFFFFF; background: #A83F32; font-size: 26rpx; font-weight: 700; }

/* 确认卡 */
.approval-sheet { position: relative; margin: 18rpx 28rpx 34rpx; overflow: hidden; border: 1rpx solid #D6DEDA; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 10rpx 34rpx rgba(23, 42, 34, .08); }
.approval-topline { height: 7rpx; background: #245E9B; }
.high-risk .approval-topline { background: #B94C3A; }
.approval-head { display: flex; align-items: flex-start; gap: 18rpx; padding: 24rpx; border-bottom: 1rpx solid #E4E9E6; }
.approval-heading { flex: 1; min-width: 0; }
.approval-title { color: #17231E; font-size: 31rpx; font-weight: 700; }
.approval-description { margin-top: 8rpx; color: #6C7873; font-size: 22rpx; line-height: 1.55; }
.risk-badge { flex-shrink: 0; padding: 7rpx 12rpx; border-radius: 10rpx; color: #247052; background: #E3F2E9; font-size: 20rpx; font-weight: 700; }
.high-risk .risk-badge { color: #A83F32; background: #FCE9E4; }
.workbook-preview { padding: 12rpx 24rpx 10rpx; border-bottom: 1rpx solid #E4E9E6; }
.workbook-sheet { margin: 14rpx 0; padding: 14rpx 16rpx; border-radius: 12rpx; background: #F3F6F4; }
.workbook-sheet-head { display: flex; justify-content: space-between; gap: 16rpx; font-size: 24rpx; }
.workbook-sheet-name { flex: 1; min-width: 0; color: #17231E; font-weight: 700; }
.workbook-sheet-meta { flex: 0 0 auto; color: #6C7873; }
.workbook-mismatch { color: #A83F32; font-weight: 700; }
.workbook-columns { margin-top: 8rpx; color: #40504A; font-size: 22rpx; line-height: 1.5; }
.workbook-sample { margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #6C7873; font-size: 21rpx; }
.workbook-sample.more { color: #8A948F; }
.workbook-warning { margin-top: 8rpx; padding: 10rpx 14rpx; border-radius: 10rpx; color: #84372C; background: #FCEBE6; font-size: 22rpx; line-height: 1.5; }
.customer-line { display: flex; justify-content: space-between; padding: 20rpx 24rpx; color: #6C7873; font-size: 24rpx; border-bottom: 1rpx solid #E4E9E6; }
.customer-name { color: #17231E; font-weight: 700; }
.operation-preview { padding: 12rpx 24rpx; border-bottom: 1rpx solid #E4E9E6; }
.operation-row { display: flex; justify-content: space-between; gap: 28rpx; padding: 8rpx 0; color: #6C7873; font-size: 23rpx; }
.operation-value { max-width: 70%; color: #17231E; font-weight: 650; text-align: right; word-break: break-all; }
.amount-grid { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1rpx solid #E4E9E6; }
.amount-cell { display: flex; flex-direction: column; padding: 20rpx 24rpx; color: #6C7873; font-size: 21rpx; border-right: 1rpx solid #E4E9E6; border-bottom: 1rpx solid #E4E9E6; }
.amount-cell:nth-child(2n) { border-right: 0; }
.amount-cell:nth-last-child(-n+2) { border-bottom: 0; }
.amount-value { margin-top: 6rpx; color: #17231E; font-size: 30rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.amount-cell.debt .amount-value { color: #A83F32; }
.approval-items { padding: 8rpx 24rpx; border-bottom: 1rpx solid #E4E9E6; }
.approval-item { display: flex; justify-content: space-between; gap: 18rpx; align-items: center; padding: 17rpx 0; border-bottom: 1rpx solid #EEF1EF; }
.approval-item:last-child { border-bottom: 0; }
.item-name { color: #17231E; font-size: 25rpx; font-weight: 700; }
.item-meta { margin-top: 4rpx; color: #6C7873; font-size: 21rpx; }
.item-amount { color: #17231E; font-size: 25rpx; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
.effect-note { margin: 20rpx 24rpx 0; padding: 16rpx 18rpx; border-radius: 12rpx; color: #3D5D50; background: #E3F2E9; font-size: 22rpx; line-height: 1.55; }
.impact-detail { margin: 16rpx 24rpx 0; padding: 16rpx 18rpx; border-radius: 12rpx; color: #40504A; background: #F3F6F4; font-size: 22rpx; line-height: 1.6; }
.impact-detail > view { margin-top: 10rpx; }
.impact-detail > view:first-child { margin-top: 0; }
.impact-detail text { display: block; margin-bottom: 3rpx; color: #17231E; font-weight: 700; }
.impact-warning { color: #84372C; }
.stock-warning { margin: 16rpx 24rpx 0; padding: 14rpx 18rpx; border-radius: 12rpx; color: #A83F32; background: #FCE9E4; font-size: 22rpx; font-weight: 700; }
.approval-actions { display: flex; gap: 14rpx; padding: 24rpx; }
.approval-button { flex: 1; height: 86rpx; margin: 0; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; font-size: 27rpx; font-weight: 700; }
.approval-button::after { border: 0; }
.approval-button.cancel { color: #40504A; background: #ECEFED; }
.approval-button.confirm { color: #FFFFFF; background: #245E9B; }
.high-risk .approval-button.confirm { background: #B94C3A; }
.approval-button[disabled] { opacity: .45; }
.billing-draft-preview { margin: 18rpx 24rpx 0; overflow: hidden; border: 1rpx solid #CFD9D4; border-radius: 16rpx; background: #FFFFFF; }
.billing-draft-head { min-height: 118rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #DFE5E2; background: #F6F8F7; box-sizing: border-box; }
.billing-draft-kicker { color: #247052; font-size: 20rpx; font-weight: 700; }
.billing-draft-title { margin-top: 4rpx; color: #17231E; font-size: 29rpx; line-height: 1.35; font-weight: 750; }
.billing-draft-total { flex: 0 0 auto; text-align: right; }
.billing-draft-total text { display: block; color: #68756F; font-size: 19rpx; }
.billing-draft-total-value { display: block; margin-top: 3rpx; color: #17231E; font-size: 30rpx; font-weight: 760; font-variant-numeric: tabular-nums; }
.billing-draft-meta { min-height: 62rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 18rpx; color: #68756F; font-size: 20rpx; border-bottom: 1rpx solid #E7ECE9; }
.billing-draft-meta text:last-child { color: #9A5D10; }
.billing-draft-lines { max-height: 360rpx; overflow-y: auto; }
.billing-draft-line { min-height: 86rpx; padding: 13rpx 18rpx; display: flex; align-items: center; gap: 13rpx; border-bottom: 1rpx solid #EDF0EE; box-sizing: border-box; }
.billing-draft-line:last-child { border-bottom: 0; }
.billing-line-index { width: 34rpx; flex: 0 0 34rpx; color: #8A9690; font-size: 20rpx; text-align: center; }
.billing-line-main { min-width: 0; flex: 1; }
.billing-line-name { color: #17231E; font-size: 24rpx; line-height: 1.35; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.billing-line-meta { margin-top: 4rpx; color: #68756F; font-size: 19rpx; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.billing-line-amount { flex: 0 0 auto; color: #17231E; font-size: 23rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.billing-draft-tip { padding: 16rpx 20rpx; color: #4B5D55; background: #E8F3ED; font-size: 20rpx; line-height: 1.55; }

/* 结果区 */
.result-sheet { margin: 18rpx 28rpx 34rpx; padding: 24rpx; border-left: 7rpx solid #247052; border-radius: 0 16rpx 16rpx 0; background: #E3F2E9; }
.result-sheet.tone-danger { border-left-color: #B94C3A; background: #FCE9E4; }
.result-sheet.tone-warning { border-left-color: #B87418; background: #FFF0D5; }
.result-sheet.tone-neutral, .result-sheet.tone-info { border-left-color: #6C7873; background: #ECEFED; }
.result-status { color: #1F6245; font-size: 23rpx; font-weight: 800; }
.result-sheet.tone-danger .result-status { color: #A83F32; }
.result-sheet.tone-warning .result-status { color: #8A560E; }
.result-sheet.tone-neutral .result-status, .result-sheet.tone-info .result-status { color: #40504A; }
.result-copy { margin-top: 8rpx; color: #34413C; font-size: 25rpx; line-height: 1.65; }
.result-summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 16rpx; border-top: 1rpx solid #D3DED8; border-bottom: 1rpx solid #D3DED8; }
.result-summary-grid view { min-height: 92rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1rpx solid #D3DED8; }
.result-summary-grid view:last-child { border-right: 0; }
.result-summary-grid text:first-child { color: #247052; font-size: 31rpx; font-weight: 750; font-variant-numeric: tabular-nums; }
.result-summary-grid text:last-child { color: #6C7873; font-size: 20rpx; }
.result-summary-grid .danger text:first-child { color: #B94C3A; }
.result-actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.result-actions view { min-height: 72rpx; padding: 0 18rpx; display: flex; align-items: center; border-radius: 12rpx; color: #245E9B; background: #FFFFFF; font-size: 25rpx; font-weight: 700; }
.billing-message-action { min-height: 74rpx; margin-top: 16rpx; padding: 0 17rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid #BFD2C8; border-radius: 13rpx; color: #1F6548; background: #E6F2EB; font-size: 24rpx; font-weight: 700; }
.billing-message-action text:last-child { font-size: 32rpx; font-weight: 400; }

/* 输入区 */
.composer { position: relative; z-index: 10; flex: 0 0 auto; padding: 10rpx 16rpx calc(10rpx + env(safe-area-inset-bottom)); background: rgba(243, 245, 242, .97); border-top: 1rpx solid #D9E0DC; }
.attachment-backdrop { position: fixed; z-index: 9; top: 0; right: 0; bottom: 0; left: 0; background: rgba(18, 27, 23, .18); }
.attachment-menu { margin: 0 0 14rpx; padding: 24rpx 22rpx 20rpx; border: 1rpx solid #D5DDDA; border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 -12rpx 44rpx rgba(23, 35, 30, .12); }
.attachment-menu-title { color: #17231E; font-size: 25rpx; font-weight: 700; }
.attachment-menu-grid { margin-top: 20rpx; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.attachment-option { min-height: 132rpx; padding: 12rpx 4rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; border-radius: 16rpx; color: #34413C; background: #F3F6F4; font-size: 21rpx; }
.attachment-option:active { color: #245E9B; background: #E8F0F7; }
.attachment-option-icon { width: 58rpx; height: 58rpx; position: relative; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; color: #245E9B; background: #FFFFFF; box-shadow: 0 3rpx 12rpx rgba(32, 55, 45, .08); }
.attachment-option-icon > view { position: absolute; box-sizing: border-box; }
.attachment-option-icon.camera > view { width: 38rpx; height: 28rpx; border: 3rpx solid #245E9B; border-radius: 7rpx; }
.attachment-option-icon.camera > view::before { content: ''; position: absolute; width: 12rpx; height: 7rpx; left: 4rpx; top: -8rpx; border-radius: 3rpx 3rpx 0 0; background: #245E9B; }
.attachment-option-icon.camera > view::after { content: ''; position: absolute; width: 10rpx; height: 10rpx; left: 11rpx; top: 6rpx; border: 3rpx solid #245E9B; border-radius: 50%; }
.attachment-option-icon.album > view { width: 38rpx; height: 34rpx; border: 3rpx solid #245E9B; border-radius: 5rpx; transform: rotate(-3deg); }
.attachment-option-icon.album > view::before { content: ''; position: absolute; width: 8rpx; height: 8rpx; right: 5rpx; top: 5rpx; border-radius: 50%; background: #245E9B; }
.attachment-option-icon.album > view::after { content: ''; position: absolute; width: 19rpx; height: 19rpx; left: 6rpx; bottom: 0; border-left: 3rpx solid #245E9B; border-top: 3rpx solid #245E9B; transform: rotate(45deg); }
.attachment-option-icon.document > view, .attachment-option-icon.excel > view { width: 32rpx; height: 40rpx; border: 3rpx solid #245E9B; border-radius: 4rpx; }
.attachment-option-icon.document > view::before { content: ''; position: absolute; left: 6rpx; right: 6rpx; top: 11rpx; height: 3rpx; background: #245E9B; box-shadow: 0 8rpx 0 #245E9B, 0 16rpx 0 #245E9B; }
.attachment-option-icon.excel > view { border-color: #247052; }
.attachment-option-icon.excel > view::before { content: ''; position: absolute; inset: 6rpx; background-image: linear-gradient(#247052 2rpx, transparent 2rpx), linear-gradient(90deg, #247052 2rpx, transparent 2rpx); background-size: 100% 8rpx, 8rpx 100%; }
.attachment-menu-note { margin-top: 18rpx; color: #68756F; font-size: 20rpx; line-height: 1.55; }
.composer-attachments { margin: 0 4rpx 10rpx; }
.composer-row { min-height: 80rpx; padding: 6rpx; display: flex; align-items: center; gap: 7rpx; border: 2rpx solid #D5DDDA; border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(34, 55, 45, .055); }
.composer-row:focus-within { border-color: #245E9B; }
.attach-button { width: 68rpx; height: 68rpx; flex: 0 0 auto; position: relative; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; color: #245E9B; background: #E8F0F7; }
.attach-button > view { position: absolute; width: 28rpx; height: 3rpx; border-radius: 3rpx; background: currentColor; transition: transform .16s ease; }
.attach-button > view:last-child { transform: rotate(90deg); }
.attach-button:active { background: #D8E5F0; }
.attach-button.active { color: #FFFFFF; background: #245E9B; }
.attach-button.active > view:first-child { transform: rotate(45deg); }
.attach-button.active > view:last-child { transform: rotate(-45deg); }
.composer-input { flex: 1; box-sizing: border-box; min-height: 68rpx; max-height: 190rpx; padding: 17rpx 8rpx 9rpx; color: #17231E; background: transparent; font-size: 27rpx; line-height: 42rpx; }
.send-hit { width: 68rpx; height: 68rpx; flex: 0 0 68rpx; display: flex; align-items: center; justify-content: center; }
.send-button { width: 50rpx; height: 50rpx; position: relative; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #FFFFFF; background: #245E9B; }
.send-button.disabled { color: #9BA49F; background: #E7EBE9; }
.send-glyph { width: 19rpx; height: 19rpx; position: relative; border-top: 4rpx solid currentColor; border-right: 4rpx solid currentColor; transform: rotate(-45deg) translate(-2rpx, 2rpx); }
.send-glyph::after { content: ''; position: absolute; width: 4rpx; height: 24rpx; top: -4rpx; right: 5rpx; border-radius: 4rpx; background: currentColor; }

@media (max-width: 340px) {
  .welcome { padding-left: 22rpx; padding-right: 22rpx; }
  .welcome-title { font-size: 40rpx; }
  .core-actions { gap: 10rpx; }
  .core-action { min-height: 120rpx; padding: 15rpx 13rpx; gap: 10rpx; }
  .core-action-title { font-size: 26rpx; }
  .core-action-desc { font-size: 20rpx; }
  .attachment-menu-grid { grid-template-columns: repeat(2, 1fr); }
  .attachment-option { min-height: 106rpx; }
  .attach-button { width: 64rpx; height: 64rpx; }
  .send-hit { width: 64rpx; height: 64rpx; flex-basis: 64rpx; }
  .history-list-scroll { height: 420rpx; }
}
