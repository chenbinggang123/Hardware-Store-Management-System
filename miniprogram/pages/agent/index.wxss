.agent-screen { min-height: 100vh; box-sizing: border-box; padding: 28rpx 24rpx 0; background: #F5EFE6; }
.agent-header { display: flex; align-items: center; gap: 18rpx; }
.agent-mark { width: 76rpx; height: 76rpx; border-radius: 22rpx 10rpx 22rpx 10rpx; display: flex; align-items: center; justify-content: center; background: #2F2416; color: #FFF8EF; font-size: 30rpx; font-weight: 800; box-shadow: 6rpx 8rpx 0 #D89A68; }
.agent-heading { flex: 1; min-width: 0; }
.agent-title { font-size: 38rpx; line-height: 1.2; font-weight: 800; color: #1A1410; }
.agent-subtitle { margin-top: 6rpx; color: #7C6B5A; font-size: 22rpx; }
.new-task { color: #B75A1A; font-size: 24rpx; font-weight: 700; padding: 14rpx 0 14rpx 18rpx; }
.trust-strip { margin-top: 26rpx; padding: 16rpx 20rpx; background: #E9E0D4; color: #5C4A38; font-size: 21rpx; border-left: 6rpx solid #B75A1A; }
.trust-dot { padding: 0 10rpx; color: #B99C80; }
.suggestions { margin-top: 44rpx; }
.suggestion-title { color: #5C4A38; font-size: 24rpx; font-weight: 700; margin-bottom: 16rpx; }
.suggestion { margin-top: 12rpx; padding: 22rpx 24rpx; background: rgba(255, 252, 247, 0.82); border-bottom: 1rpx solid #D9CCBD; color: #3D3025; font-size: 26rpx; }
.conversation { margin-top: 28rpx; }
.message-row { display: flex; margin: 16rpx 0; }
.message-row.user { justify-content: flex-end; }
.message { max-width: 78%; padding: 20rpx 24rpx; font-size: 26rpx; line-height: 1.65; box-sizing: border-box; }
.user .message { background: #2F2416; color: #FFF8EF; border-radius: 22rpx 22rpx 6rpx 22rpx; }
.assistant .message { background: #FFFCF7; color: #3D3025; border-radius: 6rpx 22rpx 22rpx 22rpx; border: 1rpx solid #E2D6C8; }
.error .message { max-width: 100%; background: #F8E4DA; color: #973F1B; border-left: 6rpx solid #BF4F1C; }
.thinking { color: #8C7964 !important; }
.approval-sheet { position: relative; margin-top: 28rpx; background: #FFFCF7; border: 1rpx solid #D8C5AF; box-shadow: 0 14rpx 40rpx rgba(78, 55, 25, .12); overflow: hidden; }
.approval-topline { height: 8rpx; background: #B75A1A; }
.high-risk .approval-topline { background: #BF4F1C; }
.approval-head { display: flex; align-items: flex-start; gap: 18rpx; padding: 26rpx 24rpx 22rpx; border-bottom: 1rpx dashed #D6C7B6; }
.approval-heading { flex: 1; min-width: 0; }
.approval-title { color: #1A1410; font-size: 31rpx; font-weight: 800; }
.approval-description { margin-top: 8rpx; color: #7C6B5A; font-size: 22rpx; line-height: 1.55; }
.risk-badge { flex-shrink: 0; padding: 7rpx 12rpx; background: #F5E4D6; color: #A64D15; font-size: 20rpx; font-weight: 700; }
.high-risk .risk-badge { background: #F7DED4; color: #A33D14; }
.customer-line { display: flex; justify-content: space-between; padding: 20rpx 24rpx; color: #8C7964; font-size: 24rpx; border-bottom: 1rpx dashed #D6C7B6; }
.customer-name { color: #1A1410; font-weight: 700; }
.amount-grid { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1rpx dashed #D6C7B6; }
.amount-cell { display: flex; flex-direction: column; padding: 20rpx 24rpx; color: #8C7964; font-size: 21rpx; border-right: 1rpx solid #E7DED3; border-bottom: 1rpx solid #E7DED3; }
.amount-cell:nth-child(2n) { border-right: 0; }
.amount-cell:nth-last-child(-n+2) { border-bottom: 0; }
.amount-value { margin-top: 6rpx; color: #1A1410; font-size: 30rpx; font-weight: 800; }
.amount-cell.debt .amount-value { color: #A33D14; }
.approval-items { padding: 8rpx 24rpx; border-bottom: 1rpx dashed #D6C7B6; }
.approval-item { display: flex; justify-content: space-between; gap: 18rpx; align-items: center; padding: 17rpx 0; border-bottom: 1rpx solid #EEE5DA; }
.approval-item:last-child { border-bottom: 0; }
.item-name { color: #2F2416; font-size: 25rpx; font-weight: 700; }
.item-meta { margin-top: 4rpx; color: #8C7964; font-size: 21rpx; }
.item-amount { color: #2F2416; font-size: 25rpx; font-weight: 800; white-space: nowrap; }
.effect-note { margin: 20rpx 24rpx 0; padding: 16rpx 18rpx; background: #F0EAE2; color: #5C4A38; font-size: 22rpx; line-height: 1.55; }
.stock-warning { margin: 16rpx 24rpx 0; padding: 14rpx 18rpx; background: #F8E4DA; color: #A33D14; font-size: 22rpx; font-weight: 700; }
.approval-actions { display: flex; gap: 14rpx; padding: 24rpx; }
.approval-button { flex: 1; height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; font-size: 26rpx; font-weight: 700; }
.approval-button::after { border: 0; }
.approval-button.cancel { background: #EEE6DC; color: #5C4A38; }
.approval-button.confirm { background: #B75A1A; color: #FFF; }
.high-risk .approval-button.confirm { background: #A33D14; }
.approval-button[disabled] { opacity: .45; }
.result-sheet { margin-top: 26rpx; padding: 24rpx; background: #E5F0E9; border-left: 6rpx solid #29714C; }
.result-status { color: #1D5C38; font-size: 23rpx; font-weight: 800; }
.result-copy { margin-top: 8rpx; color: #294737; font-size: 25rpx; line-height: 1.65; }
.composer-space { height: 190rpx; }
.composer { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; display: flex; align-items: flex-end; gap: 14rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 252, 247, .98); border-top: 1rpx solid #D8CABB; }
.composer-input { flex: 1; box-sizing: border-box; min-height: 76rpx; max-height: 180rpx; padding: 18rpx 20rpx; border: 1rpx solid #D4C4B1; background: #F8F3EC; color: #2F2416; border-radius: 16rpx; font-size: 25rpx; line-height: 1.55; }
.send-button { width: 116rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #2F2416; color: #FFF8EF; font-size: 25rpx; font-weight: 700; padding: 0; }
.send-button::after { border: 0; }
.send-button[disabled] { background: #B7AA9B; color: #EEE8E0; }

/* Family-first Agent UI */
.agent-screen { min-height: 100vh; padding: 22rpx 28rpx 0; background: #F5F7F6; }
.agent-header { min-height: 86rpx; gap: 16rpx; }
.agent-mark { width: 68rpx; height: 68rpx; border-radius: 21rpx 21rpx 21rpx 7rpx; color: #FFFFFF; background: #2865D7; font-size: 24rpx; font-weight: 700; box-shadow: none; }
.agent-title { color: #182126; font-size: 39rpx; font-weight: 700; }
.agent-subtitle { margin-top: 4rpx; display: flex; align-items: center; gap: 12rpx; color: #74807B; font-size: 23rpx; }
.agent-live { display: inline-flex; align-items: center; gap: 7rpx; color: #247A55; font-size: 19rpx; font-weight: 700; white-space: nowrap; }
.agent-live-dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #247A55; }
.new-task { min-height: 60rpx; padding: 10rpx 0 10rpx 18rpx; display: flex; align-items: center; color: #2865D7; font-size: 24rpx; }
.trust-strip { margin-top: 22rpx; padding: 17rpx 20rpx; border: 0; border-radius: 16rpx; color: #53615B; background: #E8EEEB; font-size: 22rpx; }
.trust-dot { padding: 0 10rpx; color: #8A9691; }
.suggestions { margin-top: 38rpx; }
.suggestion-title { margin-bottom: 12rpx; color: #3B4843; font-size: 27rpx; }
.suggestion { min-height: 92rpx; margin-top: 10rpx; padding: 16rpx 18rpx; display: flex; align-items: center; gap: 14rpx; border: 1rpx solid #DCE2DF; border-radius: 18rpx; color: #34413C; background: #FFFFFF; font-size: 27rpx; }
.suggestion-mark { width: 48rpx; height: 48rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; color: #2865D7; background: #EAF1FF; font-size: 19rpx; font-weight: 700; }
.suggestion-copy { flex: 1; min-width: 0; }
.suggestion-arrow { color: #8A9590; font-size: 33rpx; line-height: 1; }
.conversation { margin-top: 24rpx; }
.message-row { margin: 14rpx 0; }
.message { max-width: 84%; padding: 20rpx 22rpx; font-size: 27rpx; line-height: 1.65; }
.user .message { color: #FFFFFF; background: #2865D7; border-radius: 20rpx 20rpx 6rpx 20rpx; }
.assistant .message { color: #2E3B36; background: #FFFFFF; border: 1rpx solid #DCE2DF; border-radius: 6rpx 20rpx 20rpx 20rpx; }
.error .message { background: #FCEAE5; color: #A7432E; border-left: 6rpx solid #B95034; }
.thinking { color: #74807B !important; }
.approval-sheet { margin-top: 24rpx; border: 1rpx solid #D6DEDA; border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 12rpx 34rpx rgba(28,48,41,.08); }
.approval-topline { height: 7rpx; background: #2865D7; }
.high-risk .approval-topline { background: #B95034; }
.approval-head { padding: 24rpx; border-bottom: 1rpx solid #E2E7E4; }
.approval-title { color: #182126; font-size: 31rpx; }
.approval-description { color: #68756F; }
.risk-badge { border-radius: 10rpx; color: #245ABF; background: #EAF1FF; }
.high-risk .risk-badge { color: #A7432E; background: #FCEAE5; }
.customer-line { color: #74807B; border-color: #E2E7E4; }
.customer-name, .amount-value, .item-name, .item-amount { color: #182126; }
.amount-grid, .approval-items { border-color: #E2E7E4; }
.amount-cell { color: #74807B; border-color: #E2E7E4; }
.amount-cell.debt .amount-value { color: #B95034; }
.approval-item { border-color: #E5EAE7; }
.item-meta { color: #74807B; }
.effect-note { color: #53615B; background: #EDF1EF; }
.stock-warning { color: #A7432E; background: #FCEAE5; }
.approval-button { height: 86rpx; border-radius: 16rpx; font-size: 27rpx; }
.approval-button.cancel { color: #40504A; background: #EDF1EF; }
.approval-button.confirm { color: #FFFFFF; background: #2865D7; }
.high-risk .approval-button.confirm { background: #B95034; }
.result-sheet { border-left: 6rpx solid #247A55; border-radius: 16rpx; background: #E4F2EA; }
.result-status { color: #21694A; }
.result-copy { color: #355046; }
.composer-space { height: 190rpx; }
.composer { gap: 12rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.98); border-top: 1rpx solid #D7DFDB; }
.composer-input { min-height: 80rpx; padding: 18rpx 20rpx; border: 2rpx solid #D6DEDA; border-radius: 18rpx; color: #182126; background: #F5F7F6; font-size: 27rpx; }
.send-button { width: 116rpx; height: 80rpx; border-radius: 18rpx; color: #FFFFFF; background: #2865D7; font-size: 26rpx; }
.send-button[disabled] { color: #9BA5A1; background: #E2E7E4; }

/* Agent answers: readable prose first, structured business facts second. */
.message { overflow-wrap: anywhere; word-break: break-word; }
.assistant .message-stack { width: 92%; }
.assistant-author { margin: 0 0 8rpx 8rpx; color: #73817B; font-size: 21rpx; font-weight: 600; }
.assistant .message {
  max-width: none;
  padding: 26rpx 26rpx 28rpx;
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.78;
  box-shadow: 0 6rpx 20rpx rgba(31, 54, 45, .045);
}
.answer-paragraph + .answer-paragraph { margin-top: 18rpx; }
.answer-field { display: flex; align-items: flex-start; gap: 18rpx; padding: 14rpx 0; border-bottom: 1rpx solid #E8ECEA; }
.answer-field:last-child { border-bottom: 0; }
.answer-field-label { width: 116rpx; flex: 0 0 auto; color: #73817B; font-size: 24rpx; }
.answer-field-value { flex: 1; min-width: 0; color: #24322D; font-weight: 600; }
.product-result { margin: 18rpx 0; padding: 20rpx 20rpx 18rpx; border-left: 6rpx solid #2865D7; border-radius: 0 16rpx 16rpx 0; background: #F3F7FF; }
.product-result:first-child { margin-top: 0; }
.product-result:last-child { margin-bottom: 0; }
.product-result-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.product-result-name { flex: 1; min-width: 0; color: #17231F; font-size: 29rpx; font-weight: 700; line-height: 1.4; }
.product-result-price { flex: 0 0 auto; color: #2159C1; font-size: 29rpx; font-weight: 700; }
.product-result-meta { margin-top: 8rpx; color: #52615B; font-size: 24rpx; }
.product-result-id { margin-top: 12rpx; color: #84908B; font-size: 21rpx; }

/* Conversation history behaves like a compact shop ledger, not a permanent sidebar. */
.header-actions { display: flex; align-items: center; gap: 20rpx; }
.history-button, .new-task { min-height: 58rpx; padding: 8rpx 0; display: flex; align-items: center; color: #2865D7; font-size: 24rpx; font-weight: 700; }
.history-backdrop { position: fixed; z-index: 30; inset: 0; background: rgba(20, 31, 27, .34); }
.history-drawer { position: fixed; z-index: 31; left: 0; right: 0; bottom: 0; height: 72vh; box-sizing: border-box; padding: 14rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #F8FAF9; transform: translateY(105%); transition: transform .22s ease-out; box-shadow: 0 -20rpx 60rpx rgba(23, 42, 34, .16); }
.history-drawer.open { transform: translateY(0); }
.history-handle { width: 72rpx; height: 7rpx; margin: 0 auto 22rpx; border-radius: 8rpx; background: #CBD4D0; }
.history-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid #DCE3DF; }
.history-title { color: #18231F; font-size: 34rpx; font-weight: 750; }
.history-subtitle { margin-top: 6rpx; color: #77837E; font-size: 22rpx; }
.history-close { padding: 8rpx 0 12rpx 20rpx; color: #2865D7; font-size: 24rpx; }
.history-list { height: calc(72vh - 230rpx); }
.history-entry { padding: 24rpx 4rpx; border-bottom: 1rpx solid #E1E7E4; }
.history-entry.active { padding-left: 18rpx; border-left: 6rpx solid #2865D7; background: linear-gradient(90deg, #EDF3FF 0, rgba(237,243,255,0) 78%); }
.history-entry-top { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.history-entry-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #26342F; font-size: 27rpx; font-weight: 650; }
.history-entry-time { flex: 0 0 auto; color: #929C98; font-size: 20rpx; }
.history-entry-preview { margin-top: 9rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #697670; font-size: 23rpx; }
.history-loading, .history-empty { padding: 80rpx 20rpx; text-align: center; color: #7A8781; font-size: 25rpx; line-height: 1.8; }
.history-empty text { color: #9AA39F; font-size: 22rpx; }
.history-new { height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #FFFFFF; background: #2865D7; font-size: 26rpx; font-weight: 700; }

/* Attachments stay compact in the composer and remain visible in conversation history. */
.composer { display: block; }
.composer-row { display: flex; align-items: flex-end; gap: 12rpx; }
.composer-attachments { margin-bottom: 12rpx; }
.attach-button { width: 70rpx; height: 80rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #C9D3CE; border-radius: 18rpx; color: #2865D7; background: #F5F7F6; font-size: 40rpx; line-height: 1; }
.attachment-card { display: flex; align-items: center; gap: 14rpx; min-height: 70rpx; padding: 10rpx 12rpx; box-sizing: border-box; border: 1rpx solid #D8E0DC; border-radius: 14rpx; background: #F5F8F7; }
.attachment-card + .attachment-card { margin-top: 8rpx; }
.attachment-card.sent { margin-bottom: 12rpx; color: #2E3B36; background: rgba(255,255,255,.94); border-color: rgba(255,255,255,.5); }
.attachment-icon { width: 48rpx; height: 48rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #245ABF; background: #E5EEFF; font-size: 20rpx; font-weight: 700; }
.attachment-copy { flex: 1; min-width: 0; }
.attachment-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: inherit; font-size: 23rpx; font-weight: 650; }
.attachment-meta { margin-top: 3rpx; color: #74807B; font-size: 20rpx; }
.attachment-meta.waiting { color: #A7432E; white-space: normal; }
.attachment-remove { padding: 10rpx; color: #83908A; font-size: 32rpx; line-height: 1; }
.uploading-line { padding: 10rpx 4rpx 0; color: #66746E; font-size: 21rpx; }
.message-attachments { margin-bottom: 10rpx; }
.composer-space { height: 260rpx; }
