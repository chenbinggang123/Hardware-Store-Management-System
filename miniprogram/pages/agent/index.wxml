<view class="agent-screen">
  <view class="agent-header">
    <view class="icon-button menu-button" role="button" aria-label="打开会话列表" bindtap="openHistory">
      <view class="menu-line"></view><view class="menu-line"></view><view class="menu-line short"></view>
    </view>
    <view class="agent-heading">
      <view class="agent-title">{{currentTitle}}</view>
      <view class="agent-subtitle" wx:if="{{streaming}}"><text class="stream-dot"></text>小五正在回复</view>
      <view class="agent-subtitle" wx:else>小五 · 经营助手</view>
    </view>
    <view class="icon-button compose-button" role="button" aria-label="开始新对话" bindtap="startNew">
      <view class="compose-square"></view><view class="compose-stroke"></view>
    </view>
  </view>

  <view class="history-backdrop" wx:if="{{historyOpen}}" bindtap="closeHistory"></view>
  <view class="history-drawer {{historyOpen ? 'open' : ''}}" catchtap="preventClose">
    <view class="history-head">
      <view class="drawer-brand"><view class="drawer-mark">小</view><view><view class="history-title">小五</view><view class="history-subtitle">经营助手</view></view></view>
      <view class="history-close" role="button" aria-label="关闭会话列表" bindtap="closeHistory">×</view>
    </view>
    <view class="history-new" role="button" aria-label="开始新对话" bindtap="startNew"><text class="history-new-icon">＋</text><text>新对话</text></view>
    <view class="history-section-label">最近会话</view>
    <scroll-view class="history-list" scroll-y>
      <view class="history-loading" wx:if="{{loadingHistory}}">正在读取历史…</view>
      <view class="history-empty" wx:elif="{{!conversations.length}}">还没有历史会话<br/><text>发送第一条消息后会自动保存在这里</text></view>
      <view class="history-entry {{item.id === conversationId ? 'active' : ''}}" wx:for="{{conversations}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseConversation">
        <view class="history-chat-icon">⌁</view>
        <view class="history-entry-body">
          <view class="history-entry-top">
            <text class="history-entry-title">{{item.title}}</text>
            <text class="history-entry-time">{{item.timeText}}</text>
          </view>
          <view class="history-entry-preview">{{item.preview}}</view>
        </view>
        <view class="history-entry-actions">
          <view class="history-entry-action" role="button" aria-label="修改会话标题" data-id="{{item.id}}" catchtap="renameConversation">✎</view>
          <view class="history-entry-action delete" role="button" aria-label="删除会话" data-id="{{item.id}}" catchtap="deleteConversation">{{deletingConversationId === item.id ? '…' : '×'}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="drawer-foot">正式业务操作始终需要你确认</view>
  </view>

  <scroll-view class="conversation-scroll" scroll-y scroll-into-view="{{scrollTarget}}" enhanced show-scrollbar="{{false}}">

  <view class="welcome" wx:if="{{!messages.length && !run}}">
    <view class="welcome-mark">小</view>
    <view class="welcome-title">小五可以帮你做什么？</view>
    <view class="welcome-subtitle">复杂任务我来分步骤完成；查商品、看库存仍可直接进入对应页面。</view>
    <view class="task-entry-list">
      <view class="task-entry tone-{{item.tone}}" role="button" wx:for="{{taskEntries}}" wx:key="title" data-kind="{{item.kind}}" data-prompt="{{item.prompt}}" bindtap="startTask">
        <view class="task-entry-mark">{{item.mark}}</view><view class="task-entry-copy"><view>{{item.title}}</view><text>{{item.desc}}</text></view><view class="task-entry-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="suggestions" wx:if="{{!messages.length && !run}}">
    <view class="suggestion-title">试试这样问</view>
    <view class="suggestion" role="button" wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="useSuggestion"><view class="suggestion-copy">{{item}}</view><view class="suggestion-arrow">↗</view></view>
  </view>

  <view class="conversation">
    <block wx:for="{{messages}}" wx:key="index">
      <view class="message-row {{item.role}}">
        <view class="message-stack" wx:if="{{item.role === 'assistant' || item.role === 'error'}}">
          <view class="assistant-author"><text class="assistant-dot">小</text><text>小五</text></view>
          <view class="message assistant-content">
            <view class="typing-indicator" wx:if="{{item.streaming && !item.content}}"><text></text><text></text><text></text></view>
            <block wx:elif="{{item.blocks && item.blocks.length}}">
              <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="*this">
                <view class="answer-paragraph" wx:if="{{block.type === 'text'}}">{{block.text}}</view>
                <view class="answer-field" wx:elif="{{block.type === 'field'}}">
                  <text class="answer-field-label">{{block.label}}</text>
                  <text class="answer-field-value">{{block.value}}</text>
                </view>
                <view class="product-result" wx:elif="{{block.type === 'product'}}" data-id="{{block.id}}" bindtap="openProduct">
                  <view class="product-result-head">
                    <text class="product-result-name">{{block.name}}</text>
                    <text class="product-result-price">¥{{block.price}}</text>
                  </view>
                  <view class="product-result-meta">{{block.spec}} · {{block.unit}}</view>
                  <view class="product-result-id">商品 ID {{block.id}}</view>
                </view>
              </block>
            </block>
            <view class="answer-paragraph" wx:else>{{item.content}}<text class="stream-cursor" wx:if="{{item.streaming}}"></text></view>
            <view class="message-retry" wx:if="{{item.role === 'error'}}" bindtap="retryLastMessage">重新输入并重试</view>
          </view>
        </view>
        <view class="message" wx:else>
          <view class="message-attachments" wx:if="{{item.attachments && item.attachments.length}}">
            <view class="attachment-card sent" wx:for="{{item.attachments}}" wx:for-item="file" wx:key="id">
              <view class="attachment-icon">{{file.typeText === '图片' ? '图' : '表'}}</view>
              <view class="attachment-copy"><view class="attachment-name">{{file.originalName}}</view><view class="attachment-meta">{{file.typeText}} · {{file.sizeText}}</view></view>
            </view>
          </view>
          <view>{{item.content}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="run-progress" wx:if="{{run && run.status === 'RUNNING'}}">
    <view class="run-progress-head"><view><view class="run-progress-title">小五正在处理</view><view class="run-progress-stage">{{run.stageText}}</view></view><view class="tag tag-info">处理中</view></view>
    <view class="run-progress-track"><view class="{{run.progressPercent ? 'determinate' : ''}}" style="width: {{run.progressPercent ? run.progressPercent + '%' : '38%'}};"></view></view>
    <view class="run-progress-count" wx:if="{{run.progressTotal}}">已完成 {{run.progressCompleted}} / {{run.progressTotal}}<text wx:if="{{run.issueCount}}"> · {{run.issueCount}} 个问题待确认</text></view>
    <view class="run-progress-note">{{run.canLeave ? '可以返回工作台，任务会继续处理，稍后从最近会话查看。' : '请暂时留在当前页面，完成后会立即显示结果。'}}</view>
    <view class="run-progress-actions"><view class="run-progress-action secondary" wx:if="{{run.canCancel}}" bindtap="cancelRun">{{cancelling ? '正在取消…' : '取消任务'}}</view><view class="run-progress-action" bindtap="openWorkbench">返回工作台</view></view>
  </view>
  <view class="network-state" wx:if="{{connectionInterrupted}}"><view><view class="network-title">网络连接中断</view><view class="network-desc">任务可能仍在后台处理，当前会话已经保留。</view></view><view class="network-retry" bindtap="retryConnection">重新连接</view></view>

  <view class="approval-sheet {{run.pendingAction.isHighRisk ? 'high-risk' : ''}}" wx:if="{{run && run.status === 'WAITING_APPROVAL' && run.pendingAction}}">
    <view class="approval-topline"></view>
    <view class="approval-head">
      <view class="approval-heading">
        <view class="approval-title">{{run.pendingAction.title}}</view>
        <view class="approval-description">{{run.pendingAction.description}}</view>
      </view>
      <view class="risk-badge">{{run.pendingAction.risk === 'R2_WRITE' ? '正式写入' : '草稿操作'}}</view>
    </view>
    <view class="customer-line" wx:if="{{run.pendingAction.preview.customerName}}"><text>客户</text><text class="customer-name">{{run.pendingAction.preview.customerName}}</text></view>
    <view class="operation-preview" wx:if="{{run.pendingAction.preview.productName}}">
      <view class="operation-row"><text>商品</text><text class="operation-value">{{run.pendingAction.preview.productName}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.barcode}}"><text>条码</text><text class="operation-value">{{run.pendingAction.preview.barcode}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.spec}}"><text>规格</text><text class="operation-value">{{run.pendingAction.preview.spec}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.statusText}}"><text>目标状态</text><text class="operation-value">{{run.pendingAction.preview.statusText}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.beforeQuantity !== undefined}}"><text>库存变化</text><text class="operation-value">{{run.pendingAction.preview.beforeQuantity}} → {{run.pendingAction.preview.actualQuantity}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.reason}}"><text>原因</text><text class="operation-value">{{run.pendingAction.preview.reason}}</text></view>
    </view>
    <view class="amount-grid" wx:if="{{run.pendingAction.preview.totalAmount !== undefined}}">
      <view class="amount-cell"><text>订单金额</text><text class="amount-value">¥{{run.pendingAction.preview.totalAmount}}</text></view>
      <view class="amount-cell"><text>已收金额</text><text class="amount-value">¥{{run.pendingAction.preview.receivedAmount || 0}}</text></view>
      <view class="amount-cell debt"><text>新增欠款</text><text class="amount-value">¥{{run.pendingAction.preview.newDebtAmount || 0}}</text></view>
      <view class="amount-cell debt"><text>提交后欠款</text><text class="amount-value">¥{{run.pendingAction.preview.debtAfterCommit || 0}}</text></view>
    </view>
    <view class="approval-items" wx:if="{{run.pendingAction.preview.items.length}}">
      <view class="approval-item" wx:for="{{run.pendingAction.preview.items}}" wx:key="productId">
        <view><view class="item-name">{{item.productName}}</view><view class="item-meta">{{item.quantity}} 件 × ¥{{item.price}} · 库存 {{item.availableQuantity}}</view></view>
        <view class="item-amount">¥{{item.amount}}</view>
      </view>
    </view>
    <view class="effect-note" wx:if="{{run.pendingAction.preview.effect}}">{{run.pendingAction.preview.effect}}</view>
    <view class="impact-detail" wx:if="{{run.pendingAction.impact}}">
      <view wx:if="{{run.pendingAction.impact.willChange.length}}"><text>会修改</text><view wx:for="{{run.pendingAction.impact.willChange}}" wx:key="*this">{{item}}</view></view>
      <view wx:if="{{run.pendingAction.impact.willNotChange.length}}"><text>不会修改</text><view wx:for="{{run.pendingAction.impact.willNotChange}}" wx:key="*this">{{item}}</view></view>
      <view class="impact-warning" wx:for="{{run.pendingAction.impact.warnings}}" wx:key="code">{{item.message}}</view>
    </view>
    <view class="stock-warning" wx:if="{{run.pendingAction.preview.inventorySufficient === false}}">库存不足，不能继续</view>
    <view class="approval-actions">
      <button class="approval-button cancel" bindtap="reject" disabled="{{resolving}}">取消操作</button>
      <button class="approval-button confirm" bindtap="approve" disabled="{{resolving || run.pendingAction.preview.inventorySufficient === false}}">{{resolving ? '处理中…' : '确认执行'}}</button>
    </view>
  </view>

  <view class="result-sheet tone-{{run.statusTone}}" wx:if="{{run && run.status !== 'WAITING_APPROVAL' && run.status !== 'RUNNING'}}">
    <view class="result-status">{{run.statusText}}</view><view class="result-copy">{{run.status === 'COMPLETED' ? '任务结果已显示在上方，可以继续查看对应业务页面。' : run.status === 'PARTIAL' ? '部分内容已经完成，请查看上方说明和未完成项目。' : run.status === 'FAILED' ? '本次任务没有完成，原输入和附件仍可继续使用。' : '任务已经结束，详细说明保留在当前会话中。'}}</view>
    <view class="result-summary-grid" wx:if="{{run.summary}}"><view><text>{{run.summary.successCount || 0}}</text><text>完成</text></view><view><text>{{run.summary.skippedCount || 0}}</text><text>跳过</text></view><view class="danger"><text>{{run.summary.failedCount || 0}}</text><text>失败</text></view></view>
    <view class="result-actions"><view wx:for="{{run.actions}}" wx:key="label" data-target="{{item.target}}" data-params="{{item.params}}" bindtap="openResultAction">{{item.label}}</view><view bindtap="openWorkbench">返回工作台</view><view bindtap="openFileTasks">查看文件任务</view><view wx:if="{{run.status === 'FAILED' || (run.retry && run.retry.supported)}}" bindtap="retryLastMessage">重新输入并重试</view></view>
  </view>
  <view id="conversation-end" class="conversation-end"></view>
  </scroll-view>

  <view class="composer">
    <view class="composer-attachments" wx:if="{{pendingAttachments.length || uploading}}">
      <view class="attachment-card" wx:for="{{pendingAttachments}}" wx:key="id">
        <view class="attachment-icon">{{item.typeText === '图片' ? '图' : '表'}}</view>
        <view class="attachment-copy"><view class="attachment-name">{{item.originalName}}</view><view class="attachment-meta {{item.ready ? '' : 'waiting'}}">{{item.ready ? item.sizeText + ' · 已解析' : item.errorMessage}}</view></view>
        <view class="attachment-remove" data-id="{{item.id}}" bindtap="removeAttachment">×</view>
      </view>
      <view class="uploading-line" wx:if="{{uploading}}">正在上传并解析附件…</view>
    </view>
    <view class="composer-row">
      <view class="attach-button" role="button" aria-label="添加 Excel 或图片" bindtap="chooseAttachment">附件</view>
      <textarea class="composer-input" aria-label="给小五发送消息" value="{{input}}" focus="{{inputFocus}}" bindblur="blurQuestion" bindinput="updateInput" auto-height maxlength="500" placeholder="给小五发消息" disabled="{{sending || resolving || uploading || (run && run.status === 'WAITING_APPROVAL')}}" />
      <button class="send-button" aria-label="发送消息" bindtap="send" disabled="{{(!input && !pendingAttachments.length) || sending || resolving || uploading || (run && run.status === 'WAITING_APPROVAL')}}">发送</button>
    </view>
    <view class="composer-hint">小五会查询实时业务数据，正式操作需要你确认</view>
  </view>
</view>
