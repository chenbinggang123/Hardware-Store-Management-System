<view class="agent-screen">
  <view class="agent-header" style="padding-top: {{statusBarHeight}}px; padding-right: {{capsuleReserve}}px; min-height: {{navigationHeight}}px;">
    <view class="icon-button menu-button" role="button" aria-label="打开会话列表" bindtap="openHistory">
      <view class="menu-line"></view><view class="menu-line"></view><view class="menu-line short"></view>
    </view>
    <view class="agent-heading">
      <view class="agent-title">{{currentTitle}}</view>
      <view class="agent-subtitle" wx:if="{{streaming}}"><text class="stream-dot"></text>小五正在回复</view>
      <view class="agent-subtitle" wx:else>小五 · 经营助手</view>
    </view>
    <view class="icon-button compose-button" role="button" aria-label="开始新对话" bindtap="startNew">
      <view class="compose-square"></view><view class="compose-stroke"></view>
    </view>
  </view>

  <view class="history-backdrop" wx:if="{{historyOpen}}" bindtap="closeHistory"></view>
  <view class="history-drawer {{historyOpen ? 'open' : ''}}" catchtap="preventClose">
    <view class="history-head">
      <view class="drawer-brand"><view class="drawer-mark">小</view><view><view class="history-title">小五</view><view class="history-subtitle">经营助手</view></view></view>
      <view class="history-close" role="button" aria-label="关闭会话列表" bindtap="closeHistory"><view></view><view></view></view>
    </view>
    <view class="history-new" role="button" aria-label="开始新对话" bindtap="startNew"><view class="history-new-icon"><view></view><view></view></view><text>新对话</text></view>
    <scroll-view class="drawer-scroll" scroll-y>
      <view class="history-section-head"><view><view class="history-section-label">最近会话</view><view class="history-section-note">滚动查看更多</view></view><view class="history-count">{{allConversations.length}}</view></view>
      <view class="history-search">
        <view class="history-search-icon"></view>
        <input aria-label="搜索最近会话" value="{{historyQuery}}" bindinput="searchHistory" placeholder="搜索标题或内容" confirm-type="search" />
        <view class="history-search-clear" wx:if="{{historyQuery}}" role="button" aria-label="清空搜索" bindtap="clearHistorySearch"><view></view><view></view></view>
      </view>
      <view class="history-loading" wx:if="{{loadingHistory}}">正在读取历史…</view>
      <view class="history-empty" wx:elif="{{!conversations.length}}">{{historyQuery ? '没有找到相关会话' : '还没有历史会话'}}<br/><text>{{historyQuery ? '换个关键词试试' : '发送第一条消息后会自动保存在这里'}}</text></view>
      <scroll-view class="history-list-scroll" wx:else scroll-y enhanced show-scrollbar="{{true}}">
        <view class="history-entry {{item.id === conversationId ? 'active' : ''}}" wx:for="{{conversations}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseConversation">
          <view class="history-entry-body">
            <view class="history-entry-top">
              <text class="history-entry-title">{{item.title}}</text>
              <text class="history-entry-time">{{item.timeText}}</text>
            </view>
            <view class="history-entry-preview">{{item.preview}}</view>
          </view>
          <view class="history-entry-more" role="button" aria-label="会话操作" data-id="{{item.id}}" catchtap="conversationActions"><view></view><view></view><view></view></view>
        </view>
      </scroll-view>

      <view class="drawer-divider"></view>
      <view class="history-section-head nav-heading"><view><view class="history-section-label">常用功能</view><view class="history-section-note">直接进入任务</view></view></view>
      <view class="drawer-feature-panel">
        <view class="drawer-feature" role="button" data-action="billing" bindtap="useCoreAction"><view class="drawer-feature-symbol receipt"><view></view></view><view class="drawer-feature-copy"><view class="drawer-feature-title">快捷开单</view><view class="drawer-feature-desc">录商品、预览并导出单据</view></view><view class="drawer-chevron"></view></view>
        <view class="drawer-feature" role="button" bindtap="openMyFiles"><view class="drawer-feature-symbol file"><view></view></view><view class="drawer-feature-copy"><view class="drawer-feature-title">小五生成的文件</view><view class="drawer-feature-desc">打开、修改或转发文件</view></view><view class="drawer-chevron"></view></view>
      </view>

      <view class="history-section-head nav-heading"><view><view class="history-section-label">功能导航</view><view class="history-section-note">按业务分类查找</view></view></view>
      <view class="drawer-nav-panel"><view class="drawer-group"><view class="drawer-group-body drawer-flat"><view data-route="billingList" bindtap="openDrawerPage">开单记录</view><view data-route="factories" bindtap="openDrawerPage">工厂账本</view><view data-route="products" bindtap="openDrawerPage">商品（含库存）</view><view data-route="purchases" bindtap="openDrawerPage">进货</view><view data-route="files" bindtap="openDrawerPage">文件</view><view data-route="settings" bindtap="openDrawerPage">设置与更多工具</view></view></view></view>
    </scroll-view>
    <view class="drawer-foot">正式业务操作始终需要你确认</view>
  </view>

  <scroll-view class="conversation-scroll" scroll-y scroll-into-view="{{scrollTarget}}" enhanced show-scrollbar="{{false}}">

  <view class="welcome" wx:if="{{!messages.length && !run}}">
    <view class="welcome-title">今天想做什么？</view>
    <view class="welcome-subtitle">直接说，或者拍一张单据给小五。</view>
    <view class="core-actions" aria-label="常用功能">
      <view class="core-action" role="button" wx:for="{{coreActions}}" wx:key="key" data-action="{{item.key}}" bindtap="useCoreAction">
        <view class="core-action-icon core-action-{{item.key}}"><view></view><view></view></view>
        <view class="core-action-copy"><view class="core-action-title">{{item.title}}</view><view class="core-action-desc">{{item.description}}</view></view>
      </view>
    </view>
  </view>

  <view class="conversation">
    <block wx:for="{{messages}}" wx:key="index">
      <view class="message-row {{item.role}}">
        <view class="message-stack" wx:if="{{item.role === 'assistant' || item.role === 'error'}}">
          <view class="assistant-author"><text class="assistant-dot">小</text><text>小五</text></view>
          <view class="message assistant-content">
            <view class="typing-indicator" wx:if="{{item.streaming && !item.content}}"><text></text><text></text><text></text></view>
            <block wx:elif="{{item.blocks && item.blocks.length}}">
              <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="*this">
                <view class="answer-paragraph" wx:if="{{block.type === 'text'}}">{{block.text}}</view>
                <view class="answer-heading" wx:elif="{{block.type === 'heading'}}">{{block.text}}</view>
                <view class="answer-list" wx:elif="{{block.type === 'list'}}"><text class="answer-list-marker">{{block.marker}}</text><text>{{block.text}}</text></view>
                <scroll-view class="answer-table-scroll" wx:elif="{{block.type === 'table'}}" scroll-x="{{true}}" enhanced="{{true}}" aria-label="明细表，可左右滑动查看更多列">
                  <view class="answer-table" style="min-width: {{block.width}}rpx;">
                    <view class="answer-table-row answer-table-head">
                      <view class="answer-table-cell {{column.numeric ? 'numeric' : ''}}" wx:for="{{block.columns}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="columnIndex" style="width: {{column.width}}rpx;">{{column.label}}</view>
                    </view>
                    <view class="answer-table-row" wx:for="{{block.rows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex">
                      <view class="answer-table-cell {{cell.numeric ? 'numeric' : ''}}" wx:for="{{row.cells}}" wx:for-item="cell" wx:for-index="cellIndex" wx:key="cellIndex" style="width: {{cell.width}}rpx;">{{cell.text}}</view>
                    </view>
                  </view>
                </scroll-view>
                <view class="answer-field" wx:elif="{{block.type === 'field'}}">
                  <text class="answer-field-label">{{block.label}}</text>
                  <text class="answer-field-value">{{block.value}}</text>
                </view>
                <view class="product-result" wx:elif="{{block.type === 'product'}}" data-id="{{block.id}}" bindtap="openProduct">
                  <view class="product-result-head">
                    <text class="product-result-name">{{block.name}}</text>
                    <text class="product-result-price">¥{{block.price}}</text>
                  </view>
                  <view class="product-result-meta">{{block.spec}} · {{block.unit}}</view>
                  <view class="product-result-id">商品 ID {{block.id}}</view>
                </view>
              </block>
            </block>
            <view class="answer-paragraph" wx:else>{{item.content}}<text class="stream-cursor" wx:if="{{item.streaming}}"></text></view>
            <view class="file-card-list" wx:if="{{item.files && item.files.length}}">
              <view class="file-card {{file.failed ? 'failed' : ''}}" wx:for="{{item.files}}" wx:for-item="file" wx:key="id">
                <view class="file-card-mark"><text>{{file.mark}}</text></view>
                <view class="file-card-copy">
                  <view class="file-card-name">{{file.name}}</view>
                  <view class="file-card-meta">{{file.statusText}}<text wx:if="{{file.sizeText}}"> · {{file.sizeText}}</text><text wx:if="{{file.detailText}}"> · {{file.detailText}}</text></view>
                  <view class="file-card-error" wx:if="{{file.errorMessage}}">{{file.errorMessage}}</view>
                  <view class="file-card-actions">
                    <view class="file-card-action" wx:if="{{file.ready}}" role="button" aria-label="打开文件" data-id="{{file.id}}" catchtap="openGeneratedFile">{{openingFileId === file.id ? '打开中…' : '打开'}}</view>
                    <view class="file-card-action secondary" wx:if="{{file.ready && file.fileType === 'xlsx'}}" role="button" aria-label="编辑这个表格" data-id="{{file.id}}" catchtap="quickEditGeneratedFile">编辑表格</view>
                    <view class="file-card-action secondary" wx:if="{{file.ready}}" role="button" aria-label="让小五修改这个文件" data-id="{{file.id}}" catchtap="modifyGeneratedFile">小五修改</view>
                    <view class="file-card-action danger" role="button" aria-label="删除文件" data-id="{{file.id}}" catchtap="deleteGeneratedFile">{{deletingFileId === file.id ? '删除中…' : '删除'}}</view>
                  </view>
                </view>
              </view>
            </view>
            <view class="billing-message-action" wx:if="{{item.billingDocumentId}}" data-id="{{item.billingDocumentId}}" bindtap="openBillingDocument"><text>编辑并预览销售单</text><text>›</text></view>
            <view class="message-retry" wx:if="{{item.role === 'error'}}" bindtap="retryLastMessage">重新输入并重试</view>
          </view>
        </view>
        <view class="message" wx:else>
          <view class="message-attachments" wx:if="{{item.attachments && item.attachments.length}}">
            <view class="attachment-card sent" wx:for="{{item.attachments}}" wx:for-item="file" wx:key="id">
              <view class="attachment-icon">{{file.typeMark}}</view>
              <view class="attachment-copy"><view class="attachment-name">{{file.originalName}}</view><view class="attachment-meta">{{file.typeText}} · {{file.sizeText}}</view></view>
            </view>
          </view>
          <view>{{item.content}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="run-progress" wx:if="{{run && run.status === 'RUNNING'}}">
    <view class="run-progress-head"><view><view class="run-progress-title">小五正在处理</view><view class="run-progress-stage">{{run.stageText}}</view></view><view class="tag tag-info">处理中</view></view>
    <view class="run-progress-track"><view class="{{run.progressPercent ? 'determinate' : ''}}" style="width: {{run.progressPercent ? run.progressPercent + '%' : '38%'}};"></view></view>
    <view class="run-progress-count" wx:if="{{run.progressTotal}}">已完成 {{run.progressCompleted}} / {{run.progressTotal}}<text wx:if="{{run.issueCount}}"> · {{run.issueCount}} 个问题待确认</text></view>
    <view class="run-progress-note">{{run.canLeave ? '可以先去别的页面，任务会继续处理，回来后从最近会话查看。' : '请暂时留在当前页面，完成后会立即显示结果。'}}</view>
    <view class="run-progress-actions"><view class="run-progress-action secondary" wx:if="{{run.canCancel}}" bindtap="cancelRun">{{cancelling ? '正在取消…' : '取消任务'}}</view><view class="run-progress-action" bindtap="openWorkbench">查看账本</view></view>
  </view>
  <view class="network-state" wx:if="{{connectionInterrupted}}"><view><view class="network-title">网络连接中断</view><view class="network-desc">任务可能仍在后台处理，当前会话已经保留。</view></view><view class="network-retry" bindtap="retryConnection">重新连接</view></view>

  <view class="approval-sheet {{run.pendingAction.isHighRisk ? 'high-risk' : ''}}" wx:if="{{run && run.status === 'WAITING_APPROVAL' && run.pendingAction}}">
    <view class="approval-topline"></view>
    <view class="approval-head">
      <view class="approval-heading">
        <view class="approval-title">{{run.pendingAction.title}}</view>
        <view class="approval-description">{{run.pendingAction.description}}</view>
      </view>
      <view class="risk-badge">{{run.pendingAction.risk === 'R2_WRITE' ? '正式写入' : '只生成文件'}}</view>
    </view>
    <view class="workbook-preview" wx:if="{{run.pendingAction.preview.kind === 'EXCEL_WORKBOOK'}}">
      <view class="operation-row"><text>文件名</text><text class="operation-value">{{run.pendingAction.preview.fileName}}</text></view>
      <view class="operation-row"><text>内容</text><text class="operation-value">{{run.pendingAction.preview.sheetCount}} 个工作表，{{run.pendingAction.preview.rowCount}} 行数据</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.sourceAttachment}}"><text>来源附件</text><text class="operation-value">{{run.pendingAction.preview.sourceAttachment.name}}</text></view>
      <view class="operation-row"><text>保存方式</text><text class="operation-value">{{run.pendingAction.preview.retention}}</text></view>
      <view class="workbook-sheet" wx:for="{{run.pendingAction.preview.sheets}}" wx:key="name">
        <view class="workbook-sheet-head"><text class="workbook-sheet-name">{{item.name}}</text><text class="workbook-sheet-meta">{{item.rowCount}} 行 {{item.columnCount}} 列<text class="workbook-mismatch" wx:if="{{item.mismatchCount}}">，{{item.mismatchCount}} 处金额待核对</text></text></view>
        <view class="workbook-columns">表头：{{item.columnsText}}</view>
        <view class="workbook-sample" wx:for="{{item.sampleLines}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="lineIndex">{{line}}</view>
        <view class="workbook-sample more" wx:if="{{item.rowCount > item.sampleLines.length}}">共 {{item.rowCount}} 行，确认后在文件里看全部</view>
      </view>
      <view class="workbook-warning" wx:for="{{run.pendingAction.preview.warnings}}" wx:for-index="warningIndex" wx:key="warningIndex">{{item}}</view>
    </view>
    <view class="billing-draft-preview" wx:if="{{run.pendingAction.preview.kind === 'BILLING_DRAFT'}}">
      <view class="billing-draft-head">
        <view><view class="billing-draft-kicker">可编辑销售单</view><view class="billing-draft-title">{{run.pendingAction.preview.billingTitle}}</view></view>
        <view class="billing-draft-total"><text>当前合计</text><text class="billing-draft-total-value">¥{{run.pendingAction.preview.billingTotal}}</text></view>
      </view>
      <view class="billing-draft-meta">
        <text>{{run.pendingAction.preview.content.date || '日期待填写'}}</text>
        <text>{{run.pendingAction.preview.billingLines.length}} 项商品</text>
        <text wx:if="{{run.pendingAction.preview.billingIncompleteCount}}">{{run.pendingAction.preview.billingIncompleteCount}} 项待补充</text>
      </view>
      <view class="billing-draft-lines">
        <view class="billing-draft-line" wx:for="{{run.pendingAction.preview.billingLines}}" wx:key="index">
          <view class="billing-line-index">{{item.index}}</view>
          <view class="billing-line-main"><view class="billing-line-name">{{item.name || '商品名称待填写'}}</view><view class="billing-line-meta">{{item.meta}} · {{item.quantityText}} × ¥{{item.priceText}}</view></view>
          <view class="billing-line-amount">¥{{item.amountText}}</view>
        </view>
      </view>
      <view class="billing-draft-tip">确认后进入开单页逐项修改，并按正式单据版式预览；此时不会登记销售、欠款或库存。</view>
    </view>
    <view class="customer-line" wx:if="{{run.pendingAction.preview.customerName}}"><text>客户</text><text class="customer-name">{{run.pendingAction.preview.customerName}}</text></view>
    <view class="operation-preview" wx:if="{{run.pendingAction.preview.productName}}">
      <view class="operation-row"><text>商品</text><text class="operation-value">{{run.pendingAction.preview.productName}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.barcode}}"><text>条码</text><text class="operation-value">{{run.pendingAction.preview.barcode}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.spec}}"><text>规格</text><text class="operation-value">{{run.pendingAction.preview.spec}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.statusText}}"><text>目标状态</text><text class="operation-value">{{run.pendingAction.preview.statusText}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.beforeQuantity !== undefined}}"><text>库存变化</text><text class="operation-value">{{run.pendingAction.preview.beforeQuantity}} → {{run.pendingAction.preview.actualQuantity}}</text></view>
      <view class="operation-row" wx:if="{{run.pendingAction.preview.reason}}"><text>原因</text><text class="operation-value">{{run.pendingAction.preview.reason}}</text></view>
    </view>
    <view class="amount-grid" wx:if="{{run.pendingAction.preview.totalAmount !== undefined}}">
      <view class="amount-cell"><text>订单金额</text><text class="amount-value">¥{{run.pendingAction.preview.totalAmount}}</text></view>
      <view class="amount-cell"><text>已收金额</text><text class="amount-value">¥{{run.pendingAction.preview.receivedAmount || 0}}</text></view>
      <view class="amount-cell debt"><text>新增欠款</text><text class="amount-value">¥{{run.pendingAction.preview.newDebtAmount || 0}}</text></view>
      <view class="amount-cell debt"><text>提交后欠款</text><text class="amount-value">¥{{run.pendingAction.preview.debtAfterCommit || 0}}</text></view>
    </view>
    <view class="approval-items" wx:if="{{run.pendingAction.preview.items.length}}">
      <view class="approval-item" wx:for="{{run.pendingAction.preview.items}}" wx:key="productId">
        <view><view class="item-name">{{item.productName}}</view><view class="item-meta">{{item.quantity}} 件 × ¥{{item.price}} · 库存 {{item.availableQuantity}}</view></view>
        <view class="item-amount">¥{{item.amount}}</view>
      </view>
    </view>
    <view class="effect-note" wx:if="{{run.pendingAction.preview.effect}}">{{run.pendingAction.preview.effect}}</view>
    <view class="impact-detail" wx:if="{{run.pendingAction.impact}}">
      <view wx:if="{{run.pendingAction.impact.willChange.length}}"><text>会修改</text><view wx:for="{{run.pendingAction.impact.willChange}}" wx:key="*this">{{item}}</view></view>
      <view wx:if="{{run.pendingAction.impact.willNotChange.length}}"><text>不会修改</text><view wx:for="{{run.pendingAction.impact.willNotChange}}" wx:key="*this">{{item}}</view></view>
      <view class="impact-warning" wx:for="{{run.pendingAction.impact.warnings}}" wx:key="code">{{item.message}}</view>
    </view>
    <view class="stock-warning" wx:if="{{run.pendingAction.preview.inventorySufficient === false}}">库存不足，不能继续</view>
    <view class="approval-actions">
      <button class="approval-button cancel" bindtap="reject" disabled="{{resolving}}">取消</button>
      <button class="approval-button confirm" bindtap="approve" disabled="{{resolving || run.pendingAction.preview.inventorySufficient === false}}">{{resolving ? '处理中…' : run.pendingAction.preview.kind === 'EXCEL_WORKBOOK' ? '生成文件' : run.pendingAction.preview.kind === 'BILLING_DRAFT' ? '进入开单页' : '确认执行'}}</button>
    </view>
  </view>

  <view class="result-sheet tone-{{run.statusTone}}" wx:if="{{run && run.status !== 'WAITING_APPROVAL' && run.status !== 'RUNNING'}}">
    <view class="result-status">{{run.statusText}}</view><view class="result-copy">{{run.status === 'COMPLETED' ? (run.files && run.files.length ? '文件已放在上面的回复里，可以打开、转发，或让小五继续修改。' : '结果已显示在上方，可以继续提问或去对应页面查看。') : run.status === 'PARTIAL' ? '部分内容已经完成，请查看上方说明和未完成项目。' : run.status === 'FAILED' ? '这次没有完成，原来的输入和附件仍可继续使用。' : '任务已经结束，说明保留在当前会话中。'}}</view>
    <view class="result-summary-grid" wx:if="{{run.summary}}"><view><text>{{run.summary.successCount || 0}}</text><text>完成</text></view><view><text>{{run.summary.skippedCount || 0}}</text><text>跳过</text></view><view class="danger"><text>{{run.summary.failedCount || 0}}</text><text>失败</text></view></view>
    <view class="result-actions"><view wx:for="{{run.actions}}" wx:key="label" data-target="{{item.target}}" data-params="{{item.params}}" bindtap="openResultAction">{{item.label}}</view><view bindtap="openMyFiles">{{run.files && run.files.length ? '全部生成的文件' : '我的文件'}}</view><view bindtap="openWorkbench">查看账本</view><view wx:if="{{run.status === 'FAILED' || (run.retry && run.retry.supported)}}" bindtap="retryLastMessage">重新输入并重试</view></view>
  </view>
  <view id="conversation-end" class="conversation-end"></view>
  </scroll-view>

  <scroll-view class="compact-actions" scroll-x wx:if="{{messages.length}}" enhanced show-scrollbar="{{false}}">
    <view class="compact-actions-row"><view class="compact-action" wx:for="{{coreActions}}" wx:key="key" role="button" data-action="{{item.key}}" bindtap="useCoreAction">{{item.title}}</view></view>
  </scroll-view>

  <view class="attachment-backdrop" wx:if="{{attachmentMenuOpen}}" bindtap="closeAttachmentMenu"></view>
  <view class="composer">
    <view class="attachment-menu" wx:if="{{attachmentMenuOpen}}" catchtap="preventClose">
      <view class="attachment-menu-title">添加到当前对话</view>
      <view class="attachment-menu-grid">
        <view class="attachment-option" role="button" aria-label="选择已开单据或草稿" bindtap="chooseBillingDocument"><view class="attachment-option-icon document"><view></view></view><text>开单记录</text></view>
        <view class="attachment-option" role="button" aria-label="拍照" bindtap="chooseCamera"><view class="attachment-option-icon camera"><view></view></view><text>拍照</text></view>
        <view class="attachment-option" role="button" aria-label="从相册选择图片" bindtap="chooseAlbum"><view class="attachment-option-icon album"><view></view></view><text>相册</text></view>
        <view class="attachment-option" role="button" aria-label="从微信选择表格 Word 或 PDF" bindtap="chooseDocument"><view class="attachment-option-icon document"><view></view></view><text>微信文件</text></view>
        <view class="attachment-option" role="button" aria-label="选择小五生成过的 Excel 继续修改" bindtap="chooseGeneratedExcel"><view class="attachment-option-icon excel"><view></view></view><text>修改 Excel</text></view>
      </view>
      <view class="attachment-menu-note">图片会先识别，确认后再使用。修改 Excel 会生成新文件，不覆盖原件。</view>
    </view>
    <view class="composer-attachments" wx:if="{{pendingAttachments.length || uploading}}">
      <view class="attachment-card" wx:for="{{pendingAttachments}}" wx:key="id">
        <view class="attachment-icon">{{item.typeMark}}</view>
        <view class="attachment-copy"><view class="attachment-name">{{item.originalName}}</view><view class="attachment-meta {{item.ready ? '' : 'waiting'}}">{{item.typeText}} · {{item.sizeText}} · {{item.parseText}}</view></view>
        <view class="attachment-actions">
          <view class="attachment-save" wx:if="{{item.typeText === '图片'}}" role="button" aria-label="保存原图到我的文件" data-id="{{item.id}}" catchtap="savePendingAttachment">{{item.savedToFiles ? '已保存' : savingAttachmentId === item.id ? '保存中…' : '保存到文件'}}</view>
          <view class="attachment-remove" role="button" aria-label="移除附件" data-id="{{item.id}}" catchtap="removeAttachment">×</view>
        </view>
      </view>
      <view class="uploading-line" wx:if="{{uploading}}">正在上传并识别附件…</view>
    </view>
    <view class="composer-attachments" wx:if="{{billingReference || billingLoading}}"><view class="attachment-card"><view class="attachment-copy"><view class="attachment-name">{{billingLoading ? '正在读取单据…' : (billingReference.number || '开单草稿')}}</view><view class="attachment-meta">{{billingReference.content.customerName}} · 发送后小五可读取完整明细</view></view><view wx:if="{{!billingLoading}}" class="attachment-remove" role="button" aria-label="移除单据" bindtap="removeBillingReference">×</view></view></view>
    <view class="composer-row">
      <view class="attach-button {{attachmentMenuOpen ? 'active' : ''}}" role="button" aria-label="添加照片或文件" aria-expanded="{{attachmentMenuOpen}}" bindtap="toggleAttachmentMenu"><view></view><view></view></view>
      <textarea class="composer-input" aria-label="给小五发送消息" value="{{input}}" focus="{{inputFocus}}" bindblur="blurQuestion" bindinput="updateInput" auto-height maxlength="500" placeholder="说一件事，或先加附件" disabled="{{sending || resolving || uploading || savingAttachmentId || (run && run.status === 'WAITING_APPROVAL')}}" />
      <view class="send-hit" role="button" aria-label="发送消息" aria-disabled="{{(!input && !pendingAttachments.length && !billingReference) || billingLoading || sending || resolving || uploading || savingAttachmentId || (run && run.status === 'WAITING_APPROVAL')}}" bindtap="send"><view class="send-button {{(!input && !pendingAttachments.length && !billingReference) || billingLoading || sending || resolving || uploading || savingAttachmentId || (run && run.status === 'WAITING_APPROVAL') ? 'disabled' : ''}}"><view class="send-glyph"></view></view></view>
    </view>
  </view>
</view>
