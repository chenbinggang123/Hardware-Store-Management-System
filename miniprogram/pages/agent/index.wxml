<view class="agent-screen">
  <view class="agent-header">
    <view class="agent-mark">小</view>
    <view class="agent-heading">
      <view class="agent-title">小五</view>
      <view class="agent-subtitle"><text>复杂开单、模糊查找和经营分析</text><text class="agent-live"><text class="agent-live-dot"></text>可用</text></view>
    </view>
    <view class="header-actions">
      <view class="history-button" bindtap="openHistory">历史</view>
      <view class="new-task" bindtap="startNew" wx:if="{{messages.length || run}}">新对话</view>
    </view>
  </view>

  <view class="trust-strip">
    <text>查数据直接完成</text><text class="trust-dot">·</text>
    <text>正式操作由你确认</text>
  </view>

  <view class="history-backdrop" wx:if="{{historyOpen}}" bindtap="closeHistory"></view>
  <view class="history-drawer {{historyOpen ? 'open' : ''}}">
    <view class="history-handle"></view>
    <view class="history-head">
      <view><view class="history-title">历史会话</view><view class="history-subtitle">继续之前的查询和开单</view></view>
      <view class="history-close" bindtap="closeHistory">关闭</view>
    </view>
    <scroll-view class="history-list" scroll-y>
      <view class="history-loading" wx:if="{{loadingHistory}}">正在读取历史…</view>
      <view class="history-empty" wx:elif="{{!conversations.length}}">还没有历史会话<br/><text>发送第一条消息后会自动保存在这里</text></view>
      <view class="history-entry {{item.id === conversationId ? 'active' : ''}}" wx:for="{{conversations}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseConversation">
        <view class="history-entry-top"><text class="history-entry-title">{{item.title}}</text><text class="history-entry-time">{{item.timeText}}</text></view>
        <view class="history-entry-preview">{{item.preview}}</view>
      </view>
    </scroll-view>
    <view class="history-new" bindtap="startNew">＋ 开始新对话</view>
  </view>

  <view class="suggestions" wx:if="{{!messages.length && !run}}">
    <view class="suggestion-title">可以这样跟小五说</view>
    <view class="suggestion" wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="useSuggestion"><view class="suggestion-mark">{{index + 1}}</view><view class="suggestion-copy">{{item}}</view><view class="suggestion-arrow">›</view></view>
  </view>

  <view class="conversation">
    <block wx:for="{{messages}}" wx:key="index">
      <view class="message-row {{item.role}}">
        <view class="message-stack" wx:if="{{item.role === 'assistant'}}">
          <view class="assistant-author">小五</view>
          <view class="message assistant-content">
            <block wx:if="{{item.blocks && item.blocks.length}}">
              <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="*this">
                <view class="answer-paragraph" wx:if="{{block.type === 'text'}}">{{block.text}}</view>
                <view class="answer-field" wx:elif="{{block.type === 'field'}}">
                  <text class="answer-field-label">{{block.label}}</text>
                  <text class="answer-field-value">{{block.value}}</text>
                </view>
                <view class="product-result" wx:elif="{{block.type === 'product'}}">
                  <view class="product-result-head">
                    <text class="product-result-name">{{block.name}}</text>
                    <text class="product-result-price">¥{{block.price}}</text>
                  </view>
                  <view class="product-result-meta">{{block.spec}} · {{block.unit}}</view>
                  <view class="product-result-id">商品 ID {{block.id}}</view>
                </view>
              </block>
            </block>
            <view class="answer-paragraph" wx:else>{{item.content}}</view>
          </view>
        </view>
        <view class="message" wx:else>
          <view class="message-attachments" wx:if="{{item.attachments && item.attachments.length}}">
            <view class="attachment-card sent" wx:for="{{item.attachments}}" wx:for-item="file" wx:key="id">
              <view class="attachment-icon">{{file.typeText === '图片' ? '图' : '表'}}</view>
              <view class="attachment-copy"><view class="attachment-name">{{file.originalName}}</view><view class="attachment-meta">{{file.typeText}} · {{file.sizeText}}</view></view>
            </view>
          </view>
          <view>{{item.content}}</view>
        </view>
      </view>
    </block>
    <view class="message-row assistant" wx:if="{{sending}}"><view class="message-stack"><view class="assistant-author">小五</view><view class="message thinking">正在核对业务数据…</view></view></view>
  </view>

  <view class="approval-sheet {{run.pendingAction.isHighRisk ? 'high-risk' : ''}}" wx:if="{{run && run.status === 'WAITING_APPROVAL' && run.pendingAction}}">
    <view class="approval-topline"></view>
    <view class="approval-head">
      <view class="approval-heading">
        <view class="approval-title">{{run.pendingAction.title}}</view>
        <view class="approval-description">{{run.pendingAction.description}}</view>
      </view>
      <view class="risk-badge">{{run.pendingAction.risk === 'R2_WRITE' ? '正式写入' : '草稿操作'}}</view>
    </view>
    <view class="customer-line" wx:if="{{run.pendingAction.preview.customerName}}"><text>客户</text><text class="customer-name">{{run.pendingAction.preview.customerName}}</text></view>
    <view class="amount-grid" wx:if="{{run.pendingAction.preview.totalAmount !== undefined}}">
      <view class="amount-cell"><text>订单金额</text><text class="amount-value">¥{{run.pendingAction.preview.totalAmount}}</text></view>
      <view class="amount-cell"><text>已收金额</text><text class="amount-value">¥{{run.pendingAction.preview.receivedAmount || 0}}</text></view>
      <view class="amount-cell debt"><text>新增欠款</text><text class="amount-value">¥{{run.pendingAction.preview.newDebtAmount || 0}}</text></view>
      <view class="amount-cell debt"><text>提交后欠款</text><text class="amount-value">¥{{run.pendingAction.preview.debtAfterCommit || 0}}</text></view>
    </view>
    <view class="approval-items" wx:if="{{run.pendingAction.preview.items.length}}">
      <view class="approval-item" wx:for="{{run.pendingAction.preview.items}}" wx:key="productId">
        <view><view class="item-name">{{item.productName}}</view><view class="item-meta">{{item.quantity}} 件 × ¥{{item.price}} · 库存 {{item.availableQuantity}}</view></view>
        <view class="item-amount">¥{{item.amount}}</view>
      </view>
    </view>
    <view class="effect-note" wx:if="{{run.pendingAction.preview.effect}}">{{run.pendingAction.preview.effect}}</view>
    <view class="stock-warning" wx:if="{{run.pendingAction.preview.inventorySufficient === false}}">库存不足，不能继续</view>
    <view class="approval-actions">
      <button class="approval-button cancel" bindtap="reject" disabled="{{resolving}}">取消操作</button>
      <button class="approval-button confirm" bindtap="approve" disabled="{{resolving || run.pendingAction.preview.inventorySufficient === false}}">{{resolving ? '处理中…' : '确认执行'}}</button>
    </view>
  </view>

  <view class="result-sheet" wx:if="{{run && run.status !== 'WAITING_APPROVAL' && run.output && !messages.length}}">
    <view class="result-status">{{run.statusText}}</view><view class="result-copy">{{run.output}}</view>
  </view>

  <view class="composer-space"></view>
  <view class="composer">
    <view class="composer-attachments" wx:if="{{pendingAttachments.length || uploading}}">
      <view class="attachment-card" wx:for="{{pendingAttachments}}" wx:key="id">
        <view class="attachment-icon">{{item.typeText === '图片' ? '图' : '表'}}</view>
        <view class="attachment-copy"><view class="attachment-name">{{item.originalName}}</view><view class="attachment-meta {{item.ready ? '' : 'waiting'}}">{{item.ready ? item.sizeText + ' · 已解析' : item.errorMessage}}</view></view>
        <view class="attachment-remove" data-id="{{item.id}}" bindtap="removeAttachment">×</view>
      </view>
      <view class="uploading-line" wx:if="{{uploading}}">正在上传并解析附件…</view>
    </view>
    <view class="composer-row">
      <view class="attach-button" bindtap="chooseAttachment">＋</view>
      <textarea class="composer-input" value="{{input}}" bindinput="updateInput" auto-height maxlength="500" placeholder="输入问题，或上传订单图片 / Excel" disabled="{{sending || resolving || uploading || (run && run.status === 'WAITING_APPROVAL')}}" />
      <button class="send-button" bindtap="send" disabled="{{(!input && !pendingAttachments.length) || sending || resolving || uploading || (run && run.status === 'WAITING_APPROVAL')}}">发送</button>
    </view>
  </view>
</view>
