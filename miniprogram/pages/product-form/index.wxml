<view class="screen product-form">
  <view class="product-heading"><view class="product-title">{{id ? '编辑商品资料' : '手动补录商品'}}</view><view class="product-note">日常商品由已确认单据自动记录，这里只需补充或修正。</view></view>
  <view class="empty-state" wx:if="{{loading || loadError}}"><text>{{loading ? '正在读取商品…' : loadError}}</text><view wx:if="{{loadError}}" bindtap="loadProduct">重新加载</view></view>
  <block wx:else>
    <view class="compact-card">
      <view class="compact-field"><text>商品名称</text><input value="{{form.name}}" data-key="name" bindinput="updateField" placeholder="必填" /></view>
      <view class="compact-grid"><view class="compact-field"><text>规格</text><input value="{{form.spec}}" data-key="spec" bindinput="updateField" placeholder="例如 M6×20" /></view><view class="compact-field"><text>单位</text><input value="{{form.unit}}" data-key="unit" bindinput="updateField" placeholder="必填" /></view></view>
      <view class="compact-field"><text>源头厂商</text><input value="{{form.sourceFactory}}" data-key="sourceFactory" bindinput="updateField" placeholder="选填，按厂商归入进货账本" /></view>
      <view class="compact-grid"><view class="compact-field"><text>进价</text><input type="digit" value="{{form.costPrice}}" data-key="costPrice" bindinput="updateField" placeholder="选填" /></view><view class="compact-field"><text>售价</text><input type="digit" value="{{form.retailPrice}}" data-key="retailPrice" bindinput="updateField" placeholder="选填" /></view></view>
      <view class="compact-field" wx:if="{{!id}}"><text>当前数量</text><input type="number" value="{{form.stock}}" data-key="stock" bindinput="updateField" placeholder="选填，默认 0" /></view>
      <view class="compact-more" wx:if="{{id}}" bindtap="openAdjust">修改当前数量 ›</view>
    </view>
    <view class="compact-more" bindtap="toggleMore">{{moreOpen ? '收起其他资料' : '其他资料（条码、库位、图片等）'}}</view>
    <view class="compact-card" wx:if="{{moreOpen}}">
      <view class="compact-field"><text>条码</text><input value="{{form.barcode}}" data-key="barcode" bindinput="updateField" placeholder="留空自动编号" /></view>
      <view class="compact-grid"><view class="compact-field"><text>批发价</text><input type="digit" value="{{form.wholesalePrice}}" data-key="wholesalePrice" bindinput="updateField" placeholder="选填" /></view><view class="compact-field"><text>老客户价</text><input type="digit" value="{{form.oldCustomerPrice}}" data-key="oldCustomerPrice" bindinput="updateField" placeholder="选填" /></view></view>
      <view class="compact-grid"><view class="compact-field"><text>库位</text><input value="{{form.locationId}}" data-key="locationId" bindinput="updateField" placeholder="例如 A-01" /></view><view class="compact-field"><text>单位换算</text><input value="{{form.unitConvert}}" data-key="unitConvert" bindinput="updateField" placeholder="例如 1箱=12件" /></view></view>
      <view class="compact-image"><image wx:if="{{form.imageUrl}}" src="{{form.imageUrl}}" mode="aspectFill" /><view bindtap="chooseImage">{{uploadingImage ? '上传中…' : (form.imageUrl ? '更换图片' : '添加商品图片')}}</view><view wx:if="{{form.imageUrl}}" bindtap="removeImage">移除</view></view>
    </view>
    <view class="product-error" wx:if="{{saveError}}">{{saveError}}</view>
    <button class="btn btn-primary btn-block" disabled="{{saving || uploadingImage}}" bindtap="submit">{{saving ? '保存中…' : '保存商品'}}</button>
  </block>
</view>
