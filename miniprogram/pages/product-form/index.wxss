/* Product form overrides */
.product-image-editor { padding: 18rpx; border: 1rpx solid #D6DEDA; border-radius: 16rpx; background: #F8FAF9; }
.product-image-preview { width: 100%; height: 320rpx; border-radius: 12rpx; background: #E7ECE9; }
.product-image-empty { height: 240rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; border: 2rpx dashed #C8D3CD; border-radius: 12rpx; color: #708078; font-size: 23rpx; text-align: center; }
.product-image-empty text:first-child { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; color: #245E9B; background: #E7F0F8; font-size: 28rpx; font-weight: 760; }
.product-image-actions { margin-top: 16rpx; display: flex; gap: 12rpx; }
