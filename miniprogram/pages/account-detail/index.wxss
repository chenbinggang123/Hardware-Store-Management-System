.detail{padding-top:24rpx}.hero,.payment-card,.history{padding:24rpx;border-radius:18rpx;background:#FFF}.hero-top{display:flex;justify-content:space-between;color:#5E6D65;font-size:22rpx}.balance{margin-top:20rpx;color:#A84635;font-size:50rpx;font-weight:800}.balance-label{color:#738079;font-size:21rpx}.split{display:flex;gap:26rpx;margin-top:18rpx;color:#43534B;font-size:22rpx}.meta{margin-top:10rpx;color:#84908A;font-size:20rpx}.payment-card,.history{margin-top:22rpx}.section-title{margin-bottom:16rpx;color:#17231E;font-size:27rpx;font-weight:740}.field view{margin-bottom:8rpx;color:#536159;font-size:21rpx}.field input,.picker,.note{min-height:70rpx;padding:0 15rpx;border:1rpx solid #CBD5D0;border-radius:12rpx;background:#FFF;box-sizing:border-box;font-size:24rpx}.two{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:12rpx}.picker{display:flex;align-items:center}.note{width:100%;margin-top:12rpx}.pay-button{margin-top:16rpx;color:#FFF;background:#245E9B;font-size:25rpx}.history-row{padding:18rpx 0;display:flex;justify-content:space-between;border-bottom:1rpx solid #E2E7E4;color:#27372F;font-size:23rpx}.history-row>text{font-weight:730}.history-note,.history-empty{margin-top:5rpx;color:#7B8781;font-size:20rpx}.error-state{padding:36rpx;background:#FFF;text-align:center;color:#66746E}
