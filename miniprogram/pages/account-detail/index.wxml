<view class="screen detail"><view class="loading-state" wx:if="{{loading && !document}}">正在读取账款…</view><view class="error-state" wx:elif="{{error && !document}}">{{error}}<view class="state-action" bindtap="load">重新加载</view></view><block wx:elif="{{document}}"><view class="hero"><view class="hero-top"><text>{{document.directionText}} · {{document.counterpartyName}}</text><text>{{document.statusText}}</text></view><view class="balance">¥{{document.outstandingText}}</view><view class="balance-label">当前剩余</view><view class="split"><text>单据 ¥{{document.totalText}}</text><text>已收付 ¥{{document.settledText}}</text></view><view class="meta">{{document.documentDate}} · {{document.documentNumber || '无单号'}}</view><view class="meta" wx:if="{{document.dueDate}}">到期 {{document.dueDate}}{{document.overdue ? ' · 请尽快处理' : ''}}</view></view><view class="payment-card" wx:if="{{document.status !== 'SETTLED'}}"><view class="section-title">登记本次{{document.direction === 'RECEIVABLE' ? '收款' : '付款'}}</view><view class="field"><view>金额</view><input type="digit" aria-label="本次收付金额" placeholder="不超过 {{document.outstandingText}}" value="{{amount}}" data-field="amount" bindinput="input" /></view><view class="two"><picker mode="date" value="{{date}}" bindchange="date"><view class="picker">{{date}} ›</view></picker><picker mode="selector" range="{{methods}}" value="{{methodIndex}}" bindchange="method"><view class="picker">{{methods[methodIndex]}} ›</view></picker></view><input class="note" aria-label="收付款备注" placeholder="备注，可不填" value="{{note}}" data-field="note" bindinput="input" /><button class="pay-button" disabled="{{saving}}" bindtap="pay">{{saving ? '登记中…' : '确认登记'}}</button></view><view class="history"><view class="section-title">收付款记录</view><view class="history-row" wx:for="{{payments}}" wx:key="id"><view><view>{{item.paymentDate}} · {{item.paymentMethod}}</view><view class="history-note">{{item.note || '无备注'}}</view></view><text>¥{{item.amountText}}</text></view><view class="history-empty" wx:if="{{!payments.length}}">还没有收付款记录</view></view></block></view>
