.detail-screen { padding-top: 20rpx; }
.detail-status-head { position: relative; padding: 26rpx 24rpx; overflow: hidden; border-left: 7rpx solid #87938D; background: #FFF; }
.detail-status-head.tone-warning { border-color: #B87418; }
.detail-status-head.tone-danger { border-color: #B94C3A; }
.detail-status-head.tone-success { border-color: #247052; }
.detail-status-head.tone-info { border-color: #245E9B; }
.detail-status-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.task-status { padding: 5rpx 13rpx; border-radius: 9rpx; font-size: 20rpx; font-weight: 700; white-space: nowrap; }
.task-status.warning { color: #8A560E; background: #FFF0D5; }
.task-status.danger { color: #A83F32; background: #FCE9E4; }
.task-status.success { color: #216846; background: #E2F2E9; }
.task-status.info { color: #245E9B; background: #E7F0F8; }
.detail-purpose { color: #17231E; font-size: 35rpx; font-weight: 750; }
.detail-id { margin-top: 4rpx; color: #718079; font-size: 21rpx; }
.detail-progress-track { height: 9rpx; margin-top: 24rpx; overflow: hidden; border-radius: 9rpx; background: #E0E6E3; }
.detail-progress-value { height: 100%; background: #245E9B; }
.detail-progress-text { margin-top: 10rpx; color: #5E6C65; font-size: 22rpx; }
.detail-facts { margin-top: 22rpx; border-top: 1rpx solid #D6DEDA; border-bottom: 1rpx solid #D6DEDA; background: #FFF; }
.detail-facts view { min-height: 76rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #E1E6E3; }
.detail-facts view:last-child { border-bottom: 0; }
.detail-facts text:first-child { color: #718079; font-size: 22rpx; }
.detail-facts text:last-child { max-width: 70%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #2E3B35; font-size: 23rpx; font-weight: 650; text-align: right; }
.detail-action { min-height: 84rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; font-size: 26rpx; font-weight: 700; }
.detail-action.primary { color: #FFF; background: #245E9B; }
.detail-action.retry { color: #A83F32; background: #FCE9E4; border: 1rpx solid #EABDB4; }
.detail-info { margin-top: 22rpx; padding: 20rpx; color: #40534B; background: #E8F0EC; border-left: 6rpx solid #247052; font-size: 23rpx; line-height: 1.65; }
.result-file { margin-top: 14rpx; padding: 17rpx 18rpx; display: flex; align-items: center; gap: 14rpx; border: 1rpx solid #D6DEDA; background: #FFF; }
.result-file-mark { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: #247052; background: #E2F2E9; font-size: 17rpx; font-weight: 750; }
.result-file view view { color: #26332E; font-size: 23rpx; font-weight: 650; }
.result-file text { color: #718079; font-size: 20rpx; }
.detail-tools { margin-top: 22rpx; border-top: 1rpx solid #CBD5D0; }
.detail-tools > view { min-height: 94rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #D7DEDA; }
.detail-tools > view > text:first-child { color: #26332E; font-size: 23rpx; font-weight: 700; }
.detail-tools > view > text:last-child { max-width: 62%; color: #245E9B; font-size: 19rpx; text-align: right; }
.detail-section-title { margin: 34rpx 2rpx 13rpx; color: #17231E; font-size: 31rpx; font-weight: 750; }
.result-summary { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1rpx solid #D6DEDA; border-bottom: 1rpx solid #D6DEDA; background: #FFF; }
.result-summary view { min-height: 100rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1rpx solid #E1E6E3; }
.result-summary view:last-child { border-right: 0; }
.result-summary text:first-child { color: #247052; font-size: 31rpx; font-weight: 750; }
.result-summary text:last-child { color: #718079; font-size: 18rpx; }
.result-summary .danger text:first-child { color: #B94C3A; }
.audit-list { padding-left: 11rpx; }
.audit-row { position: relative; padding: 0 0 28rpx 30rpx; border-left: 2rpx solid #CBD4D0; }
.audit-row:last-child { border-left-color: transparent; }
.audit-dot { position: absolute; left: -9rpx; top: 7rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #245E9B; box-shadow: 0 0 0 6rpx #DDE9F3; }
.audit-title { color: #26332E; font-size: 24rpx; font-weight: 700; }
.audit-detail { margin-top: 4rpx; color: #66746E; font-size: 21rpx; }
.audit-time { margin-top: 5rpx; color: #8A958F; font-size: 19rpx; }
.back-tasks { padding: 24rpx 0 8rpx; color: #245E9B; font-size: 24rpx; text-align: center; }
