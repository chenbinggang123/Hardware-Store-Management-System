<view class="screen">
  <!-- User Profile -->
  <view class="hero-card">
    <view class="hero-eyebrow">SYSTEM</view>
    <view style="display:flex; align-items:center; gap:20rpx; margin-top: 16rpx;">
      <view class="avatar avatar-lg">{{currentUser.name ? currentUser.name.charAt(0) : '管'}}</view>
      <view>
        <view class="hero-title" style="font-size: 32rpx; margin-top: 0;">{{currentUser.name || '管理员'}}</view>
        <view class="hero-subtitle" style="margin-top: 4rpx;">{{currentUser.role || '管理员'}} · {{currentUser.username || 'admin'}}</view>
      </view>
    </view>
  </view>

  <!-- Menu -->
  <view class="form-card">
    <view class="setting-row" bindtap="openUsers">
      <view class="setting-left">
        <view class="setting-icon users">👥</view>
        <view>
          <view class="setting-label">用户管理</view>
          <view class="setting-desc">管理系统账号和角色权限</view>
        </view>
      </view>
      <view><text class="setting-badge" wx:if="{{users.length}}">{{users.length}} 个账号</text><text class="setting-arrow">→</text></view>
    </view>
    <view class="setting-row" bindtap="openLogs">
      <view class="setting-left">
        <view class="setting-icon logs">📝</view>
        <view>
          <view class="setting-label">操作日志</view>
          <view class="setting-desc">查看关键操作记录</view>
        </view>
      </view>
      <view><text class="setting-arrow">→</text></view>
    </view>
    <view class="setting-row" bindtap="backupNow">
      <view class="setting-left">
        <view class="setting-icon backup">💾</view>
        <view>
          <view class="setting-label">立即备份</view>
          <view class="setting-desc">备份当前系统数据</view>
        </view>
      </view>
      <view><text class="setting-arrow">→</text></view>
    </view>
    <view class="setting-row" bindtap="restoreLast">
      <view class="setting-left">
        <view class="setting-icon backup">🔄</view>
        <view>
          <view class="setting-label">恢复备份</view>
          <view class="setting-desc">恢复最近一次备份</view>
        </view>
      </view>
      <view><text class="setting-arrow">→</text></view>
    </view>
    <view class="setting-row" bindtap="logout">
      <view class="setting-left">
        <view class="setting-icon logout">🚪</view>
        <view>
          <view class="setting-label" style="color: #BF4F1C;">退出登录</view>
          <view class="setting-desc">返回登录界面</view>
        </view>
      </view>
      <view><text class="setting-arrow">→</text></view>
    </view>
  </view>

  <!-- Quick Info -->
  <view class="form-card">
    <view class="form-section-title">最近日志</view>
    <view class="mini-list" wx:if="{{logs.length}}">
      <block wx:for="{{logs}}" wx:key="id">
        <view class="mini-row">
          <view class="mini-title">{{item.module}} · {{item.action}}</view>
          <view class="mini-desc">{{item.detail}} · {{item.createTime}}</view>
        </view>
      </block>
    </view>
    <view class="empty-state" wx:else style="margin-top: 14rpx; padding: 32rpx;">
      <view class="empty-desc">暂无日志记录</view>
    </view>
  </view>
</view>
