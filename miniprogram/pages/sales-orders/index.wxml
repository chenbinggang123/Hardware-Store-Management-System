<view class="screen">
  <view class="section-head">
    <view class="section-title">销售管理</view>
    <view class="btn btn-primary btn-sm" bindtap="openCreate">＋ 新建销售单</view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">销售数据加载中...</view>

  <view class="list" wx:if="{{!loading && salesOrders.length}}">
    <block wx:for="{{salesOrders}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view style="flex:1; min-width:0;">
            <view class="list-title">{{item.orderNumber}}</view>
            <view class="list-meta">客户 ID {{item.customerId}} · 经办人 {{item.operatorId}}</view>
          </view>
          <view class="tag {{item.payStatus === '已付' ? 'tag-success' : item.payStatus === '部分' ? 'tag-warning' : 'tag-danger'}}">{{item.payStatus}}</view>
        </view>
        <view class="list-meta">总金额 ¥{{item.totalAmount}} · 已收 ¥{{item.receivedAmount}} · 欠款 ¥{{item.debtAmount}}</view>
        <view class="list-meta">出库 {{item.status}} · {{item.orderTime}}</view>
        <view class="action-row">
          <view class="btn btn-outline btn-sm" bindtap="openDetail" data-id="{{item.id}}">详情</view>
          <view class="btn btn-outline btn-sm" bindtap="openEdit" data-id="{{item.id}}">编辑</view>
          <view class="btn btn-ghost btn-sm" bindtap="openDetail" data-id="{{item.id}}">确认出库</view>
          <view class="btn btn-ghost btn-sm" bindtap="openDetail" data-id="{{item.id}}">收款登记</view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{!loading && !salesOrders.length}}">
    <text class="empty-icon">📤</text>
    <view class="empty-title">暂无销售单</view>
    <view class="empty-desc">点击右上角新建第一张销售单</view>
  </view>
</view>
