<view class="screen">
  <view class="page-heading">
    <view class="page-heading-copy">
      <view class="page-kicker">销售单据</view>
      <view class="section-title">开单、收款、出库</view>
      <view class="page-description">普通开单直接操作，复杂订单交给小五</view>
    </view>
    <view class="btn btn-primary btn-sm" bindtap="openCreate">＋ 新建</view>
  </view>

  <view class="order-switch"><view class="active">销售单</view><view bindtap="openPurchases">采购单</view></view>

  <view class="stats-strip">
    <view class="stat-item"><view class="stat-value">{{metrics.total}}</view><view class="stat-label">销售单</view></view>
    <view class="stat-item"><view class="stat-value stat-currency">¥{{metrics.totalAmount}}</view><view class="stat-label">单据金额</view></view>
    <view class="stat-item {{metrics.unpaidCount ? 'stat-attention' : ''}}"><view class="stat-value">{{metrics.unpaidCount}}</view><view class="stat-label">待收款</view></view>
  </view>

  <view class="page-widget-row">
    <view class="page-widget-alert {{metrics.unpaidCount ? 'is-warning' : ''}}">
      <view class="page-widget-mark">款</view>
      <view><view class="page-widget-title">待收 ¥{{metrics.debtAmount}}</view><view class="page-widget-desc">点进单据登记收款</view></view>
    </view>
    <view class="agent-assist" bindtap="openAgent"><text>复杂开单</text><text class="agent-assist-arrow">›</text></view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">销售数据加载中...</view>

  <view class="list" wx:if="{{!loading && salesOrders.length}}">
    <block wx:for="{{salesOrders}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view style="flex:1; min-width:0;">
            <view class="list-title">{{item.customerName}}</view>
            <view class="list-meta">单号 {{item.orderNumber}} · {{item.orderTime}}</view>
          </view>
          <view class="tag {{item.payStatus === '已付' ? 'tag-success' : item.payStatus === '部分' ? 'tag-warning' : 'tag-danger'}}">{{item.payStatus}}</view>
        </view>
        <view class="list-meta">总金额 ¥{{item.totalAmount}} · 已收 ¥{{item.receivedAmount}} · 欠款 ¥{{item.debtAmount}}</view>
        <view class="list-meta">出库 {{item.status}} · {{item.orderTime}}</view>
        <view class="ledger-actions">
          <view class="ledger-action primary" bindtap="openDetail" data-id="{{item.id}}">查看与收款</view>
          <view class="ledger-action" bindtap="openEdit" data-id="{{item.id}}">编辑单据</view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{!loading && loadError}}"><text class="empty-icon">!</text><view class="empty-title">销售单加载失败</view><view class="empty-desc">{{loadError}}，请检查网络后重试。</view><view class="state-action" bindtap="retryLoad">重新加载单据</view></view>
  <view class="empty-state" wx:if="{{!loading && !loadError && !salesOrders.length}}">
    <text class="empty-icon">📤</text>
    <view class="empty-title">暂无销售单</view>
    <view class="empty-desc">点击右上角“新建”，开第一张销售单</view>
  </view>
</view>
