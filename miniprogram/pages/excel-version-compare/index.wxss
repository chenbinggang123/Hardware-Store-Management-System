.compare-screen { padding-top: 24rpx; }
.page-kicker { color: #245E9B; font-size: 19rpx; font-weight: 750; letter-spacing: 2rpx; }
.page-title { margin-top: 5rpx; color: #17231E; font-size: 40rpx; font-weight: 750; }
.page-summary { margin-top: 9rpx; color: #64716B; font-size: 23rpx; line-height: 1.65; }
.compare-setup { margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid #CBD5D0; }
.setup-label { color: #66746E; font-size: 24rpx; }
.setup-file { margin-top: 6rpx; overflow: hidden; color: #1F2D27; font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.setup-meta { margin-top: 5rpx; color: #718079; font-size: 24rpx; }
.setup-divider { height: 1rpx; margin: 25rpx 0; background: #D6DEDA; }
.candidate-picker { min-height: 88rpx; margin-top: 12rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; color: #245E9B; background: #FFF; border: 1rpx solid #B9C9D7; font-size: 26rpx; font-weight: 700; }
.candidate-picker text { font-size: 34rpx; }
.no-candidate { margin-top: 14rpx; padding: 22rpx; color: #66746E; background: #F2F5F3; font-size: 24rpx; line-height: 1.65; }
.compare-note { min-height: 84rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-top: 1rpx solid #D6DEDA; border-bottom: 1rpx solid #D6DEDA; font-size: 24rpx; }
.compare-note text:first-child { color: #718079; }
.compare-note text:last-child { color: #26332E; text-align: right; }
.start-compare { height: 88rpx; margin-top: 26rpx; color: #FFF; background: #245E9B; font-size: 27rpx; font-weight: 700; }
.start-compare[disabled] { color: #7F8A84; background: #DDE3E0; }
.inline-error { margin-top: 16rpx; color: #A83F32; font-size: 24rpx; }
.version-line { margin-top: 25rpx; padding: 20rpx 0; display: grid; grid-template-columns: 1fr 44rpx 1fr; align-items: center; border-top: 1rpx solid #CBD5D0; border-bottom: 1rpx solid #CBD5D0; }
.version-block { min-width: 0; }
.version-block > view:nth-child(2) { margin-top: 5rpx; overflow: hidden; color: #24322B; font-size: 22rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.version-block > text { color: #7A867F; font-size: 18rpx; }
.version-label { color: #7B8780; font-size: 18rpx; }
.current .version-label { color: #245E9B; font-weight: 750; }
.version-arrow { color: #245E9B; font-size: 26rpx; text-align: center; }
.progress-panel, .terminal-state { margin-top: 24rpx; padding: 22rpx; background: #FFF; border-left: 6rpx solid #245E9B; }
.progress-title, .terminal-state view { color: #26332E; font-size: 28rpx; font-weight: 700; }
.progress-track { height: 10rpx; margin-top: 20rpx; overflow: hidden; background: #DDE4E0; }
.progress-value { height: 100%; background: #245E9B; }
.progress-meta { margin-top: 14rpx; display: flex; justify-content: space-between; color: #66746E; font-size: 24rpx; }
.progress-meta text:last-child { color: #A83F32; font-weight: 700; }
.progress-hint, .terminal-state text { margin-top: 8rpx; display: block; color: #718079; font-size: 24rpx; }
.terminal-state.danger { border-color: #B94C3A; }
.partial-note { margin-top: 22rpx; padding: 18rpx; color: #7A4B0A; background: #FFF0D5; border-left: 6rpx solid #B87418; font-size: 24rpx; line-height: 1.6; }
.compare-summary { margin: 21rpx 0; display: grid; grid-template-columns: repeat(4, 1fr); background: #FFF; border: 1rpx solid #D7DEDA; }
.compare-summary view { min-height: 94rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1rpx solid #E2E7E4; }
.compare-summary view:last-child { border-right: 0; }
.compare-summary text:first-child { color: #B87418; font-size: 29rpx; font-weight: 750; }
.compare-summary text:last-child { color: #77827D; font-size: 17rpx; }
.compare-summary .added text:first-child { color: #247052; }
.compare-summary .quiet text:first-child { color: #7E8983; }
.filter-strip { margin: 0 -24rpx 18rpx; padding-left: 24rpx; white-space: nowrap; }
.filter-list { display: inline-flex; padding-right: 40rpx; gap: 12rpx; }
.filter-chip { min-height: 64rpx; padding: 0 24rpx; display: inline-flex; align-items: center; color: #59665F; background: #E8ECEA; font-size: 24rpx; }
.filter-chip.active { color: #245E9B; background: #E7F0F8; font-weight: 700; }
.difference-list { border-top: 1rpx solid #CBD5D0; }
.difference-row { padding: 20rpx 0 21rpx; border-bottom: 1rpx solid #D7DEDA; }
.difference-row.added { margin: 0 -10rpx; padding-left: 10rpx; padding-right: 10rpx; background: #F0F8F3; border-left: 5rpx solid #247052; }
.row-index { color: #7D8882; font-size: 18rpx; }
.row-title { margin-top: 4rpx; display: flex; justify-content: space-between; gap: 20rpx; color: #1E2C26; font-size: 25rpx; font-weight: 750; }
.row-title text:last-child { color: #B87418; font-size: 19rpx; }
.added .row-title text:last-child { color: #247052; }
.row-spec { color: #6D7973; font-size: 19rpx; }
.issue-message { margin-top: 10rpx; color: #A83F32; font-size: 24rpx; }
.change-line { margin-top: 15rpx; }
.change-label { color: #5E6C65; font-size: 24rpx; font-weight: 700; }
.change-label text { color: #B87418; }
.difference-flow { margin-top: 13rpx; display: grid; grid-template-columns: 1fr 40rpx 1fr; align-items: center; }
.difference-flow > view:not(.flow-arrow) { padding: 10rpx 12rpx; background: #EEF1EF; }
.difference-flow > view:last-child { background: #E7F0F8; }
.difference-flow text { display: block; color: #7A867F; font-size: 17rpx; }
.difference-flow text:last-child { margin-top: 2rpx; color: #26342D; font-size: 22rpx; font-weight: 700; }
.flow-arrow { color: #245E9B; font-size: 23rpx; text-align: center; }
.product-link { min-height: 58rpx; margin-top: 8rpx; display: flex; align-items: center; color: #245E9B; font-size: 24rpx; font-weight: 700; }
.empty-ledger { padding: 60rpx 0; color: #718079; font-size: 25rpx; text-align: center; }
.load-more { height: 88rpx; margin-top: 24rpx; color: #245E9B; background: #FFF; border: 1rpx solid #B9C9D7; font-size: 26rpx; }
.bottom-safe-space { height: 170rpx; }
.selection-note { color: #6C7872; font-size: 20rpx; }
.fixed-action.fixed-split { display: grid; grid-template-columns: 150rpx 1fr; align-items: center; gap: 16rpx; }
