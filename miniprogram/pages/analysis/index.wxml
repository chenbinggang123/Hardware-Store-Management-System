<view class="screen">
  <view class="hero-card">
    <view class="hero-eyebrow">INSIGHT</view>
    <view class="hero-title">经营数据看板</view>
    <view class="hero-subtitle">聚合核心指标和趋势视图，帮助快速判断该补货、该催款还是该压采购。</view>
    <view class="top-actions">
      <view class="btn btn-primary btn-sm" bindtap="openReportCenter">报表中心</view>
      <view class="btn btn-outline btn-sm" bindtap="openExport">数据导出</view>
    </view>
  </view>

  <view class="grid-2" style="margin-top: 20rpx;">
    <view class="data-card">
      <view class="metric-label">📥 采购总额</view>
      <view class="metric-value">¥{{report.purchase || 0}}</view>
    </view>
    <view class="data-card">
      <view class="metric-label">📤 销售总额</view>
      <view class="metric-value">¥{{report.sales || 0}}</view>
    </view>
    <view class="data-card">
      <view class="metric-label">⚠️ 库存预警</view>
      <view class="metric-value" style="color: {{report.inventoryWarnings > 0 ? '#BF4F1C' : '#1A1410'}};">{{report.inventoryWarnings || 0}}</view>
    </view>
    <view class="data-card">
      <view class="metric-label">📊 报表类型</view>
      <view class="metric-value" style="font-size: 28rpx;">{{report.label || '日报'}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">分析视图</view>
    <view class="section-subtitle">图表区域已预留，后续可直接接入真实统计接口。</view>
    <view class="list" style="margin-top: 16rpx;">
      <block wx:for="{{quickCharts}}" wx:key="label">
        <view class="list-card">
          <view class="list-title" style="font-size: 26rpx;">{{item.label}}</view>
          <view class="list-meta">{{item.value}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
