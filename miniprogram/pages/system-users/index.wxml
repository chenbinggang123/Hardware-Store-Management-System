<view class="screen">
  <view class="section-head">
    <view class="section-title">用户管理</view>
    <view class="text-muted">{{users.length}} 个账号</view>
  </view>

  <view class="list" wx:if="{{users.length}}">
    <block wx:for="{{users}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view style="display:flex; align-items:center; gap: 16rpx;">
            <view class="avatar" style="width: 64rpx; height: 64rpx; font-size: 24rpx;">{{item.initial}}</view>
            <view style="flex:1; min-width:0;">
              <view class="list-title">{{item.name}}</view>
              <view class="list-meta">{{item.username}} · {{item.phone}}</view>
            </view>
          </view>
          <view class="tag {{item.role === '老板' ? 'tag-warning' : 'tag-info'}}">{{item.role}}</view>
        </view>
        <view class="list-meta">状态 {{item.status === 1 ? '启用' : '停用'}} · 创建时间 {{item.createTime}}</view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">👥</text>
    <view class="empty-title">暂无用户数据</view>
  </view>
</view>
