.detail-head { display: flex; align-items: center; gap: 18rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid #CED8D3; }
.book-badge { width: 72rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; color: #17231E; background: #F2B84B; border-left: 10rpx solid #174C5B; font-size: 30rpx; font-weight: 800; }
.detail-copy { min-width: 0; }.book-code { color: #718079; font: 21rpx monospace; }.detail-title { margin-top: 4rpx; color: #17231E; font-size: 41rpx; font-weight: 800; }.detail-contact { color: #52605A; font-size: 23rpx; }
.detail-actions { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.detail-actions .btn:first-child { grid-column: 1 / -1; }
.month-line { margin-top: 24rpx; min-height: 76rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #245E9B; background: #E8F1F8; font-size: 24rpx; font-weight: 700; }.month-line text { color: #52605A; font-weight: 500; }
.money-grid { display: grid; grid-template-columns: 1fr 1fr; background: #FFF; border: 1rpx solid #CED8D3; border-top: 0; }.money-grid > view { min-height: 122rpx; padding: 20rpx; box-sizing: border-box; border-right: 1rpx solid #E0E6E3; border-bottom: 1rpx solid #E0E6E3; }.money-grid > view:nth-child(2n) { border-right: 0; }.money-grid text { display: block; color: #66746E; font-size: 23rpx; }.money-grid .money-value { margin-top: 7rpx; display: block; color: #17231E; font-size: 34rpx; font-weight: 800; }.money-grid .green { color: #247052; }.money-grid .balance { grid-column: 1 / -1; border: 0; background: #FFF5E4; }.money-grid .balance .money-value { color: #A83F32; font-size: 42rpx; }
.flow-section { margin-top: 34rpx; }.transaction-list { border-top: 1rpx solid #CED8D3; border-bottom: 1rpx solid #CED8D3; background: #FFF; }.transaction-row { padding: 22rpx 16rpx; display: grid; grid-template-columns: 130rpx minmax(0,1fr) auto; gap: 14rpx; border-bottom: 1rpx solid #DCE3DF; }.transaction-row:last-child { border-bottom: 0; }.transaction-date { color: #52605A; font: 22rpx monospace; }.receipt { margin-left: 10rpx; color: #718079; font-size: 21rpx; }.type-tag { padding: 5rpx 10rpx; color: #245E9B; background: #E8F1F8; font-size: 21rpx; font-weight: 700; }.type-tag.type-RETURN, .type-tag.type-PAYMENT { color: #216846; background: #E2F2E9; }.transaction-content { margin-top: 8rpx; color: #26332E; font-size: 25rpx; line-height: 1.55; }.transaction-remark { margin-top: 5rpx; color: #718079; font-size: 21rpx; }.transaction-money { padding-top: 2rpx; font-size: 27rpx; font-weight: 800; white-space: nowrap; }.transaction-money.plus { color: #A83F32; }.transaction-money.minus { color: #247052; }
@media (max-width: 340px) { .transaction-row { grid-template-columns: 1fr auto; }.transaction-date { grid-column: 1 / -1; } }
.ledger-edit { flex: 0 0 auto; margin-left: auto; padding: 10rpx 16rpx; border-radius: 10rpx; color: #245E9B; background: #E8F0F7; font-size: 22rpx; font-weight: 700; }
.transaction-row.is-reversed .transaction-content, .transaction-row.is-reversed .transaction-money { color: #9AA39F; text-decoration: line-through; }
.reversed-tag { margin-left: 10rpx; padding: 4rpx 8rpx; color: #7A561E; background: #FFF0D5; font-size: 19rpx; }
.reverse-link { display: inline-block; margin-top: 8rpx; color: #A84A36; font-size: 21rpx; }
