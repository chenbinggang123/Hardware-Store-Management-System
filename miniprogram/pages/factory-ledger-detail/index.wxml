<view class="screen" wx:if="{{loading}}"><view class="loading-state">正在读取单据…</view></view>
<view class="screen" wx:elif="{{error}}"><view class="error-state"><view class="error-state-title">账本暂时加载失败</view><view>{{error}}</view><view class="state-action" role="button" bindtap="loadData">重新加载</view></view></view>
<view class="screen" wx:elif="{{ledger}}">
  <view class="detail-head"><view class="book-badge">{{supplier ? '进' : '账'}}</view><view class="detail-copy"><view class="detail-title">{{ledger.factoryName}}</view><view class="detail-contact">{{ledger.contactPerson || ledger.phone ? (ledger.contactPerson || '') + ' ' + (ledger.phone || '') : '未填联系方式'}}</view></view><view class="head-links"><view class="ledger-edit" wx:if="{{supplier}}" role="button" bindtap="openProducts">商品</view><view class="ledger-edit" role="button" bindtap="editLedger">资料</view></view></view>
  <!-- 最重要的数字放最上面 -->
  <view class="balance-summary"><text>{{supplier ? '我们还欠这家' : '这家还需付'}}</text><view class="balance-value">¥{{ledger.totalDueAmount || '0.00'}}</view><text class="balance-credit" wx:if="{{ledger.creditCents > 0}}">{{supplier ? '已多付给他' : '已多付'}} ¥{{ledger.creditAmount}}</text></view>
  <!-- 一行搞定：左边下拉选月份和单据类型，右边两个小按钮 -->
  <view class="document-filters"><picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange"><view class="pick">{{month}}</view></picker><picker range="{{filterNames}}" value="{{filterIndex}}" bindchange="pickFilter"><view class="pick">{{filterIndex ? filterNames[filterIndex] : '全部单据'}}</view></picker><view class="detail-actions"><view class="btn btn-primary btn-sm" role="button" bindtap="addPurchase">{{supplier ? '记进货' : '开单'}}</view><view class="btn btn-outline btn-sm" role="button" bindtap="addPayment">{{supplier ? '付款' : '收款'}}</view></view></view>
  <view class="document-list" wx:if="{{visibleDocuments.length}}">
    <view class="document-sheet" wx:for="{{visibleDocuments}}" wx:key="id">
      <view class="document-top" role="button" aria-expanded="{{expandedId === item.id}}" data-id="{{item.id}}" bindtap="toggleDocument"><view class="document-copy"><view class="document-name">{{item.title}}<text class="document-date">{{item.date}}</text></view><view class="document-hint">{{item.type === 'PAYMENT' ? (item.receiptNo || '') : item.items.length + ' 项商品'}}<text wx:if="{{item.type !== 'PAYMENT' && item.receiptNo}}"> · {{item.receiptNo}}</text></view></view><view class="document-amount">¥{{item.amount}}<text class="document-chevron">{{expandedId === item.id ? '▴' : '▾'}}</text></view></view>
      <view class="document-details" wx:if="{{expandedId === item.id}}">
        <view class="document-item" wx:for="{{item.detailItems}}" wx:for-item="line" wx:key="index"><view>{{line.productName}} {{line.specification || ''}}</view><text>{{line.quantity}} {{line.unit || ''}} × ¥{{line.priceText}}</text></view>
        <view class="document-note" wx:if="{{item.remark}}">{{item.remark}}</view>
        <view class="document-controls"><view wx:if="{{item.documentId}}" class="document-open" role="button" data-id="{{item.documentId}}" bindtap="openDocument">看完整单据</view><view class="document-delete" role="button" data-id="{{item.id}}" bindtap="deleteDocument">删除</view></view>
      </view>
    </view>
  </view>
  <view class="empty-state" wx:else><view class="empty-title">{{documents.length ? '这个月没有这类单据' : '这个月还没有单据'}}</view><view class="state-action" role="button" bindtap="addPurchase">{{supplier ? '记一笔进货' : '去开单'}}</view></view>
</view>
