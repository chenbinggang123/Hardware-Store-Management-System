<view class="screen" wx:if="{{loading}}"><view class="loading-state">正在读取单据…</view></view>
<view class="screen" wx:elif="{{error}}"><view class="error-state"><view class="error-state-title">账本暂时加载失败</view><view>{{error}}</view><view class="state-action" role="button" bindtap="loadData">重新加载</view></view></view>
<view class="screen" wx:elif="{{ledger}}">
  <view class="detail-head"><view class="book-badge">账</view><view class="detail-copy"><view class="detail-title">{{ledger.factoryName}}</view><view class="detail-contact">{{ledger.contactPerson || '未填联系人'}} · {{ledger.phone || '未填电话'}}</view></view><view class="ledger-edit" role="button" bindtap="editLedger">资料</view></view>
  <view class="detail-actions"><view class="btn btn-primary" role="button" bindtap="addPurchase">开单（拿货 / 退货）</view><view class="btn btn-outline" role="button" bindtap="addPayment">收款</view></view>
  <view class="month-line"><picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange"><view>{{month}} 月账 ›</view></picker><text>{{documents.length}} 张单据</text></view>
  <view class="balance-summary"><view><text>这家工厂总共还需付</text><view class="balance-value">¥{{ledger.totalDueAmount || '0.00'}}</view><text wx:if="{{ledger.creditCents > 0}}">已多付 ¥{{ledger.creditAmount}}</text></view></view>
  <view class="section-head flow-section"><view><view class="section-title">翻单据</view><view class="section-subtitle">按日期从新到旧，点开查看明细</view></view></view>
  <view class="document-filters"><view wx:for="{{filters}}" wx:key="value" class="document-filter {{type === item.value ? 'active' : ''}}" role="button" aria-pressed="{{type === item.value}}" data-type="{{item.value}}" bindtap="filterDocuments">{{item.label}}</view></view>
  <view class="document-list" wx:if="{{visibleDocuments.length}}">
    <view class="document-sheet" wx:for="{{visibleDocuments}}" wx:key="id">
      <view class="document-top" role="button" aria-expanded="{{expandedId === item.id}}" data-id="{{item.id}}" bindtap="toggleDocument"><view class="document-copy"><view class="document-date">{{item.date}}</view><view class="document-name">{{item.title}}<text class="document-number" wx:if="{{item.receiptNo}}">{{item.receiptNo}}</text></view><view class="document-hint">{{item.type === 'PAYMENT' ? '查看收款记录' : item.items.length + ' 项商品 · 点击翻开'}}</view></view><view class="document-amount">¥{{item.amount}}<view class="document-chevron">{{expandedId === item.id ? '收起' : '展开'}} ›</view></view></view>
      <view class="document-details" wx:if="{{expandedId === item.id}}">
        <view class="document-item" wx:for="{{item.detailItems}}" wx:for-item="line" wx:key="index"><view>{{line.productName}} {{line.specification || ''}}</view><text>{{line.quantity}} {{line.unit || ''}} × ¥{{line.priceText}}</text></view>
        <view class="document-note" wx:if="{{item.remark}}">{{item.remark}}</view>
        <view class="document-controls"><view wx:if="{{item.documentId}}" class="document-open" role="button" data-id="{{item.documentId}}" bindtap="openDocument">查看完整单据</view><view class="document-delete" role="button" data-id="{{item.id}}" bindtap="deleteDocument">删除这张{{item.title}}</view></view>
      </view>
    </view>
  </view>
  <view class="empty-state" wx:else><view class="empty-title">{{documents.length ? '这个月没有该类单据' : '这个月还没有单据'}}</view><view class="empty-desc">拿货和退货都在开单处填写，保存后就能在这里翻看。</view><view class="state-action" role="button" bindtap="addPurchase">去开单</view></view>
</view>
