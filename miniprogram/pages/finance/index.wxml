<view class="screen finance-screen">
  <view class="finance-head"><view><view class="page-kicker">往来账</view><view class="finance-title">账款和付款</view><view class="finance-subtitle">按客户或厂商查看本月发生、已付和当前余额</view></view><picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange"><view class="month-button" role="button" aria-label="选择账期">{{month}} ›</view></picker></view>
  <view class="finance-summary" aria-label="往来账汇总"><view class="finance-total"><text>当前待收</text><text class="finance-total-value">¥{{summary.pendingText}}</text><text>{{summary.pendingCount}} 个往来对象仍有余额</text></view><view class="finance-split three"><view><text>本月发生</text><text>¥{{summary.dueText}}</text></view><view><text>本月已收</text><text>¥{{summary.paidText}}</text></view><view><text>当前待收</text><text>¥{{summary.pendingText}}</text></view></view></view>
  <view class="finance-tools"><view class="finance-toolbar"><view class="finance-tabs" role="tablist" aria-label="往来对象类型"><view class="finance-tab {{type === 'all' ? 'active' : ''}}" role="tab" aria-selected="{{type === 'all'}}" data-type="all" bindtap="selectType">全部</view><view class="finance-tab {{type === 'customer' ? 'active' : ''}}" role="tab" aria-selected="{{type === 'customer'}}" data-type="customer" bindtap="selectType">客户</view><view class="finance-tab {{type === 'factory' ? 'active' : ''}}" role="tab" aria-selected="{{type === 'factory'}}" data-type="factory" bindtap="selectType">厂商</view></view><picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange"><view class="sort-button" role="button" aria-label="财务列表排序">{{sortOptions[sortIndex]}} ›</view></picker></view><view class="search-box"><text class="search-icon">查</text><input class="search-input" aria-label="搜索客户或厂商" placeholder="搜索客户、厂商或电话" value="{{keyword}}" bindinput="onKeywordInput" /></view></view>
  <view class="loading-state" wx:if="{{loading}}">正在汇总往来账…</view>
  <view class="error-state" wx:elif="{{loadError}}"><view class="error-state-title">财务数据没有加载成功</view><view>{{loadError}}</view><view class="state-action" bindtap="retryLoad">重新加载</view></view>
  <view class="finance-list" wx:elif="{{visible.length}}"><view class="finance-row" wx:for="{{visible}}" wx:key="key" role="button" aria-label="查看{{item.name}}往来账" data-key="{{item.key}}" bindtap="openRow"><view class="finance-mark {{item.type}}">{{item.mark}}</view><view class="finance-copy"><view class="finance-name">{{item.name}}</view><view class="finance-meta">{{item.typeText}} · 最近 {{item.recentText}}</view><view class="finance-flow">本月 ¥{{item.periodAmountText}} · 已付 ¥{{item.periodPaidText}}</view></view><view class="finance-money"><text class="{{item.balance > 0 ? 'owing' : ''}}">{{item.statusText}} ¥{{item.balanceText}}</text><text>查看明细 ›</text></view></view></view>
  <view class="empty-state" wx:else><view class="empty-icon">账</view><view class="empty-title">{{keyword ? '没有找到往来对象' : '还没有往来账'}}</view><view class="empty-desc">{{keyword ? '换个名称或电话号码试试。' : '把客户或厂商单据发给小五，确认后会在这里汇总。'}}</view><view class="state-action" wx:if="{{!keyword}}" bindtap="openAgent">交给小五处理</view></view>
</view>
