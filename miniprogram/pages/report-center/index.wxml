<view class="screen">
  <view class="hero-card">
    <view class="hero-eyebrow">REPORT CENTER</view>
    <view class="hero-title">报表中心</view>
    <view class="hero-subtitle">聚合日报、月报、年报和经营明细，方便老板快速判断。</view>
  </view>

  <view class="grid-2" style="margin-top: 20rpx;" wx:if="{{daily}}">
    <view class="data-card">
      <view class="metric-label">日报销售</view>
      <view class="metric-value">¥{{daily.sales}}</view>
    </view>
    <view class="data-card">
      <view class="metric-label">月报采购</view>
      <view class="metric-value">¥{{monthly.purchase}}</view>
    </view>
    <view class="data-card">
      <view class="metric-label">年报销售</view>
      <view class="metric-value">¥{{yearly.sales}}</view>
    </view>
    <view class="data-card" style="border: 2rpx solid rgba(196, 86, 42, 0.2);">
      <view class="metric-label">库存预警</view>
      <view class="metric-value" style="color: {{inventoryReport.warningCount > 0 ? '#B95034' : '#182126'}};">{{inventoryReport.warningCount}}</view>
    </view>
  </view>

  <view class="form-card" wx:if="{{purchaseReport}}">
    <view class="form-section-title">采购统计</view>
    <view class="detail-grid">
      <view class="detail-item"><view class="detail-label">采购单数量</view><view class="detail-value">{{purchaseReport.count}}</view></view>
      <view class="detail-item"><view class="detail-label">采购总额</view><view class="detail-value">¥{{purchaseReport.totalAmount}}</view></view>
    </view>
  </view>

  <view class="form-card" wx:if="{{salesReport}}">
    <view class="form-section-title">销售统计</view>
    <view class="detail-grid">
      <view class="detail-item"><view class="detail-label">销售单数量</view><view class="detail-value">{{salesReport.count}}</view></view>
      <view class="detail-item"><view class="detail-label">已收金额</view><view class="detail-value" style="color: #247A55;">¥{{salesReport.receivedAmount}}</view></view>
    </view>
  </view>

  <view class="form-card" wx:if="{{inventoryReport}}">
    <view class="form-section-title">库存统计</view>
    <view class="detail-grid">
      <view class="detail-item"><view class="detail-label">库存记录数</view><view class="detail-value">{{inventoryReport.totalInventoryRecords}}</view></view>
      <view class="detail-item"><view class="detail-label">预警数量</view><view class="detail-value" style="color: {{inventoryReport.warningCount > 0 ? '#B95034' : '#182126'}};">{{inventoryReport.warningCount}}</view></view>
    </view>
  </view>
</view>
