page{background:#F3F5F2}.editor-screen{padding:22rpx 22rpx 0}.loading-state,.error-state{margin-top:180rpx;text-align:center;color:#68756F;font-size:25rpx;line-height:1.65}.error-title{color:#17231E;font-size:31rpx;font-weight:750}.retry-button{width:240rpx;margin:30rpx auto 0;color:#245E9B;background:#E8F0F7;font-size:25rpx}.retry-button::after{border:0}.editor-head{padding:22rpx;border-left:7rpx solid #245E9B;background:#FFF}.head-label{color:#68756F;font-size:21rpx;font-weight:650}.title-input{height:76rpx;margin-top:8rpx;padding:0 16rpx;border:1rpx solid #CBD5D0;border-radius:12rpx;color:#17231E;background:#F8FAF9;font-size:27rpx;box-sizing:border-box}.head-note{margin-top:12rpx;color:#68756F;font-size:21rpx;line-height:1.55}.sheet-tabs{margin:20rpx -22rpx 0;padding:0 22rpx;white-space:nowrap;box-sizing:border-box}.sheet-tab{min-height:68rpx;margin-right:10rpx;padding:0 22rpx;display:inline-flex;align-items:center;border-radius:999rpx;color:#40504A;background:#FFF;font-size:23rpx}.sheet-tab.active{color:#FFF;background:#245E9B;font-weight:700}.sheet-summary{min-height:84rpx;margin-top:20rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx}.sheet-summary>view:first-child{display:flex;flex-direction:column}.sheet-summary>view:first-child text:first-child{color:#17231E;font-size:29rpx;font-weight:750}.sheet-summary>view:first-child text:last-child{margin-top:3rpx;color:#68756F;font-size:20rpx}.add-row{min-height:64rpx;padding:0 18rpx;display:flex;align-items:center;border-radius:12rpx;color:#245E9B;background:#E8F0F7;font-size:23rpx;font-weight:700}.truncated-note{margin-bottom:14rpx;padding:16rpx;border-left:6rpx solid #B87418;color:#784D15;background:#FFF0D5;font-size:21rpx;line-height:1.55}.row-card{margin-bottom:16rpx;padding:0 20rpx 8rpx;border:1rpx solid #D5DDDA;border-radius:16rpx;background:#FFF}.row-head{min-height:72rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #E4E9E6;color:#17231E;font-size:23rpx;font-weight:700}.row-actions{display:flex;align-items:center;gap:8rpx}.row-actions text{min-width:76rpx;min-height:54rpx;display:flex;align-items:center;justify-content:center;color:#245E9B;font-size:21rpx}.row-actions .danger{color:#A83F32}.cell-field{padding:15rpx 0;border-bottom:1rpx solid #EDF0EE}.cell-field:last-child{border-bottom:0}.cell-label{margin-bottom:7rpx;color:#5F6E67;font-size:20rpx;font-weight:650}.cell-input{min-height:70rpx;padding:10rpx 14rpx;border:1rpx solid #CBD5D0;border-radius:10rpx;color:#17231E;background:#F8FAF9;font-size:25rpx;box-sizing:border-box}.cell-input:focus{border-color:#245E9B;background:#FFF}.empty-sheet{padding:80rpx 30rpx;text-align:center;color:#68756F;font-size:24rpx;line-height:1.7}.bottom-space{height:170rpx}.save-bar{position:fixed;z-index:8;right:0;bottom:0;left:0;padding:14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:18rpx;border-top:1rpx solid #D5DDDA;background:#FFF}.save-state{flex:1;color:#68756F;font-size:20rpx}.save-button{width:270rpx;height:82rpx;margin:0;color:#FFF;background:#245E9B;border-radius:13rpx;font-size:26rpx;font-weight:750;line-height:82rpx}.save-button::after{border:0}.save-button[disabled]{color:#82908A;background:#E1E6E3}
