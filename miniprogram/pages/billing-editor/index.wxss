.line-item .line-card { margin: 0 0 8rpx; padding: 2rpx 10rpx 4rpx; border-radius: 10rpx; }
.primary-grid { grid-template-columns: 1.4fr 1fr; gap: 10rpx; }
.number-grid { grid-template-columns: 1fr 1fr 1fr; gap: 10rpx; }
.unit-input { position: relative; }
.unit-input input { padding-right: 48rpx; }
.unit-pick { position: absolute; top: 0; right: 0; width: 48rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; color: #245E9B; font-size: 22rpx; }
.line-head { min-height: 56rpx; margin-top: 8rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #E2E8E5; border-bottom: 0; }
.line-collapse { color: #245E9B !important; font-size: 23rpx !important; }
.line-review-note { margin-top: 6rpx; padding: 6rpx 10rpx; font-size: 21rpx; }
.source-note { font-size: 20rpx; }
.add-area { margin-top: 6rpx; padding-top: 8rpx; border-top: 1rpx dashed #CBD6D0; }
.search-row { height: 66rpx; margin-top: 0; padding: 0 12rpx; gap: 8rpx; border-radius: 10rpx; }
.search-plus { color: #247052 !important; font-size: 30rpx !important; font-weight: 700; }
.search-row input { height: 64rpx; font-size: 25rpx; }
.add-line { flex: 0 0 auto; min-height: 0; padding: 0 4rpx; display: inline; color: #245E9B; background: none; font-size: 23rpx; font-weight: 700; }
.candidate-list, .inline-candidates { margin-top: 8rpx; }
.candidate-row { gap: 8rpx; }
.candidate { width: auto; min-width: 0; max-width: 300rpx; min-height: 0; height: 56rpx; padding: 0 16rpx; display: inline-flex; flex-direction: row; align-items: center; overflow: hidden; border-radius: 28rpx; color: #18231E; background: #F2F8F5; border-color: #BDD2C7; font-size: 24rpx; white-space: nowrap; text-overflow: ellipsis; }
.candidate text { margin-left: 4rpx; color: #247052; font-size: 22rpx; }
.candidate-empty { padding: 10rpx 4rpx 2rpx; color: #78847E; font-size: 22rpx; }
.source-evidence { margin-bottom: 12rpx; padding: 12rpx 16rpx; border-radius: 12rpx; font-size: 22rpx; }
.source-evidence-head { font-weight: 700; }
.preview-wrap { margin-top: 0; }
.preview-hint { min-height: 52rpx; font-size: 21rpx; }
.ledger-card, .fix-card, .image-export-card { margin-top: 10rpx; margin-bottom: 10rpx; padding: 12rpx 16rpx; border-radius: 12rpx; }
.ledger-card text:first-child, .fix-card text:first-child, .image-export-card text:first-child { font-size: 24rpx; }
.ledger-card text:last-child, .fix-card text:last-child, .image-export-card text:last-child { font-size: 21rpx; }
.ledger-action, .image-export-action { min-height: 52rpx; padding: 0 14rpx; border-radius: 8rpx; font-size: 22rpx; }
.action-notice { padding: 12rpx 16rpx; }
.action-notice text:first-child { font-size: 23rpx; }
.action-notice text:last-child { font-size: 21rpx; }
.billing-bar { min-height: 92rpx; padding: 10rpx 20rpx calc(10rpx + env(safe-area-inset-bottom)); gap: 12rpx; }
.billing-summary > text { font-size: 21rpx; }
.billing-summary-value { font-size: 32rpx; }
.billing-summary-status { font-size: 19rpx; }
.secondary-action, .primary-action { min-height: 64rpx; padding: 0 20rpx; border-radius: 10rpx; font-size: 25rpx; }
.bottom-space { height: 140rpx; }
@media (max-width: 340px) { .row-qty, .row-price { width: 84rpx; } .row-amount { width: 100rpx; } .line-row { font-size: 23rpx; } .secondary-action, .primary-action { padding: 0 14rpx; font-size: 23rpx; } }
