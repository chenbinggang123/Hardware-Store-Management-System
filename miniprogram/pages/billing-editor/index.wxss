.line-review-note { margin-top: 9rpx; padding: 9rpx 11rpx; border-radius: 9rpx; color: #8A5610; background: #FFF1D2; font-size: 19rpx; line-height: 1.45; }
.unit-choices { margin-top: 8rpx; display: flex; flex-wrap: wrap; gap: 6rpx; }
.unit-choices view { min-height: 44rpx; padding: 0 14rpx; display: flex; align-items: center; border-radius: 9rpx; color: #245E9B; background: #E8F0F7; font-size: 20rpx; }
.line-detail-toggle { min-height: 46rpx; margin-top: 5rpx; padding: 0 5rpx; display: inline-flex; align-items: center; color: #245E9B; font-size: 20rpx; font-weight: 650; }
.compact-remark { margin-top: 4rpx; }
.source-note { margin-top: 8rpx; display: flex; flex-wrap: wrap; gap: 6rpx; color: #70551E; font-size: 18rpx; }
.source-note text { padding: 6rpx 10rpx; border-radius: 8rpx; background: #FFF3DC; }
.source-evidence { margin-bottom: 18rpx; padding: 20rpx 22rpx; border: 1rpx solid #E1D1B2; border-radius: 16rpx; color: #695B42; background: #FFF9ED; font-size: 22rpx; line-height: 1.65; }
.source-evidence-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.source-evidence-head > text { flex: 0 0 auto; color: #8A5A0A; font-weight: 700; }
.source-evidence-body { margin-top: 16rpx; padding-top: 15rpx; border-top: 1rpx solid #EADDC5; white-space: pre-wrap; }
.preview-wrap { margin-top: 20rpx; }
.preview-hint { min-height: 68rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: space-between; color: #53615A; background: #E2EAE6; font-size: 21rpx; border-radius: 14rpx 14rpx 0 0; }
.preview-hint view { color: #985F10; font-weight: 700; }
.receipt-paper { padding: 36rpx 24rpx 30rpx; border: 1rpx solid #C8D0CC; border-top: 0; background: #FFFFFF; box-shadow: 0 12rpx 32rpx rgba(25, 40, 34, .08); }
.receipt-company { font-family: serif; color: #111; font-size: 35rpx; font-weight: 700; text-align: center; }
.receipt-title { margin-top: 8rpx; color: #111; font-size: 31rpx; font-weight: 800; letter-spacing: 12rpx; text-align: center; }
.receipt-number { margin-top: 7rpx; color: #4A4A4A; font-size: 18rpx; text-align: center; }
.receipt-rule { height: 3rpx; margin: 20rpx 0 13rpx; background: #111; }
.receipt-info { display: grid; grid-template-columns: 1.25fr 1fr 1.15fr; gap: 10rpx; margin-bottom: 13rpx; }
.receipt-info view { min-width: 0; display: flex; gap: 8rpx; font-size: 18rpx; }
.receipt-info text { color: #656565; }
.receipt-info-value { overflow: hidden; color: #111; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.receipt-table { border-top: 2rpx solid #111; border-left: 2rpx solid #111; }
.receipt-row { min-height: 64rpx; display: flex; border-bottom: 1rpx solid #222; color: #111; font-size: 17rpx; box-sizing: border-box; }
.receipt-row text { min-width: 0; padding: 8rpx 5rpx; display: flex; align-items: center; justify-content: center; border-right: 1rpx solid #222; box-sizing: border-box; word-break: break-all; text-align: center; }
.receipt-row.receipt-header { min-height: 52rpx; font-weight: 750; background: #F2F2F0; }
.col-no { width: 7%; }.col-name { width: 25%; }.col-spec { width: 17%; }.col-unit { width: 10%; }.col-qty { width: 11%; }.col-price { width: 14%; }.col-amount { width: 16%; }
.receipt-total { height: 68rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 17rpx; border-right: 2rpx solid #111; border-bottom: 2rpx solid #111; color: #111; }
.receipt-total text { font-size: 21rpx; font-weight: 700; }
.receipt-total-value { font-size: 27rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.receipt-footer { padding: 14rpx 4rpx 0; color: #222; font-size: 18rpx; }
.receipt-footer > view:first-child { display: flex; gap: 10rpx; }
.receipt-footer text { color: #666; }
.receipt-footer .receipt-footer-value { color: #222; font-weight: 650; }
.receipt-notice { margin-top: 9rpx; color: #555; line-height: 1.5; }
.image-export-card { margin-top: 16rpx; padding: 19rpx 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border: 1rpx solid #C8D7CF; border-radius: 15rpx; background: #FFFFFF; }
.image-export-card > view:first-child { min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.image-export-card text:first-child { color: #18231E; font-size: 24rpx; font-weight: 750; }
.image-export-card text:last-child { color: #75817B; font-size: 20rpx; }
.image-export-action { flex: 0 0 auto; min-height: 58rpx; padding: 0 16rpx; display: flex; align-items: center; border-radius: 11rpx; color: #FFFFFF; background: #247052; font-size: 22rpx; font-weight: 700; }
.billing-image-canvas { position: fixed; z-index: -10; top: 0; left: -2000px; width: 1120px; height: 1px; opacity: 0; pointer-events: none; }
.action-notice { margin: 0 0 18rpx; padding: 18rpx 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border: 1rpx solid #E5B9AD; border-left: 6rpx solid #B94C3A; border-radius: 14rpx; color: #7E352A; background: #FFF0EC; }
.action-notice > view:first-child { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.action-notice text:first-child { font-size: 23rpx; font-weight: 750; }
.action-notice text:last-child { font-size: 20rpx; line-height: 1.5; }
.notice-retry { flex: 0 0 auto; min-height: 54rpx; padding: 0 14rpx; display: flex; align-items: center; border-radius: 10rpx; color: #8D392E; background: #FFFFFF; font-size: 21rpx; font-weight: 700; }
.bottom-space { height: 166rpx; }
/* 紧凑核对视图：每个商品一行，点击展开完整编辑 */
.info-card { padding: 18rpx 22rpx; }
.info-summary { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.info-summary-main { min-width: 0; }
.info-summary .section-note { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-toggle { flex: 0 0 auto; color: #245E9B; font-size: 22rpx; font-weight: 700; }
