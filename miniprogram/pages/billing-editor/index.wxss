.remember-compact text { margin-left: -7rpx; font-size: 19rpx; }
.review-strip { margin-top: 13rpx; padding: 10rpx 12rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; border-radius: 10rpx; color: #70551E; background: #FFF5DF; font-size: 19rpx; }
.review-strip text:first-child { flex: 0 0 auto; font-weight: 750; }
.field.needs-review > text { color: #8A5A0A; }
