.candidate-row { display: inline-flex; gap: 12rpx; padding-bottom: 3rpx; }
.candidate { width: 280rpx; min-height: 130rpx; padding: 17rpx; display: inline-flex; flex-direction: column; justify-content: center; border: 1rpx solid #D6DFDA; border-radius: 15rpx; background: #F8FAF9; box-sizing: border-box; }
