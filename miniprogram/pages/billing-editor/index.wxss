.line-table-head { margin-top: 12rpx; padding: 0 12rpx 6rpx; color: #7A8680; font-size: 19rpx; border-bottom: 1rpx solid #E2E8E5; }
.line-item { border-bottom: 1rpx solid #EEF2F0; }
.line-item.flagged { border-left: 6rpx solid #D6A34D; background: #FFFBF1; }
.line-item.open { border-bottom: 0; }
.line-row { min-height: 76rpx; padding: 8rpx 12rpx; color: #18231E; font-size: 23rpx; }
.row-no { width: 30rpx; flex: 0 0 auto; color: #89938E; font-size: 19rpx; }
