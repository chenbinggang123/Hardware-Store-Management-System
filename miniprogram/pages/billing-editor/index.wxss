.fix-action.primary { color: #FFFFFF; background: #2865D7; }
.fix-action.danger { color: #8D392E; background: #FFE9E4; }
.line-detail-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.catalog-add { color: #247052; }
.line-collapse { color: #245E9B !important; font-size: 21rpx !important; font-weight: 700; }
.billing-bar { position: fixed; z-index: 9; right: 0; bottom: 0; left: 0; min-height: 108rpx; padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 16rpx; border-top: 1rpx solid #D4DDD8; background: rgba(255,255,255,.97); box-sizing: border-box; }
.billing-summary { min-width: 0; flex: 1; display: grid; grid-template-columns: auto 1fr; align-items: baseline; column-gap: 8rpx; }
.billing-summary > text { color: #68756F; font-size: 20rpx; }
.billing-summary-value { color: #18231E; font-size: 31rpx; font-weight: 780; font-variant-numeric: tabular-nums; }
.billing-summary-status { grid-column: 1 / 3; overflow: hidden; color: #7A8680; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.bar-actions { flex: 0 0 auto; display: flex; gap: 10rpx; }
