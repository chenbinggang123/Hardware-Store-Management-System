.ledger-card text:first-child { color: #18231E; font-size: 24rpx; font-weight: 750; }
.ledger-card text:last-child { color: #66736D; font-size: 20rpx; }
.ledger-action { flex: 0 0 auto; min-height: 58rpx; padding: 0 16rpx; display: flex; align-items: center; border-radius: 11rpx; color: #FFFFFF; background: #247052; font-size: 22rpx; font-weight: 700; }
.document-state.voided { color: #8D392E; background: #FFE9E4; }
.fix-card { margin-top: 16rpx; padding: 18rpx 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border: 1rpx solid #E1D1B2; border-radius: 15rpx; background: #FFFFFF; }
.fix-card > view:first-child { min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
