.review-text { color: #B06A08; font-weight: 750; }
.line-item .line-card { margin: 0 8rpx 12rpx; }
.ledger-row { min-height: 72rpx; margin-top: 14rpx; padding: 0 16rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid #CDD7D2; border-radius: 12rpx; background: #F7F9F8; color: #53615A; font-size: 23rpx; }
.ledger-row.active { border-color: #9CC8B2; background: #EEF7F2; color: #236C4D; }
.ledger-value { font-weight: 700; }
.ledger-card { margin-bottom: 14rpx; padding: 18rpx 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border: 1rpx solid #E1D1B2; border-radius: 15rpx; background: #FFF9ED; }
