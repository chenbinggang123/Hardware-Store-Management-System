<view class="billing-screen">
  <view class="state-card" wx:if="{{loading}}">正在读取单据…</view>
  <view class="state-card error" wx:elif="{{error}}"><view>{{error}}</view><button bindtap="retry">重新加载</button></view>

  <block wx:else>
    <!-- 顶部一行：单据类型用下拉选择，省掉一整排按钮 -->
    <view class="billing-head">
      <picker wx:if="{{mode === 'edit' && (!document || document.status === 'DRAFT')}}" range="{{typeNames}}" value="{{form.documentType === 'RETURN' ? 1 : (form.documentType === 'PROCUREMENT' ? 2 : 0)}}" bindchange="pickDocumentType"><view class="pick title-pick">{{form.documentType === 'PROCUREMENT' ? '采购单' : (form.documentType === 'RETURN' ? '退货单' : '拿货单')}}</view></picker>
      <text wx:else class="page-title">{{form.documentType === 'PROCUREMENT' ? '采购单' : (form.documentType === 'RETURN' ? '退货单' : '拿货单')}}</text>
      <text class="document-state {{document && document.status === 'CONFIRMED' ? 'confirmed' : ''}} {{document && document.status === 'VOIDED' ? 'voided' : ''}}">{{document && document.status === 'VOIDED' ? '已作废' : (document && document.status === 'CONFIRMED' ? '已保存' : '草稿')}}</text>
      <view class="head-photo" wx:if="{{mode === 'edit' && (!document || document.status === 'DRAFT')}}" role="button" aria-label="拍纸单自动填写" bindtap="pickPhoto">拍照识别</view>
      <view class="head-switch" wx:if="{{mode === 'edit'}}" role="button" data-mode="preview" bindtap="setMode">看单据 ›</view>
      <view class="head-switch" wx:elif="{{!document || document.status === 'DRAFT'}}" role="button" data-mode="edit" bindtap="setMode">‹ 回去改</view>
    </view>

    <view class="local-save-note" wx:if="{{localSaveText}}" role="status">{{localSaveText}}</view>

    <view class="editor" wx:if="{{mode === 'edit'}}">
      <!-- 单据信息折叠成一行，点开才填 -->
      <view class="info-card">
        <view class="info-summary" role="button" bindtap="toggleHeader"><text class="info-label">{{form.documentType === 'PROCUREMENT' ? '厂商' : '客户'}}</text><text class="info-value {{form.customerName ? '' : 'muted'}}">{{form.customerName || (form.documentType === 'PROCUREMENT' ? '请填源头厂商' : '未填')}}</text><text class="info-date">{{form.date}}</text><text class="info-toggle">{{headerOpen ? '▴' : '▾'}}</text></view>
        <block wx:if="{{headerOpen}}">
          <view class="field-grid">
            <view class="field"><text>{{form.documentType === 'PROCUREMENT' ? '源头厂商（必填）' : '客户名称'}}</text><input value="{{form.customerName}}" data-field="customerName" bindinput="changeForm" placeholder="{{form.documentType === 'PROCUREMENT' ? '例如：永固五金厂' : '可不填'}}" /></view>
            <view class="field"><text>日期</text><picker mode="date" value="{{form.date}}" bindchange="changeDate"><view class="picker-field">{{form.date}}</view></picker></view>
            <view class="field"><text>电话</text><input value="{{form.phone}}" data-field="phone" bindinput="changeForm" placeholder="可不填" /></view>
            <view class="field"><text>备注</text><input value="{{form.remark}}" data-field="remark" bindinput="changeForm" placeholder="可不填" /></view>
            <view class="field"><text>开票方</text><input value="{{form.companyName}}" data-field="companyName" bindinput="changeForm" placeholder="店名" /></view>
            <view class="field" wx:if="{{form.documentType === 'PROCUREMENT'}}"><text>厂商原单号</text><input value="{{form.sourceDocumentNumber}}" data-field="sourceDocumentNumber" bindinput="changeForm" placeholder="防重复" /></view>
          </view>
        </block>
        <view class="ledger-line"><text>记到账本</text><picker wx:if="{{form.documentType !== 'PROCUREMENT'}}" range="{{ledgerNames}}" value="{{ledgerIndex}}" bindchange="changeLedger"><view class="pick {{ledgerIndex ? 'on' : ''}}">{{ledgerIndex ? ledgerName : '不记账'}}</view></picker><text wx:else class="ledger-auto">{{form.customerName ? form.customerName + '（进货的）' : '按厂商自动记'}}</text></view>
      </view>

      <!-- 商品明细：默认每个商品折叠成一行，点开才编辑；最下面直接搜商品加进来 -->
      <view class="lines-card">
        <!-- 原图：核对时不用再翻纸单；点开商品还能看到原图上的那一行 -->
        <view class="source-strip" wx:if="{{sourcePhoto}}" role="button" bindtap="previewSourcePhoto"><image class="source-thumb" src="{{sourcePhoto.url}}" mode="aspectFill" bindload="onSourcePhotoLoad" /><view class="source-copy"><text class="source-title">原图 · 点开看大图</text><text class="source-hint">点开下面的商品，可以看到原图上那一行</text></view></view>
        <view class="draft-total" aria-live="polite"><view><text class="draft-total-label">{{document && document.status === 'CONFIRMED' ? '单据合计' : '草稿合计'}}</text><view class="draft-total-note">按已填数量和单价计算，保存前请核对</view></view><text class="draft-total-value">¥{{totalText}}</text></view>
        <view class="line-table-head"><text class="row-main">商品 {{lines.length}} 项<text class="review-filter" wx:if="{{reviewLineCount}}" catchtap="toggleReviewOnly">{{reviewOnly ? ' · 显示全部' : ' · ' + reviewLineCount + ' 行待核对'}}</text></text><text class="row-qty">数量</text><text class="row-price">单价</text><text class="row-amount">金额</text></view>
        <block wx:for="{{lines}}" wx:key="index">
          <view class="line-item {{item.needsReview ? 'flagged' : ''}} {{item.expanded ? 'open' : ''}}" wx:if="{{!reviewOnly || item.needsReview || item.expanded}}">
            <view class="line-row" data-index="{{index}}" bindtap="toggleLine">
              <view class="row-main"><view class="row-name {{item.nameUncertain ? 'review-text' : ''}}">{{index + 1}}. {{item.name || '待填写名称'}}<text class="row-sub" wx:if="{{item.specification}}"> {{item.specification}}</text></view></view>
              <text class="row-qty {{item.quantityUncertain || item.unitUncertain ? 'review-text' : ''}}">{{item.quantity || '?'}}{{item.unit || ''}}</text>
              <text class="row-price {{item.priceUncertain ? 'review-text' : ''}}">{{item.price || '?'}}</text>
              <text class="row-amount">{{item.amountText}}</text>
            </view>
            <view class="line-card" wx:if="{{item.expanded}}">
              <view class="row-crop" wx:if="{{item.sourceRow && rowCrops[item.sourceRow]}}" style="height:{{rowCrops[item.sourceRow].height}}px" bindtap="previewSourcePhoto"><image src="{{sourcePhoto.url}}" style="{{rowCrops[item.sourceRow].imageStyle}}" /></view>
              <view class="field-grid primary-grid">
                <view class="field {{item.nameUncertain ? 'needs-review' : ''}}"><text>名称</text><input value="{{item.name}}" focus="{{item.nameFocus}}" data-index="{{index}}" data-field="name" bindfocus="focusLineName" bindinput="changeLine" placeholder="输入可搜索" /></view>
                <view class="field"><text>规格</text><input value="{{item.specification}}" focus="{{item.specificationFocus}}" data-index="{{index}}" data-field="specification" bindfocus="focusLineInput" bindinput="changeLine" placeholder="可不填" /></view>
              </view>
              <scroll-view class="inline-candidates" scroll-x wx:if="{{activeLineIndex === index && candidates.length}}" enhanced show-scrollbar="{{false}}">
                <view class="candidate-row"><view class="candidate" wx:for="{{candidates}}" wx:for-item="candidate" wx:for-index="candidateIndex" wx:key="candidateKey" data-index="{{candidateIndex}}" data-key="{{candidate.candidateKey}}" bindtap="chooseCandidate">{{candidate.name}}<text wx:if="{{candidate.price !== null && candidate.price !== undefined}}"> ¥{{candidate.price}}</text></view></view>
              </scroll-view>
              <view class="field-grid number-grid">
                <view class="field {{item.quantityUncertain ? 'needs-review' : ''}}"><text>数量</text><input type="digit" value="{{item.quantity}}" focus="{{item.quantityFocus}}" confirm-type="next" data-index="{{index}}" data-field="quantity" bindfocus="focusLineInput" bindinput="changeLine" bindconfirm="confirmLineField" placeholder="必填" /></view>
                <view class="field {{item.unitUncertain ? 'needs-review' : ''}}"><text>单位</text><view class="unit-input"><input value="{{item.unit}}" focus="{{item.unitFocus}}" confirm-type="next" data-index="{{index}}" data-field="unit" bindfocus="focusLineInput" bindinput="changeLine" bindconfirm="confirmLineField" placeholder="个" /><picker wx:if="{{item.unitChoices.length}}" range="{{item.unitChoices}}" data-index="{{index}}" bindchange="pickUnit"><view class="unit-pick">▾</view></picker></view></view>
                <view class="field {{item.priceUncertain ? 'needs-review' : ''}}"><text>单价</text><input type="digit" value="{{item.price}}" focus="{{item.priceFocus}}" confirm-type="next" data-index="{{index}}" data-field="price" bindfocus="focusLineInput" bindinput="changeLine" bindconfirm="confirmLineField" placeholder="必填" /></view>
              </view>
              <view class="field compact-remark" wx:if="{{item.remarkOpen}}"><text>备注</text><input value="{{item.remark}}" focus="{{item.remarkFocus}}" data-index="{{index}}" data-field="remark" bindfocus="focusLineInput" bindinput="changeLine" placeholder="可不填" /></view>
              <view class="line-review-note" wx:if="{{item.amountMismatch}}">票面金额和“数量 × 单价”对不上，请核对单价</view>
              <view class="knowledge-review" wx:if="{{item.knowledgeCards.length}}">
                <view class="knowledge-heading">百科核对参考<text wx:if="{{item.specificationUncertain}}"> · 规格待核对</text></view>
                <view class="knowledge-original" wx:if="{{item.rawName || item.rawSpecification}}">识别原文：{{item.rawName}} {{item.rawSpecification}}</view>
                <view class="knowledge-entry" wx:for="{{item.knowledgeCards}}" wx:for-item="advice" wx:for-index="adviceIndex" wx:key="ruleId">
                  <view class="knowledge-title">{{advice.title}}</view>
                  <view class="knowledge-reason">{{advice.reason}}</view>
                  <view class="knowledge-actions" wx:if="{{advice.canApply}}">
                    <view role="button" data-index="{{index}}" data-card="{{adviceIndex}}" bindtap="applyKnowledgeSuggestion">采用 {{advice.suggestedSpecification}}</view>
                    <view role="button" data-index="{{index}}" bindtap="keepKnowledgeSpecification">保留当前规格</view>
                  </view>
                  <view class="knowledge-source" wx:for="{{advice.sources}}" wx:for-item="source" wx:key="title" data-url="{{source.url}}" bindtap="copyKnowledgeSource">依据：{{source.title}}{{source.url ? ' · 复制链接' : ''}}</view>
                </view>
              </view>
              <view class="source-note" wx:if="{{item.referenceSource || item.sourceAmount || item.referenceCaution}}"><text wx:if="{{item.referenceSource}}">{{item.referenceSource}}</text><text wx:if="{{item.sourceAmount}}">票面金额：{{item.sourceAmount}}</text><text wx:if="{{item.referenceCaution}}">{{item.referenceCaution}}</text></view>
              <view class="line-head"><text class="line-collapse" data-index="{{index}}" bindtap="toggleLine">收起 ▴</text><picker range="{{lineActionNames}}" data-index="{{index}}" bindchange="pickLineAction"><view class="pick">操作</view></picker></view>
            </view>
          </view>
        </block>

        <view class="add-area">
          <view class="search-row"><text class="search-plus">＋</text><input value="{{searchKeyword}}" placeholder="加商品：输入名称，点一下加入" bindinput="changeSearch" bindfocus="focusGlobalSearch" /><text class="add-line" bindtap="addLine">空白行</text></view>
          <scroll-view class="candidate-list" scroll-x wx:if="{{candidates.length && activeLineIndex === null}}" enhanced show-scrollbar="{{false}}">
            <view class="candidate-row"><view class="candidate" wx:for="{{candidates}}" wx:key="candidateKey" data-index="{{index}}" data-key="{{item.candidateKey}}" bindtap="chooseCandidate">{{item.name}}<text wx:if="{{item.price !== null && item.price !== undefined}}"> ¥{{item.price}}</text></view></view>
          </scroll-view>
          <view class="candidate-empty" wx:elif="{{searchKeyword && !searching}}">没找到，点“空白行”手动填</view>
        </view>
      </view>
      <view class="source-evidence" wx:if="{{form.sourceNote}}"><view class="source-evidence-head" bindtap="toggleEvidence"><text>识别说明</text><text>{{evidenceOpen ? '收起' : '查看'}}</text></view><view class="source-evidence-body" wx:if="{{evidenceOpen}}">{{form.sourceNote}}</view></view>
    </view>

    <view class="preview-wrap" wx:else>
      <!-- 已保存的单据也能翻原图 -->
      <view class="source-strip" wx:if="{{sourcePhoto}}" role="button" bindtap="previewSourcePhoto"><image class="source-thumb" src="{{sourcePhoto.url}}" mode="aspectFill" bindload="onSourcePhotoLoad" /><view class="source-copy"><text class="source-title">原图 · 点开看大图</text><text class="source-hint">拍照开单时保存的纸单照片</text></view></view>
      <view class="ledger-card" wx:if="{{ledgerPosting && ledgerPosting.reversed}}"><view><text>「{{ledgerPosting.factoryName}}」账本里的这笔已冲销</text><text>原流水 {{ledgerPosting.transactionNo}} · {{form.documentType === 'RETURN' ? '退货' : (form.documentType === 'PROCUREMENT' ? '进货' : '拿货')}} ¥{{ledgerPosting.amount}}</text></view></view>
      <view class="ledger-card posted" wx:elif="{{ledgerPosting}}" role="button" bindtap="openPostedLedger"><view><text>已记入「{{ledgerPosting.factoryName}}」账本</text><text>{{form.documentType === 'RETURN' ? '退货' : (form.documentType === 'PROCUREMENT' ? '进货' : '拿货')}} ¥{{ledgerPosting.amount}} · {{ledgerPosting.date}}</text><text>按单据日期归月 · 点击查看这张单据 ›</text></view></view>
      <view class="ledger-card" wx:elif="{{document && document.status === 'CONFIRMED' && form.documentType !== 'PROCUREMENT'}}"><view><text>还没记入厂家账本</text><text>选一家工厂，按当前单据类型记账</text></view><view class="ledger-action" wx:if="{{ledgerIndex}}" bindtap="postToLedger">{{ledgerBusy ? '记账中…' : '记入' + ledgerName}}</view><picker wx:else range="{{ledgerNames}}" value="{{ledgerIndex}}" bindchange="chooseLedgerForSaved"><view class="ledger-action">{{ledgerBusy ? '记账中…' : '选择账本'}}</view></picker></view>
      <view class="preview-hint"><text>{{document && document.status === 'CONFIRMED' ? '这是已保存版本' : '预览会随编辑内容同步更新'}}</text><view wx:if="{{incompleteCount}}">{{incompleteCount}} 行待补齐</view></view>
      <view class="receipt-paper">
        <view class="receipt-company">{{form.companyName || '恒迪模具五金'}}</view>
        <view class="receipt-title">{{form.documentType === 'PROCUREMENT' ? '采 购 单' : (form.documentType === 'RETURN' ? '退 货 单' : '拿 货 单')}}</view>
        <view class="receipt-number">{{document && document.number ? document.number : '草稿 · 确认后生成单号'}}</view>
        <view class="receipt-number" wx:if="{{form.sourceDocumentNumber}}">供应商原单号：{{form.sourceDocumentNumber}}</view><view class="receipt-rule"></view>
        <view class="receipt-info"><view><text>{{form.documentType === 'PROCUREMENT' ? '源头厂商' : '客户'}}</text><text class="receipt-info-value">{{form.customerName || '未填写'}}</text></view><view><text>日期</text><text class="receipt-info-value">{{form.date}}</text></view><view><text>电话</text><text class="receipt-info-value">{{form.phone || '未填写'}}</text></view></view>
        <view class="receipt-table">
          <view class="receipt-row receipt-header"><text class="col-no">序</text><text class="col-name">商品名称</text><text class="col-spec">规格</text><text class="col-unit">单位</text><text class="col-qty">数量</text><text class="col-price">单价</text><text class="col-amount">金额</text></view>
          <view class="receipt-row" wx:for="{{lines}}" wx:key="index"><text class="col-no">{{index + 1}}</text><text class="col-name">{{item.name || '待填写'}}</text><text class="col-spec">{{item.specification || '—'}}</text><text class="col-unit">{{item.unit || '—'}}</text><text class="col-qty">{{item.quantity || '—'}}</text><text class="col-price">{{item.price || '—'}}</text><text class="col-amount">{{item.amountText}}</text></view>
          <view class="receipt-total"><text>合计</text><text class="receipt-total-value">¥{{totalText}}</text></view>
        </view>
        <view class="receipt-footer"><view><text>备注</text><text class="receipt-footer-value">{{form.remark || '无'}}</text></view><view class="receipt-notice">请当面核对商品、数量和金额；本单据仅用于打印和导出。</view></view>
      </view>
      <view class="fix-card" wx:if="{{document && document.status !== 'DRAFT'}}"><view><text>{{document.status === 'VOIDED' ? '这张单已作废' : '要改或开错了？'}}</text><text>{{document.status === 'VOIDED' ? '可以复制内容重新开一张' : '未记账单据可退回草稿；已记账单据请到账本处理'}}</text></view><picker wx:if="{{document.status === 'CONFIRMED' && !ledgerPosting}}" range="{{fixAllNames}}" data-list="all" bindchange="pickFixAction"><view class="pick">处理</view></picker><picker wx:else range="{{fixCopyNames}}" data-list="copy" bindchange="pickFixAction"><view class="pick">处理</view></picker></view>
      <view class="image-export-card" wx:if="{{!document || document.status === 'DRAFT'}}"><view><text>保存为图片</text><text>生成清晰长图，可直接发微信或打印</text></view><view class="image-export-action" bindtap="saveAsImage">{{imageBusy ? '生成中…' : '保存到相册'}}</view></view>
    </view>
    <!-- 拍照识别进度：告诉用户做到哪一步、用了多久，失败可以直接重拍 -->
    <view class="recognize-mask" wx:if="{{recognizing}}">
      <view class="recognize-card">
        <view class="recognize-title">{{recognizeError ? '没有识别成功' : '正在识别' + recognizeTypeName}}</view>
        <block wx:if="{{!recognizeError}}">
          <view class="recognize-step {{recognizeStep > index ? 'done' : (recognizeStep === index ? 'doing' : '')}}" wx:for="{{recognizeSteps}}" wx:key="*this"><text class="recognize-dot">{{recognizeStep > index ? '✓' : index + 1}}</text>{{item}}</view>
          <view class="recognize-time">已用 {{recognizeElapsed}} 秒，一般 20～60 秒</view>
        </block>
        <view class="recognize-error" wx:else>{{recognizeError}}</view>
        <view class="recognize-tip">小贴士：单子铺平、拍正、拍全，光线亮一点更准</view>
        <view class="recognize-actions"><view class="secondary-action" bindtap="cancelRecognition">{{recognizeError ? '关闭' : '取消'}}</view><view class="primary-action" wx:if="{{recognizeError}}" bindtap="retakePhoto">重拍</view></view>
      </view>
    </view>
    <canvas type="2d" id="billingImageCanvas" class="billing-image-canvas"></canvas>
    <view class="action-notice" wx:if="{{actionError}}"><view><text>操作没有完成</text><text>{{actionError}}</text></view><view class="notice-retry" wx:if="{{actionRetry}}" bindtap="retryAction">{{actionRetryText}}</view></view>
    <view class="bottom-space"></view>

    <view class="billing-bar">
      <view class="billing-summary"><text>合计</text><text class="billing-summary-value">¥{{totalText}}</text><text class="billing-summary-status">{{statusText}}</text></view>
      <view class="bar-actions" wx:if="{{document && document.status === 'VOIDED'}}"><view class="primary-action" bindtap="copyAsNew">复制为新单</view></view>
      <view class="bar-actions" wx:elif="{{document && document.status === 'CONFIRMED'}}"><view class="secondary-action" wx:if="{{generatedFile}}" bindtap="openGenerated">打开 Excel</view><view class="primary-action" bindtap="chooseExportFormat">{{busy || imageBusy ? '处理中…' : '选择导出'}}</view></view>
      <view class="bar-actions" wx:else><view class="secondary-action" wx:if="{{mode === 'edit'}}" bindtap="saveDraft">存草稿</view><view class="secondary-action" wx:else data-mode="edit" bindtap="setMode">返回修改</view><view class="primary-action" bindtap="confirmDocument">{{busy || ledgerBusy ? '处理中…' : (form.documentType === 'PROCUREMENT' ? '保存进货' : (ledgerIndex ? '保存并记账' : '保存并导出'))}}</view></view>
    </view>
  </block>
</view>
