<view class="screen">
  <view class="section-head">
    <view class="section-title">供应商管理</view>
    <view class="btn btn-primary btn-sm" bindtap="openCreate">＋ 新增</view>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索供应商 / 联系人 / 电话" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="loadSuppliers" />
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">供应商数据加载中...</view>

  <view class="list" wx:if="{{!loading && suppliers.length}}">
    <block wx:for="{{suppliers}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view style="flex:1; min-width:0;">
            <view class="list-title">{{item.name}}</view>
            <view class="list-meta">{{item.contact}} · {{item.phone}}</view>
          </view>
          <view class="tag tag-success">合作中</view>
        </view>
        <view class="list-meta">{{item.address}}</view>
        <view class="list-meta" wx:if="{{item.remark}}">{{item.remark}}</view>
        <view class="action-row">
          <view class="btn btn-outline btn-sm" bindtap="openDetail" data-id="{{item.id}}">详情</view>
          <view class="btn btn-outline btn-sm" bindtap="openEdit" data-id="{{item.id}}">编辑</view>
          <view class="btn btn-ghost btn-sm" bindtap="openDetail" data-id="{{item.id}}">采购历史</view>
          <view class="btn btn-ghost btn-sm" bindtap="openDetail" data-id="{{item.id}}">价格趋势</view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{!loading && !suppliers.length}}">
    <text class="empty-icon">🏭</text>
    <view class="empty-title">暂无供应商</view>
    <view class="empty-desc">点击右上角添加第一个供应商</view>
  </view>
</view>
