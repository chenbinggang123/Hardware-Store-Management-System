.export-screen{padding-top:24rpx}.title{color:#17231E;font-size:38rpx;font-weight:760}.desc{margin-top:8rpx;color:#68766F;font-size:23rpx;line-height:1.55}.direction{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:24rpx}.choice{min-height:78rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #CDD7D2;border-radius:14rpx;background:#FFF;color:#5F6E67;font-size:23rpx}.choice.active{font-weight:720}.choice.receive{border-color:#A84635;color:#A84635;background:#FFF4F1}.choice.pay{border-color:#8A5717;color:#8A5717;background:#FFF8EA}.form-card{margin-top:20rpx;padding:0 20rpx;border-radius:16rpx;background:#FFF}.field{padding:20rpx 0;border-bottom:1rpx solid #E2E7E4}.label{margin-bottom:10rpx;color:#536159;font-size:22rpx;font-weight:650}.picker{min-height:72rpx;padding:0 16rpx;display:flex;align-items:center;justify-content:space-between;border:1rpx solid #CBD5D0;border-radius:12rpx;color:#17231E;font-size:24rpx;box-sizing:border-box}.picker.placeholder{color:#87928D}.date-grid{display:grid;grid-template-columns:1fr 38rpx 1fr;align-items:center}.date-separator{text-align:center;color:#7B8881;font-size:21rpx}.field-help{margin-top:9rpx;color:#9A6721;font-size:20rpx}.export-note{padding:18rpx 0;color:#607068;font-size:21rpx;line-height:1.55}.space{height:150rpx}
