.payment-screen{padding-top:24rpx}.title{color:#17231E;font-size:38rpx;font-weight:760}.desc{margin-top:8rpx;color:#68766F;font-size:23rpx;line-height:1.55}.direction{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:24rpx}.choice{min-height:78rpx;padding:0 12rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #CDD7D2;border-radius:14rpx;background:#FFF;color:#5F6E67;font-size:23rpx}.choice.active{font-weight:720}.choice.receive{border-color:#A84635;color:#A84635;background:#FFF4F1}.choice.pay{border-color:#8A5717;color:#8A5717;background:#FFF8EA}.form-card{margin-top:20rpx;padding:0 20rpx;border-radius:16rpx;background:#FFF}.field{padding:20rpx 0;border-bottom:1rpx solid #E2E7E4}.field:last-child{border:0}.label{margin-bottom:10rpx;color:#536159;font-size:22rpx;font-weight:650}.field input,.picker{min-height:72rpx;padding:0 16rpx;display:flex;align-items:center;justify-content:space-between;border:1rpx solid #CBD5D0;border-radius:12rpx;color:#17231E;font-size:25rpx;box-sizing:border-box}.picker.placeholder{color:#87928D}.field textarea{width:100%;min-height:150rpx;padding:16rpx;border:1rpx solid #CBD5D0;border-radius:12rpx;box-sizing:border-box;font-size:24rpx}.space{height:150rpx}
