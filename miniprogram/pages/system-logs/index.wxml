<view class="screen">
  <view class="section-head">
    <view class="section-title">操作日志</view>
    <view class="text-muted" wx:if="{{logs.length}}">{{logs.length}} 条记录</view>
  </view>

  <view class="toolbar">
    <view class="chip-row">
      <view class="chip {{module === '' ? 'active' : ''}}" data-module="" bindtap="selectModule">全部</view>
      <view class="chip {{module === 'PRODUCT' ? 'active' : ''}}" data-module="PRODUCT" bindtap="selectModule">商品</view>
      <view class="chip {{module === 'PURCHASE' ? 'active' : ''}}" data-module="PURCHASE" bindtap="selectModule">采购</view>
      <view class="chip {{module === 'SALES' ? 'active' : ''}}" data-module="SALES" bindtap="selectModule">销售</view>
      <view class="chip {{module === 'SETTINGS' ? 'active' : ''}}" data-module="SETTINGS" bindtap="selectModule">系统</view>
    </view>
  </view>

  <view class="list" wx:if="{{logs.length}}">
    <block wx:for="{{logs}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view class="list-title" style="font-size: 26rpx;">{{item.module}} · {{item.action}}</view>
          <view class="tag tag-neutral">{{item.createTime}}</view>
        </view>
        <view class="list-meta">{{item.detail}}</view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📝</text>
    <view class="empty-title">暂无匹配日志</view>
    <view class="empty-desc">切换筛选条件或开始使用系统</view>
  </view>
</view>
