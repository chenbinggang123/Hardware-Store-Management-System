<view class="screen">
  <view class="section-head">
    <view class="section-title">客户管理</view>
    <view class="btn btn-primary btn-sm" bindtap="openCreate">＋ 新增</view>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索客户名称 / 电话" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="loadCustomers" />
    </view>
    <view class="chip-row">
      <view class="chip {{type === '' ? 'active' : ''}}" data-type="" bindtap="selectType">全部</view>
      <view class="chip {{type === 'C' ? 'active' : ''}}" data-type="C" bindtap="selectType">C 端</view>
      <view class="chip {{type === 'B' ? 'active' : ''}}" data-type="B" bindtap="selectType">B 端</view>
      <view class="chip {{type === '老客户' ? 'active' : ''}}" data-type="老客户" bindtap="selectType">老客户</view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">客户数据加载中...</view>

  <view class="list" wx:if="{{!loading && customers.length}}">
    <block wx:for="{{customers}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view style="flex:1; min-width:0;">
            <view class="list-title">{{item.name}}</view>
            <view class="list-meta">{{item.phone}} · {{item.address}}</view>
          </view>
          <view class="tag {{item.type === '老客户' ? 'tag-warning' : item.type === 'B' ? 'tag-info' : 'tag-neutral'}}">{{item.type}}</view>
        </view>
        <view class="list-meta" style="color: {{item.debt > 0 ? '#B95034' : '#247A55'}}; font-weight: 600;">欠款 ¥{{item.debt || 0}}</view>
        <view class="list-meta" wx:if="{{item.remark}}">{{item.remark}}</view>
        <view class="action-row">
          <view class="btn btn-outline btn-sm" bindtap="openDetail" data-id="{{item.id}}">详情</view>
          <view class="btn btn-outline btn-sm" bindtap="openEdit" data-id="{{item.id}}">编辑</view>
          <view class="btn btn-ghost btn-sm" bindtap="openDetail" data-id="{{item.id}}">订单历史</view>
          <view class="btn btn-ghost btn-sm" bindtap="openDetail" data-id="{{item.id}}">欠款记录</view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{!loading && !customers.length}}">
    <text class="empty-icon">👤</text>
    <view class="empty-title">暂无客户</view>
    <view class="empty-desc">点击右上角添加第一个客户</view>
  </view>
</view>
