<view class="screen">
  <view class="section-head">
    <view class="section-title">库存管理</view>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索商品名称 / 条码" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="loadInventories" />
    </view>
    <view class="chip-row">
      <view class="chip {{!warningOnly ? 'active' : ''}}" bindtap="toggleWarning">全部库存</view>
      <view class="chip {{warningOnly ? 'active' : ''}}" bindtap="toggleWarning">仅看预警</view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">库存数据加载中...</view>

  <view class="list" wx:if="{{!loading && inventories.length}}">
    <block wx:for="{{inventories}}" wx:key="id">
      <view class="list-card">
        <view class="list-head">
          <view style="flex:1; min-width:0;">
            <view class="list-title">商品 ID {{item.productId}}</view>
            <view class="list-meta">库位 {{item.locationId}} · {{item.lastUpdateTime}}</view>
          </view>
          <view class="tag {{item.quantity <= item.warningThreshold ? 'tag-danger' : 'tag-success'}}">{{item.quantity <= item.warningThreshold ? '库存预警' : '库存正常'}}</view>
        </view>
        <view class="list-meta" style="font-weight: 600;">库存 {{item.quantity}} · 预警阈值 {{item.warningThreshold}}</view>
        <view class="action-row">
          <view class="btn btn-outline btn-sm" bindtap="openDetail" data-id="{{item.id}}">详情</view>
          <view class="btn btn-outline btn-sm" bindtap="openAdjust" data-id="{{item.id}}">盘点调整</view>
          <view class="btn btn-ghost btn-sm" bindtap="openDetail" data-id="{{item.id}}">库存日志</view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{!loading && !inventories.length}}">
    <text class="empty-icon">📋</text>
    <view class="empty-title">暂无库存数据</view>
    <view class="empty-desc">添加商品后会自动生成库存记录</view>
  </view>
</view>
