.record-search { height: 76rpx; margin: 8rpx 0 18rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 12rpx; border: 1rpx solid #CBD6D0; border-radius: 14rpx; background: #FFFFFF; box-sizing: border-box; }
.record-search input { flex: 1; height: 74rpx; font-size: 26rpx; }
.record-search text { color: #7A8680; font-size: 34rpx; padding: 0 6rpx; }
.record-total { flex: 0 0 auto; color: #18231E; font-size: 30rpx; font-weight: 760; font-variant-numeric: tabular-nums; }
.record-end { padding: 24rpx 0 40rpx; color: #89938E; font-size: 22rpx; text-align: center; }
.tag-neutral { color: #5E6B65; background: #E8ECEA; }
.record-footer { display:flex; align-items:center; flex-wrap:wrap; justify-content:space-between; gap:12rpx; }
.record-actions { display:flex; gap:24rpx; color:#21634B; font-size:26rpx; }
.record-actions > view { min-height:88rpx; display:flex; align-items:center; }
.record-actions .record-delete { color:#B33A32; }
.record-filters { display: flex; gap: 8rpx; margin-bottom: 8rpx; }
.record-filter { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; color: #4C5E53; font-size: 28rpx; border-radius: 12rpx; }
.record-filter.active { color: #20513B; background: #DDEBDF; font-weight: 650; }
.draft-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 20rpx; margin-bottom: 12rpx; font-size: 26rpx; color: #365B47; }
.draft-toolbar > view { min-height: 88rpx; display: flex; align-items: center; }
.draft-toolbar .record-delete { color: #B33A32; }
.draft-toolbar [aria-disabled="true"] { opacity: .55; }
.draft-check { display: inline-block; padding: 4rpx 12rpx; margin-right: 12rpx; border-radius: 8rpx; background: #E9EEEA; color: #4C5E53; font-size: 24rpx; vertical-align: middle; }
.draft-check.checked { color: #FFFFFF; background: #30694B; }

/* ===== 2026-10 紧凑版 ===== */
.list-top { display: flex; align-items: center; gap: 12rpx; padding: 0 0 10rpx; }
.list-top-title { color: #17231E; font-size: 34rpx; font-weight: 760; }
.list-top-count { color: #66746E; font-size: 22rpx; }
.list-top .btn { margin-left: auto; }
.record-tools { flex-wrap: nowrap; margin-bottom: 8rpx; }
.record-search { flex: 1; min-width: 0; height: 60rpx; margin: 0; padding: 0 14rpx; border-radius: 10rpx; }
.record-search input { height: 58rpx; font-size: 25rpx; }
.record-search text { font-size: 30rpx; }
.pick.on { border-color: #245E9B; color: #245E9B; background: #E8F1F8; font-weight: 700; }
.draft-toolbar { margin-bottom: 6rpx; font-size: 23rpx; }
.draft-toolbar > view { min-height: 52rpx; }
.list-card { margin-bottom: 8rpx; padding: 12rpx 16rpx; border-radius: 10rpx; }
.list-title { font-size: 27rpx; }
.list-meta { margin-top: 2rpx; font-size: 21rpx; }
.record-total { font-size: 27rpx; }
.record-footer { margin-top: 6rpx; gap: 8rpx; }
.record-footer .tag { font-size: 20rpx; }
.record-actions { gap: 20rpx; font-size: 22rpx; }
.record-actions > view { min-height: 48rpx; }
.draft-check { padding: 2rpx 10rpx; font-size: 21rpx; }
.record-end { padding: 16rpx 0 30rpx; font-size: 20rpx; }
