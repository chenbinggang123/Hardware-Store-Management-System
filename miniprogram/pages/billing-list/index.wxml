<view class="screen">
  <view class="list-top"><text class="list-top-title">{{selecting ? '选一张给小五' : (documentType === 'PROCUREMENT' ? (factory ? factory + ' 进货' : '采购进货') : '开单记录')}}</text><text class="list-top-count">{{total}} 张</text><view class="btn btn-outline btn-sm list-photo" wx:if="{{!selecting}}" bindtap="openPhoto">拍照开单</view><view class="btn btn-primary btn-sm" bindtap="openCreate">＋ 开单</view></view>

  <!-- 状态用下拉选，和搜索框放一行 -->
  <view class="pick-row record-tools"><picker range="{{filterNames}}" value="{{filterIndex}}" bindchange="pickStatus"><view class="pick {{status ? 'on' : ''}}">{{filterNames[filterIndex]}}</view></picker><view class="record-search"><input value="{{keyword}}" placeholder="搜单号、客户或商品" bindinput="changeKeyword" confirm-type="search" /><text wx:if="{{keyword}}" bindtap="clearKeyword">×</text></view></view>
  <view class="draft-toolbar" wx:if="{{!selecting}}">
    <view class="draft-manage" role="button" bindtap="toggleManage">{{managing ? '完成' : '批量清理草稿'}}</view>
    <block wx:if="{{managing}}"><view role="button" bindtap="selectLoadedDrafts">{{selectedIds.length ? '取消选择' : '选择已加载草稿'}}</view><view class="record-delete" role="button" aria-disabled="{{!selectedIds.length || bulkDeleting}}" bindtap="deleteSelectedDrafts">{{bulkDeleting ? '删除中…' : '删除所选（' + selectedIds.length + '）'}}</view></block>
  </view>

  <view class="loading-state" wx:if="{{loading}}">正在加载开单记录…</view>
  <view class="empty-state" wx:elif="{{loadError}}"><view class="empty-title">{{loadError}}</view><view class="btn btn-primary btn-sm" bindtap="retryLoad">重新加载</view></view>
  <view class="list" wx:elif="{{items.length}}">
    <view class="list-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openDocument">
      <view class="list-head">
        <view style="flex:1; min-width:0;">
          <view class="list-title"><text wx:if="{{managing}}" class="draft-check {{item.selected ? 'checked' : ''}}">{{item.selected ? '已选' : '选择'}}</text>{{item.title}}</view>
          <view class="list-meta">{{item.meta}}</view>
        </view>
        <view class="record-total">¥{{item.totalText}}</view>
      </view>
      <view class="record-footer"><view class="tag {{item.statusTone}}">{{item.statusText}}</view>
        <view class="record-actions" wx:if="{{!managing}}"><view role="button" data-id="{{item.id}}" catchtap="selectDocument">{{selecting ? '选择单据' : '添加到小五'}}</view><view wx:if="{{!selecting && !item.ledgerManaged && !item.ledgerName}}" class="record-delete" role="button" data-id="{{item.id}}" catchtap="deleteDocument">{{deletingId === item.id ? '删除中…' : '删除'}}</view></view>
      </view>
    </view>
    <view class="record-end" wx:if="{{loadingMore}}">正在加载更多…</view>
    <view class="record-end" wx:elif="{{totalPages && page + 1 >= totalPages}}">已经到底了</view>
  </view>
  <view class="empty-state" wx:else>
    <view class="empty-title">{{keyword ? '没有找到相关单据' : (status === 'DRAFT' ? '没有待清理的草稿' : (status ? '这个状态下还没有单据' : '还没有开过单'))}}</view>
    <view class="empty-desc">{{keyword || status ? '可切换状态或调整搜索条件。' : '点右上角“开单”开始第一张'}}</view>
  </view>
</view>
