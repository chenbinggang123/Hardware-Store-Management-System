<view class="review-screen" wx:if="{{task}}">
  <view class="review-head">
    <view class="flow-step-label">第 3 步，共 4 步</view>
    <view class="review-title">逐行检查匹配结果</view>
    <view class="review-file-line"><view class="review-file">{{task.fileName}} · {{task.rowCount}} 行</view><view class="original-link" bindtap="openOriginal">查看原表</view></view>
    <view class="review-progress"><view class="review-progress-value" style="width: 76%;"></view></view>
    <view class="review-summary">
      <view><text>{{task.matched}}</text><text>已匹配</text></view><view class="warning"><text>{{task.pending}}</text><text>待确认</text></view>
      <view class="warning"><text>{{task.unmatched}}</text><text>未匹配</text></view><view class="danger"><text>{{task.conflict}}</text><text>冲突</text></view>
    </view>
  </view>

  <scroll-view class="review-filters" scroll-x enable-flex>
    <view class="review-filter {{filter === item.key ? 'active' : ''}}" wx:for="{{filters}}" wx:key="key" data-filter="{{item.key}}" bindtap="selectFilter">{{item.label}}</view>
  </scroll-view>

  <view class="review-list">
    <view class="review-row tone-{{item.tone}} {{expandedId === item.id ? 'expanded' : ''}}" wx:for="{{visibleRows}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleRow">
      <view class="review-row-head"><view class="row-number">原表第 {{item.sourceRow}} 行</view><view class="row-status {{item.tone}}">{{item.statusText}}</view></view>
      <view class="row-product"><view><view class="row-name">{{item.name}}</view><view class="row-spec">{{item.spec}} · {{item.quantity}} {{item.unit}}</view></view><view class="row-arrow">›</view><view class="row-match"><view>{{item.matchName}}</view><text wx:if="{{item.price}}">¥{{item.price}} / {{item.unit}}</text></view></view>
      <view class="row-note">{{item.note}}</view>
      <view class="row-expand" wx:if="{{expandedId === item.id}}" catchtap="noop">
        <view class="row-detail"><text>价格依据</text><text>{{item.basis}}</text></view>
        <view class="row-detail"><text>写入动作</text><text>{{item.status === 'UNMATCHED' ? '尚未决定' : item.status === 'SKIPPED' ? '跳过' : '生成报价行'}}</text></view>
        <view class="row-actions" wx:if="{{item.status !== 'MATCHED' && item.status !== 'SKIPPED'}}">
          <view class="row-action primary" data-id="{{item.id}}" catchtap="confirmMatch">确认这个匹配</view>
          <view class="row-action" data-id="{{item.id}}" catchtap="skipRow">本次跳过</view>
        </view>
      </view>
    </view>
  </view>

  <view class="review-segment" wx:if="{{visibleRows.length}}"><text>已显示 {{visibleRows.length}} / {{task.rowCount}} 行 · 筛选会保留</text><view bindtap="loadNext">加载下一段</view></view>

  <view class="review-tip" wx:if="{{!visibleRows.length}}">这个筛选条件下没有数据行</view>
  <view class="fixed-action-space"></view>
  <view class="fixed-action"><view class="fixed-primary {{remainingConflict ? 'warning' : ''}}" bindtap="previewChanges">{{remainingConflict ? '先处理 ' + remainingConflict + ' 行冲突' : '预览将要写入的变化'}}</view></view>
</view>
