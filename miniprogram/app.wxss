/* ============================================
   Hardware Store OS — Design System
   ============================================ */

/* ---------- Base ---------- */
page {
  background: #F5EFE6;
  color: #1A1410;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.screen {
  min-height: 100vh;
  padding: 20rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* ---------- Typography ---------- */
.title-xl { font-size: 44rpx; font-weight: 800; letter-spacing: 2rpx; }
.title-lg { font-size: 36rpx; font-weight: 700; }
.title-md { font-size: 30rpx; font-weight: 700; }
.title-sm { font-size: 26rpx; font-weight: 600; }
.text-body { font-size: 26rpx; color: #5C4A38; line-height: 1.7; }
.text-muted { font-size: 22rpx; color: #A89880; }
.text-accent { color: #B75A1A; }
.text-success { color: #29714C; }
.text-danger { color: #BF4F1C; }
.text-warning { color: #A36B0C; }

/* ---------- Hero / Header ---------- */
.hero-card {
  position: relative;
  background: linear-gradient(135deg, #2F2416 0%, #4A3728 40%, #8B4513 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  color: #FFF8EF;
  box-shadow: 0 16rpx 48rpx rgba(51, 33, 14, 0.22);
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}

.hero-eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  opacity: 0.7;
  font-weight: 500;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.82;
}

/* ---------- Section ---------- */
.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1410;
  letter-spacing: 1rpx;
}

.section-subtitle {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #A89880;
}

.section-link {
  font-size: 24rpx;
  color: #B75A1A;
  font-weight: 700;
  white-space: nowrap;
}

/* ---------- Cards ---------- */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(78, 55, 25, 0.06);
  border: 1rpx solid rgba(180, 155, 125, 0.1);
}

.card-flush {
  padding: 0;
}

/* Module card on home page */
.module-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(78, 55, 25, 0.06);
  border: 1rpx solid rgba(180, 155, 125, 0.1);
  transition: all 0.2s;
}

.module-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(78, 55, 25, 0.1);
}

.module-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.module-icon.product  { background: rgba(183, 90, 26, 0.1); }
.module-icon.supplier { background: rgba(62, 132, 92, 0.1); }
.module-icon.customer { background: rgba(49, 112, 168, 0.1); }
.module-icon.purchase { background: rgba(195, 144, 40, 0.12); }
.module-icon.sales    { background: rgba(196, 86, 42, 0.1); }
.module-icon.stock    { background: rgba(106, 76, 160, 0.1); }

.module-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1410;
}

.module-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A89880;
  line-height: 1.5;
}

/* ---------- Data Cards ---------- */
.data-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(78, 55, 25, 0.05);
  border: 1rpx solid rgba(180, 155, 125, 0.08);
}

.metric-label {
  font-size: 22rpx;
  color: #A89880;
  font-weight: 500;
}

.metric-value {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1410;
  letter-spacing: 1rpx;
}

.metric-change {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.metric-change.up   { color: #29714C; }
.metric-change.down { color: #BF4F1C; }

/* ---------- Stats Strip ---------- */
.stats-strip {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.stat-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 22rpx 18rpx;
  text-align: center;
  box-shadow: 0 6rpx 22rpx rgba(78, 55, 25, 0.05);
  border: 1rpx solid rgba(180, 155, 125, 0.08);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1410;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A89880;
  font-weight: 500;
}

.stat-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

/* ---------- List ---------- */
.list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(78, 55, 25, 0.05);
  border: 1rpx solid rgba(180, 155, 125, 0.08);
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1410;
}

.list-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A89880;
  line-height: 1.6;
}

.list-foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ---------- Status Tags ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
}

.tag-success { background: rgba(62, 132, 92, 0.12); color: #29714C; }
.tag-warning { background: rgba(195, 144, 40, 0.14); color: #A36B0C; }
.tag-danger  { background: rgba(196, 86, 42, 0.12); color: #BF4F1C; }
.tag-info    { background: rgba(49, 112, 168, 0.1);  color: #235D8A; }
.tag-primary { background: rgba(183, 90, 26, 0.1);   color: #B75A1A; }
.tag-neutral { background: rgba(120, 100, 80, 0.08);  color: #6B5A48; }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
  border: none;
  transition: all 0.15s;
}

.btn::after { border: none; }

.btn:active { opacity: 0.85; transform: scale(0.97); }

.btn-primary {
  background: linear-gradient(135deg, #B75A1A 0%, #9A4815 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(183, 90, 26, 0.28);
}

.btn-outline {
  background: rgba(183, 90, 26, 0.06);
  color: #B75A1A;
  border: 2rpx solid rgba(183, 90, 26, 0.2);
}

.btn-ghost {
  background: rgba(120, 100, 80, 0.06);
  color: #5C4A38;
}

.btn-danger {
  background: rgba(196, 86, 42, 0.08);
  color: #BF4F1C;
  border: 2rpx solid rgba(196, 86, 42, 0.18);
}

.btn-sm {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  border-radius: 14rpx;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

/* ---------- Action Row ---------- */
.action-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.top-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.bottom-actions {
  margin-top: 28rpx;
  padding-bottom: 32rpx;
}

/* ---------- Toolbar ---------- */
.toolbar {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(180, 155, 125, 0.16);
  box-shadow: 0 4rpx 16rpx rgba(78, 55, 25, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  color: #C4B198;
}

.search-input {
  flex: 1;
  height: 84rpx;
  font-size: 26rpx;
  color: #1A1410;
}

/* ---------- Chips ---------- */
.chip-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #7C6B5A;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid rgba(180, 155, 125, 0.16);
  transition: all 0.15s;
}

.chip.active {
  background: #B75A1A;
  color: #FFFFFF;
  border-color: #B75A1A;
  box-shadow: 0 6rpx 18rpx rgba(183, 90, 26, 0.24);
}

/* ---------- Grid Layouts ---------- */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

/* ---------- Detail Grid ---------- */
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 16rpx;
}

.detail-item {
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #FAF6F0;
}

.detail-label {
  font-size: 22rpx;
  color: #A89880;
  font-weight: 500;
}

.detail-value {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1A1410;
  font-weight: 600;
  word-break: break-all;
}

/* ---------- Forms ---------- */
.form-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(78, 55, 25, 0.06);
  border: 1rpx solid rgba(180, 155, 125, 0.1);
}

.form-section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1410;
  letter-spacing: 0.5rpx;
}

.form-group {
  margin-top: 22rpx;
}

.form-label {
  font-size: 24rpx;
  color: #5C4A38;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.form-input,
.form-textarea,
.form-picker {
  width: 100%;
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #FAF6F0;
  border: 1rpx solid rgba(180, 155, 125, 0.2);
  font-size: 26rpx;
  color: #1A1410;
  transition: border-color 0.15s;
}

.form-input:focus,
.form-textarea:focus {
  border-color: #B75A1A;
  background: #FFFBF7;
}

.form-textarea {
  min-height: 160rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  color: #1A1410;
}

.picker-placeholder {
  color: #C4B198;
}

.form-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #C4B198;
}

/* ---------- Image Placeholder ---------- */
.image-card {
  margin-top: 18rpx;
}

.image-preview {
  width: 100%;
  height: 340rpx;
  border-radius: 22rpx;
  background: #FAF6F0;
}

.image-placeholder {
  height: 340rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(183, 90, 26, 0.08) 0%, rgba(250, 240, 228, 0.9) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(183, 90, 26, 0.18);
}

.image-placeholder-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #B75A1A 0%, #C46A2E 100%);
  color: #FFFFFF;
  text-align: center;
  line-height: 100rpx;
  font-size: 44rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 28rpx rgba(183, 90, 26, 0.24);
}

.image-placeholder-text {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #B09880;
}

/* ---------- Line Items (order details) ---------- */
.line-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.line-card {
  padding: 22rpx;
  border-radius: 18rpx;
  background: #FAF6F0;
  border: 1rpx solid rgba(180, 155, 125, 0.12);
}

.line-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.line-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1410;
}

.line-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7C6B5A;
  line-height: 1.6;
}

.line-actions {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* ---------- Mini list (detail sub-lists) ---------- */
.mini-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mini-row {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FAF6F0;
  border: 1rpx solid rgba(180, 155, 125, 0.08);
}

.mini-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1410;
}

.mini-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8C7964;
}

/* ---------- Banner / Alert ---------- */
.banner {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.banner-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.banner-title {
  font-size: 26rpx;
  font-weight: 700;
}

.banner-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.banner-info {
  background: rgba(49, 112, 168, 0.08);
  color: #235D8A;
}

.banner-warning {
  background: rgba(195, 144, 40, 0.1);
  color: #7D5008;
}

.banner-success {
  background: rgba(62, 132, 92, 0.08);
  color: #1D5C38;
}

.banner-danger {
  background: rgba(196, 86, 42, 0.08);
  color: #A33D14;
}

/* ---------- Empty State ---------- */
.empty-state {
  margin-top: 28rpx;
  padding: 60rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  opacity: 0.5;
  display: block;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #5C4A38;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #A89880;
  line-height: 1.6;
}

/* ---------- Loading ---------- */
.loading-state {
  margin-top: 28rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  color: #A89880;
  font-size: 26rpx;
}

/* ---------- Table ---------- */
.table-card {
  margin-top: 20rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 6rpx 22rpx rgba(78, 55, 25, 0.05);
  border: 1rpx solid rgba(180, 155, 125, 0.08);
}

.table-row {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid rgba(180, 155, 125, 0.08);
  gap: 16rpx;
}

.table-row:last-child { border-bottom: none; }

.table-head {
  background: rgba(183, 90, 26, 0.05);
}

.table-cell {
  font-size: 24rpx;
  color: #1A1410;
  line-height: 1.5;
  flex: 1;
  min-width: 0;
}

.table-head .table-cell {
  font-weight: 700;
  color: #5C4A38;
  font-size: 22rpx;
}

/* ---------- Divider ---------- */
.divider {
  height: 1rpx;
  background: rgba(180, 155, 125, 0.14);
  margin: 24rpx 0;
}

/* ---------- Profile / Avatar ---------- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #B75A1A 0%, #9A4815 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  font-size: 48rpx;
}

/* ---------- Setting Row ---------- */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(180, 155, 125, 0.1);
  gap: 20rpx;
}

.setting-row:last-child { border-bottom: none; }

.setting-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.setting-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.setting-icon.users  { background: rgba(62, 132, 92, 0.1); }
.setting-icon.logs   { background: rgba(49, 112, 168, 0.1); }
.setting-icon.backup { background: rgba(183, 90, 26, 0.1); }
.setting-icon.logout { background: rgba(196, 86, 42, 0.08); }
.setting-icon.report { background: rgba(106, 76, 160, 0.1); }
.setting-icon.about  { background: rgba(120, 100, 80, 0.08); }

.setting-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1410;
}

.setting-desc {
  font-size: 22rpx;
  color: #A89880;
  margin-top: 2rpx;
}

.setting-arrow {
  font-size: 28rpx;
  color: #C4B198;
}

.setting-badge {
  font-size: 22rpx;
  color: #A89880;
  margin-right: 4rpx;
}

/* ---------- Login specific ---------- */
.login-screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.login-brand {
  text-align: center;
  margin-bottom: 48rpx;
}

.login-brand-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2F2416 0%, #B75A1A 100%);
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #FFFFFF;
  box-shadow: 0 16rpx 40rpx rgba(183, 90, 26, 0.28);
}

.login-brand-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #1A1410;
  letter-spacing: 2rpx;
}

.login-brand-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A89880;
}

.login-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(78, 55, 25, 0.1);
}

.login-field {
  margin-top: 20rpx;
}

.login-field:first-child { margin-top: 0; }

.login-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 92rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #B75A1A 0%, #9A4815 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(183, 90, 26, 0.28);
  border: none;
}

.login-btn::after { border: none; }

.login-btn:active { opacity: 0.88; }
