/* 恒迪五金 · Family-first Agent theme */
page {
  background: #F5F7F6;
  color: #182126;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

button, input, textarea, picker { font-family: inherit; }
.screen { min-height: 100vh; padding: 28rpx 28rpx 64rpx; box-sizing: border-box; }

.title-xl { font-size: 48rpx; line-height: 1.25; font-weight: 700; }
.title-lg { font-size: 40rpx; line-height: 1.3; font-weight: 700; }
.title-md { font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.title-sm { font-size: 29rpx; line-height: 1.45; font-weight: 600; }
.text-body { font-size: 28rpx; color: #485550; line-height: 1.7; }
.text-muted { font-size: 24rpx; color: #74807B; }
.text-accent { color: #2865D7; }
.text-success { color: #247A55; }
.text-danger { color: #B95034; }
.text-warning { color: #A86A13; }

.hero-card {
  position: relative;
  padding: 10rpx 2rpx 26rpx;
  color: #182126;
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid #DDE3E0;
  box-shadow: none;
  overflow: visible;
}
.hero-card::before { display: none; }
.hero-eyebrow { display: none; }
.hero-title { margin-top: 0; font-size: 42rpx; line-height: 1.28; font-weight: 700; letter-spacing: 0; }
.hero-subtitle { margin-top: 10rpx; color: #68756F; font-size: 25rpx; line-height: 1.7; opacity: 1; }

.section { margin-top: 38rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; }
.section-title { color: #182126; font-size: 36rpx; line-height: 1.3; font-weight: 700; letter-spacing: 0; }
.section-subtitle { margin-top: 8rpx; color: #74807B; font-size: 25rpx; }
.section-link { padding: 12rpx 0; color: #2865D7; font-size: 25rpx; font-weight: 600; white-space: nowrap; }

.card, .data-card, .list-card, .form-card, .table-card {
  background: #FFFFFF;
  border: 1rpx solid #DCE2DF;
  box-shadow: 0 8rpx 24rpx rgba(28, 48, 41, .055);
}
.card { padding: 26rpx; border-radius: 24rpx; }
.card-flush { padding: 0; }
.data-card { min-height: 156rpx; padding: 24rpx; border-radius: 22rpx; box-sizing: border-box; }
.metric-label { color: #68756F; font-size: 24rpx; font-weight: 500; }
.metric-value { margin-top: 12rpx; color: #182126; font-size: 38rpx; line-height: 1.2; font-weight: 700; letter-spacing: 0; }
.metric-change { margin-top: 8rpx; font-size: 22rpx; font-weight: 600; }
.metric-change.up { color: #247A55; }
.metric-change.down { color: #B95034; }

.stats-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 24rpx; }
.stat-item { min-width: 0; padding: 22rpx 12rpx; text-align: center; background: #FFFFFF; border: 1rpx solid #DCE2DF; border-radius: 20rpx; box-shadow: 0 6rpx 18rpx rgba(28, 48, 41, .045); }
.stat-value { color: #182126; font-size: 36rpx; line-height: 1.25; font-weight: 700; word-break: break-all; }
.stat-label { margin-top: 7rpx; color: #74807B; font-size: 22rpx; line-height: 1.4; }
.stat-icon { display: none; }

.btn { min-height: 78rpx; padding: 16rpx 28rpx; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; border: 0; border-radius: 18rpx; font-size: 27rpx; line-height: 1.25; font-weight: 600; transition: transform .12s, opacity .12s; }
.btn::after { border: 0; }
.btn:active { opacity: .82; transform: scale(.98); }
.btn-primary { color: #FFFFFF; background: #2865D7; box-shadow: 0 8rpx 20rpx rgba(40, 101, 215, .2); }
.btn-outline { color: #245ABF; background: #EDF3FF; border: 1rpx solid #BFD1F3; }
.btn-ghost { color: #40504A; background: #EDF1EF; }
.btn-danger { color: #B24730; background: #FCEBE6; border: 1rpx solid #F1C1B5; }
.btn-sm { min-height: 68rpx; padding: 13rpx 22rpx; border-radius: 16rpx; font-size: 25rpx; }
.btn-block { display: flex; width: 100%; min-height: 92rpx; }
.btn-icon { margin-right: 8rpx; }
.action-row, .top-actions { display: flex; gap: 12rpx; flex-wrap: wrap; }
.action-row { margin-top: 20rpx; }
.top-actions { margin-top: 22rpx; }
.bottom-actions { margin-top: 30rpx; padding-bottom: 30rpx; }

.toolbar { margin-top: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.search-box { min-height: 88rpx; padding: 0 22rpx; display: flex; align-items: center; background: #FFFFFF; border: 2rpx solid #D6DEDA; border-radius: 20rpx; box-shadow: none; }
.search-icon { margin-right: 12rpx; color: #63706A; font-size: 0; }
.search-icon::after { content: '查'; font-size: 23rpx; font-weight: 700; }
.search-input { flex: 1; height: 86rpx; color: #182126; font-size: 28rpx; }
.chip-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.chip { min-height: 60rpx; padding: 10rpx 24rpx; display: flex; align-items: center; border-radius: 16rpx; color: #56635E; background: #FFFFFF; border: 1rpx solid #D5DDDA; font-size: 25rpx; font-weight: 500; box-sizing: border-box; }
.chip.active { color: #FFFFFF; background: #2865D7; border-color: #2865D7; box-shadow: none; }

.list { margin-top: 20rpx; display: flex; flex-direction: column; gap: 16rpx; }
.list-card { padding: 26rpx; border-radius: 22rpx; }
.list-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.list-title { color: #182126; font-size: 30rpx; line-height: 1.45; font-weight: 700; }
.list-meta { margin-top: 8rpx; color: #6D7974; font-size: 24rpx; line-height: 1.65; }
.list-foot { margin-top: 18rpx; display: flex; justify-content: space-between; align-items: center; }

.tag { min-height: 40rpx; padding: 5rpx 15rpx; display: inline-flex; align-items: center; border-radius: 12rpx; font-size: 21rpx; line-height: 1.35; font-weight: 600; white-space: nowrap; box-sizing: border-box; }
.tag-success { color: #236C4D; background: #E2F2E9; }
.tag-warning { color: #966113; background: #FFF0D5; }
.tag-danger { color: #B24730; background: #FCE9E4; }
.tag-info, .tag-primary { color: #285FAF; background: #E8F0FF; }
.tag-neutral { color: #5C6863; background: #EDF1EF; }

.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 18rpx; }
.detail-item { min-width: 0; padding: 20rpx; border-radius: 16rpx; background: #F1F4F2; }
.detail-label { color: #74807B; font-size: 23rpx; }
.detail-value { margin-top: 8rpx; color: #182126; font-size: 27rpx; line-height: 1.5; font-weight: 600; word-break: break-all; }

.form-card { margin-top: 22rpx; padding: 28rpx; border-radius: 22rpx; }
.form-section-title { color: #182126; font-size: 31rpx; line-height: 1.4; font-weight: 700; }
.form-group { margin-top: 25rpx; }
.form-label { margin-bottom: 10rpx; color: #34413C; font-size: 26rpx; font-weight: 600; }
.form-input, .form-textarea, .form-picker { width: 100%; min-height: 88rpx; padding: 20rpx 22rpx; box-sizing: border-box; border-radius: 16rpx; color: #182126; background: #F5F7F6; border: 2rpx solid #D8DFDC; font-size: 28rpx; }
.form-input:focus, .form-textarea:focus { border-color: #2865D7; background: #FFFFFF; }
.form-textarea { min-height: 172rpx; }
.form-picker { display: flex; align-items: center; }
.picker-placeholder { color: #929C98; }
.form-hint { margin-top: 8rpx; color: #7C8782; font-size: 23rpx; }

.image-card { margin-top: 18rpx; }
.image-preview { width: 100%; height: 340rpx; border-radius: 18rpx; background: #EDF1EF; }
.image-placeholder { height: 300rpx; border: 2rpx dashed #C8D2CD; border-radius: 18rpx; background: #F5F7F6; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.image-placeholder-icon { width: 82rpx; height: 82rpx; border-radius: 18rpx; color: #FFFFFF; background: #2865D7; text-align: center; line-height: 82rpx; font-size: 34rpx; font-weight: 700; box-shadow: none; }
.image-placeholder-text { margin-top: 15rpx; color: #74807B; font-size: 24rpx; }

.line-list, .mini-list { margin-top: 16rpx; display: flex; flex-direction: column; gap: 12rpx; }
.line-card, .mini-row { padding: 21rpx; border-radius: 16rpx; background: #F3F6F4; border: 1rpx solid #E0E5E2; }
.line-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.line-title, .mini-title { color: #182126; font-size: 27rpx; font-weight: 700; }
.line-meta, .mini-desc { margin-top: 7rpx; color: #6D7974; font-size: 23rpx; line-height: 1.6; }
.line-actions { margin-top: 14rpx; display: flex; gap: 12rpx; flex-wrap: wrap; }

.banner { margin-top: 20rpx; padding: 22rpx; border-radius: 18rpx; display: flex; align-items: flex-start; gap: 13rpx; }
.banner-icon { font-size: 28rpx; flex-shrink: 0; }
.banner-title { font-size: 27rpx; font-weight: 700; }
.banner-desc { margin-top: 6rpx; font-size: 23rpx; line-height: 1.6; }
.banner-info { color: #245A9E; background: #EAF2FF; }
.banner-warning { color: #865A15; background: #FFF3DD; }
.banner-success { color: #21694A; background: #E5F3EA; }
.banner-danger { color: #A7432E; background: #FCEAE5; }

.empty-state { margin-top: 24rpx; padding: 64rpx 30rpx; border-radius: 22rpx; background: #FFFFFF; border: 1rpx solid #DDE3E0; text-align: center; }
.empty-icon { width: 68rpx; height: 68rpx; margin: 0 auto 16rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; color: #2865D7; background: #EAF1FF; font-size: 0; opacity: 1; }
.empty-icon::after { content: '空'; font-size: 25rpx; font-weight: 700; }
.empty-title { margin-bottom: 7rpx; color: #34413C; font-size: 29rpx; font-weight: 700; }
.empty-desc { color: #74807B; font-size: 24rpx; line-height: 1.65; }
.loading-state { margin-top: 22rpx; padding: 54rpx 28rpx; color: #74807B; font-size: 26rpx; text-align: center; }

.table-card { margin-top: 20rpx; overflow: hidden; border-radius: 20rpx; }
.table-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #E3E8E5; }
.table-row:last-child { border-bottom: 0; }
.table-head { background: #EDF2EF; }
.table-cell { flex: 1; min-width: 0; color: #25302C; font-size: 24rpx; line-height: 1.5; }
.table-head .table-cell { color: #52605A; font-size: 22rpx; font-weight: 700; }
.divider { height: 1rpx; margin: 24rpx 0; background: #E0E5E2; }

.avatar { width: 78rpx; height: 78rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #FFFFFF; background: #2865D7; font-size: 30rpx; font-weight: 700; }
.avatar-lg { width: 104rpx; height: 104rpx; font-size: 40rpx; }
.setting-row { min-height: 98rpx; padding: 20rpx 0; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #E2E7E4; }
.setting-row:last-child { border-bottom: 0; }
.setting-left { display: flex; align-items: center; gap: 16rpx; }
.setting-icon { width: 58rpx; height: 58rpx; border-radius: 17rpx; display: flex; align-items: center; justify-content: center; color: #2865D7; background: #EAF1FF; font-size: 0; }
.setting-icon::after { font-size: 22rpx; font-weight: 700; }
.setting-icon.users::after { content: '人'; }
.setting-icon.logs::after { content: '记'; }
.setting-icon.backup::after { content: '存'; }
.setting-icon.logout::after { content: '退'; }
.setting-icon.report::after { content: '表'; }
.setting-icon.about::after { content: '问'; }
.setting-icon.logout { color: #B24730; background: #FCEBE6; }
.setting-label { color: #182126; font-size: 29rpx; font-weight: 600; }
.setting-desc { margin-top: 3rpx; color: #74807B; font-size: 22rpx; }
.setting-arrow { color: #8B9691; font-size: 28rpx; }
.setting-badge { margin-right: 4rpx; color: #74807B; font-size: 22rpx; }

.login-screen { min-height: 100vh; padding: 70rpx 34rpx 48rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; background: #F5F7F6; }
.login-brand { margin-bottom: 44rpx; text-align: left; }
.login-brand-icon { width: 80rpx; height: 80rpx; margin: 0 0 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 23rpx 23rpx 23rpx 7rpx; color: #FFFFFF; background: #2865D7; box-shadow: 0 12rpx 28rpx rgba(40, 101, 215, .22); font-size: 0; }
.login-brand-icon::after { content: '恒'; font-size: 30rpx; font-weight: 700; }
.login-brand-name { color: #182126; font-size: 43rpx; font-weight: 700; letter-spacing: 0; }
.login-brand-desc { margin-top: 8rpx; color: #74807B; font-size: 25rpx; }
.login-card { padding: 32rpx 28rpx; border-radius: 24rpx; background: #FFFFFF; border: 1rpx solid #DCE2DF; box-shadow: 0 12rpx 34rpx rgba(28, 48, 41, .07); }
.login-field { margin-top: 22rpx; }
.login-field:first-child { margin-top: 0; }
.login-btn { width: 100%; height: 94rpx; margin-top: 30rpx; padding: 0; border: 0; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; color: #FFFFFF; background: #2865D7; font-size: 30rpx; font-weight: 700; box-shadow: 0 10rpx 24rpx rgba(40, 101, 215, .2); }
.login-btn::after { border: 0; }
.login-btn:active { opacity: .86; }

@media (max-width: 340px) {
  .screen { padding-left: 22rpx; padding-right: 22rpx; }
  .grid-2, .detail-grid { grid-template-columns: 1fr; }
}
